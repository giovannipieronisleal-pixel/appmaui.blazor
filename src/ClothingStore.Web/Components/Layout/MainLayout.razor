@inherits LayoutComponentBase
@inject CatalogDataGateway CatalogGateway
@inject NavigationManager Navigation
@implements IDisposable

<div class="site-wrapper">
    <header class="site-header">
        <div class="container header-inner">
            <a href="/loja/@_store.StoreSlug" class="brand-link">
                @if (!string.IsNullOrWhiteSpace(_store.LogoPublicUrl))
                {
                    <img src="@_store.LogoPublicUrl" alt="@_store.StoreName" class="brand-logo" />
                }
                <span class="brand-name">@_store.StoreName</span>
            </a>

            <nav class="nav-links">
                <a href="/loja/@_store.StoreSlug" class="nav-link">Início</a>
                <a href="/loja/@_store.StoreSlug/catalogo" class="nav-link">Catálogo Completo</a>
                @foreach (var cat in _categories.Take(4))
                {
                    <a href="/loja/@_store.StoreSlug/catalogo?categoria=@cat.Slug" class="nav-link">@cat.Name</a>
                }
            </nav>

            <div>
                <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-whatsapp">
                    <span>Atendimento WhatsApp</span>
                </a>
            </div>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="site-footer">
        <div class="container">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; flex-wrap: wrap;">
                <div style="max-width: 480px;">
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                        @if (!string.IsNullOrWhiteSpace(_store.LogoPublicUrl))
                        {
                            <img src="@_store.LogoPublicUrl" alt="@_store.StoreName" class="brand-logo" />
                        }
                        <strong class="brand-name">@_store.StoreName</strong>
                    </div>
                    <p style="color: var(--text-secondary); font-size: 0.95rem;">
                        @_store.StoreDescription
                    </p>
                </div>

                <div>
                    <div class="filter-group-title">Catálogo Digital</div>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; max-width: 340px; margin-bottom: 0.75rem;">
                        Consulte disponibilidade de cores e tamanhos em tempo real e faça seu pedido diretamente pelo nosso WhatsApp.
                    </p>
                    <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline">
                        WhatsApp: +@_store.WhatsappNumber
                    </a>
                </div>
            </div>

            <div style="margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.82rem; color: var(--text-muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                <span>&copy; @DateTime.Now.Year @_store.StoreName — Catálogo Digital Exclusivo (Sem checkout online).</span>
                <span>Sincronizado em tempo real com o estoque da loja.</span>
            </div>
        </div>
    </footer>
</div>

@code {
    private PublicStoreSettingsDto _store = new("Aura Vestuário", "aura-vestuario", "5511999999999", "Catálogo digital de roupas.", null, DateTimeOffset.UtcNow);
    private IReadOnlyList<CategoryDto> _categories = [];

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshStoreHeaderAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshStoreHeaderAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshStoreHeaderAsync()
    {
        _store = await CatalogGateway.GetStoreInfoAsync();
        _categories = await CatalogGateway.GetCategoriesAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

