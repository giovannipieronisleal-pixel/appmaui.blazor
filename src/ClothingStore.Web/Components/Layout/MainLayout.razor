@inherits LayoutComponentBase
@implements IDisposable
@inject CatalogDataGateway CatalogDataGateway
@inject NavigationManager Navigation

<StoreDesignStyleInjector Design="@_store?.Design" />

<div class="lux-shell">
    <header class="lux-header">
        <div class="lux-container lux-header-inner">
            <a href="@HomeHref" class="lux-brand-link">
                @if (WhatsAppLinkBuilder.IsSafeMediaUrl(_store?.LogoPublicUrl))
                {
                    <img src="@WhatsAppLinkBuilder.SanitizeMediaUrl(_store?.LogoPublicUrl)" alt="@_store?.StoreName" class="lux-brand-logo" />
                }
                else
                {
                    <span class="lux-brand-mark">@BrandInitial</span>
                }

                <span>
                    <span class="lux-brand-title">@(_store?.StoreName ?? "YouLink Loja")</span>
                    <span class="lux-brand-sub">@BrandSubtitle</span>
                </span>
            </a>

            <nav class="lux-nav" aria-label="Navegação principal">
                <NavLink href="@HomeHref" Match="NavLinkMatch.All" class="lux-nav-link">Início</NavLink>
                <NavLink href="@CatalogHref" class="lux-nav-link">Ver Roupas</NavLink>
                <button type="button" class="lux-btn lux-btn-outline lux-btn-sm lux-pwa-install-btn" data-pwa-install>
                    📲 Instalar App
                </button>

                @if (_store is { IsSiteActive: true } && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
                {
                    <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="lux-btn lux-btn-whatsapp lux-btn-sm">
                        💬 Comprar no WhatsApp
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="lux-main">
        <div class="lux-container">
            @Body
        </div>
    </main>

    <footer class="lux-footer">
        <div class="lux-container lux-footer-inner">
            <div>
                <strong>@(_store?.StoreName ?? "Loja Online")</strong> — @(_store?.StoreDescription ?? "Moda selecionada com atendimento direto.")
            </div>
            <div>
                @if (_store is not null && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
                {
                    <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                       target="_blank"
                       rel="noopener noreferrer"
                       style="font-weight: 600; color: var(--brand-accent);">
                        💬 Atendimento rápido pelo WhatsApp
                    </a>
                }
            </div>
        </div>
    </footer>

    @if (_store is { IsSiteActive: true } && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
    {
        <div class="lux-mobile-wa-bar">
            <a href="@CatalogHref" class="lux-btn lux-btn-outline lux-btn-sm" style="flex: 1;">
                Ver Roupas
            </a>
            <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
               target="_blank"
               rel="noopener noreferrer"
               class="lux-btn lux-btn-whatsapp lux-btn-sm"
               style="flex: 1.4;">
                💬 Pedir no WhatsApp
            </a>
        </div>
    }
</div>

@code {
    private PublicStoreSettingsDto? _store;
    private string? _activeStoreSlug;

    private string HomeHref =>
        string.IsNullOrWhiteSpace(_activeStoreSlug) ? "/" : $"/loja/{Uri.EscapeDataString(_activeStoreSlug)}";

    private string CatalogHref =>
        string.IsNullOrWhiteSpace(_activeStoreSlug) ? "/catalogo" : $"/loja/{Uri.EscapeDataString(_activeStoreSlug)}/catalogo";

    private string BrandInitial =>
        string.IsNullOrWhiteSpace(_store?.StoreName)
            ? "L"
            : _store.StoreName.Trim()[..1].ToUpperInvariant();

    private string BrandSubtitle => _store?.PlanTier switch
    {
        StoreDesignPresets.PlanPremium => "Loja Oficial • Sob Medida",
        StoreDesignPresets.PlanIntermediate => "Loja Oficial • Coleção Selecionada",
        _ => "Catálogo Online Oficial"
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        _activeStoreSlug = ExtractStoreSlugFromUri(Navigation.Uri);
        await LoadStoreAsync();
    }

    private async void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var nextSlug = ExtractStoreSlugFromUri(e.Location);
        if (string.Equals(nextSlug, _activeStoreSlug, StringComparison.OrdinalIgnoreCase))
            return;

        _activeStoreSlug = nextSlug;
        await InvokeAsync(async () =>
        {
            await LoadStoreAsync();
            StateHasChanged();
        });
    }

    private async Task LoadStoreAsync()
    {
        try
        {
            _store = await CatalogDataGateway.GetStoreInfoOrNullAsync(_activeStoreSlug);
        }
        catch
        {
            _store = null;
        }
    }

    private string? ExtractStoreSlugFromUri(string uri)
    {
        try
        {
            var rel = Navigation.ToBaseRelativePath(uri).TrimStart('/');
            if (rel.StartsWith("loja/", StringComparison.OrdinalIgnoreCase))
            {
                var remainder = rel["loja/".Length..];
                var slashIdx = remainder.IndexOfAny(['/', '?', '#']);
                var slug = slashIdx >= 0 ? remainder[..slashIdx] : remainder;
                return string.IsNullOrWhiteSpace(slug) ? null : Uri.UnescapeDataString(slug);
            }
        }
        catch
        {
        }
        return null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
