@page "/produto/{Slug}"
@page "/loja/{StoreSlug}/produto/{Slug}"
@inject CatalogDataGateway CatalogDataGateway

<PageTitle>@(_product?.Name ?? "Peça") — @(_store?.StoreName ?? "YouLink Loja")</PageTitle>

@if (_loading)
{
    <div class="lux-empty-card">
        <p>Carregando detalhes da peça...</p>
    </div>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Vitrine Pausada</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle">@(_store.DeactivationReason ?? "Vitrine temporariamente indisponível.")</p>
    </section>
}
else if (_product is null)
{
    <section class="lux-empty-card">
        <h2>Peça não encontrada</h2>
        <p class="lux-hero-subtitle">Esta peça pode ter sido arquivada ou removida do catálogo.</p>
        <a href="@CatalogHref" class="lux-btn lux-btn-primary">Voltar ao Catálogo</a>
    </section>
}
else
{
    <nav class="lux-breadcrumb" aria-label="Caminho da página">
        <a href="@HomeHref">Início</a>
        <span>/</span>
        <a href="@CatalogHref">Catálogo</a>
        <span>/</span>
        <a href="@($"{CatalogHref}?categoria={Uri.EscapeDataString(_product.CategorySlug)}")">@_product.CategoryName</a>
        <span>/</span>
        <strong>@_product.Name</strong>
    </nav>

    <div class="lux-detail-grid">
        <div>
            <div class="lux-detail-stage">
                @if (!string.IsNullOrWhiteSpace(CurrentImageUrl))
                {
                    <img src="@CurrentImageUrl" alt="@_product.Name" />
                }
                else
                {
                    <div class="lux-product-placeholder">
                        <span>Imagem indisponível</span>
                    </div>
                }
            </div>

            @if (_product.Images.Count > 1)
            {
                <div class="lux-thumb-strip">
                    @foreach (var img in _product.Images)
                    {
                        <button type="button"
                                class="lux-thumb-btn @(CurrentImageUrl == img.PublicUrl ? "active" : "")"
                                @onclick="() => _selectedImageUrl = img.PublicUrl">
                            <img src="@img.PublicUrl" alt="@(img.AltText ?? _product.Name)" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="lux-detail-info">
            <span class="lux-hero-eyebrow">@_product.CategoryName</span>
            <h1 class="lux-section-title">@_product.Name</h1>
            <div class="lux-detail-price">@_product.BasePrice.ToString("C")</div>

            @if (!string.IsNullOrWhiteSpace(_product.Description))
            {
                <p class="lux-hero-subtitle">@_product.Description</p>
            }

            @if (DistinctColors.Count > 0)
            {
                <div class="lux-filter-group">
                    <span class="lux-filter-label">Cor: @(_selectedColor ?? "Escolha")</span>
                    <div class="lux-option-chips">
                        @foreach (var color in DistinctColors)
                        {
                            var active = string.Equals(_selectedColor, color.Color, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="lux-chip-btn @(active ? "active" : "")"
                                    @onclick="() => SelectColor(color.Color)">
                                <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
                                    <circle cx="7" cy="7" r="5.5" fill="@color.ColorHex" stroke="rgba(120,113,108,0.5)" stroke-width="1" />
                                </svg>
                                <span>@color.Color</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (SizesForSelectedColor.Count > 0)
            {
                <div class="lux-filter-group">
                    <span class="lux-filter-label">2. Escolha o Tamanho: @(_selectedSize ?? "Toque para escolher")</span>
                    <div class="lux-option-chips">
                        @foreach (var size in SizesForSelectedColor)
                        {
                            var active = string.Equals(_selectedSize, size, StringComparison.OrdinalIgnoreCase);
                            var hasStock = HasStockFor(size);
                            <button type="button"
                                    class="lux-chip-btn @(active ? "active" : "")"
                                    disabled="@(!hasStock)"
                                    @onclick="() => _selectedSize = size">
                                @size @(!hasStock ? "(esgotado)" : "")
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="lux-status-box">
                @if (SelectedVariant is not null)
                {
                    if (SelectedVariant.StockQuantity > 3)
                    {
                        <strong>✓ Disponível agora para pedido</strong>
                        <span> — Pronta entrega na cor e tamanho selecionados.</span>
                    }
                    else if (SelectedVariant.StockQuantity > 0)
                    {
                        <strong>🔥 Últimas unidades neste tamanho</strong>
                        <span> — Garanta a sua rapidamente pelo WhatsApp abaixo.</span>
                    }
                    else
                    {
                        <strong>Este tamanho acabou no momento</strong>
                        <span> — Chame nossa equipe no WhatsApp para saber sobre reposição ou outro tamanho.</span>
                    }
                }
                else
                {
                    <span>Fale com nossa equipe no WhatsApp para confirmar disponibilidade imediata.</span>
                }
            </div>

            @if (_store is not null && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
            {
                <a href="@WhatsAppLinkBuilder.BuildProductConsultationLink(_store.WhatsappNumber, _product.Name, _selectedColor, _selectedSize)"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="lux-btn lux-btn-whatsapp"
                   style="width: 100%; font-size: 0.98rem; padding: 0.95rem 1.25rem;">
                    💬 Pedir esta Peça no WhatsApp
                </a>

                <div class="lux-msg-preview">
                    <strong>Mensagem pronta que vamos enviar para a loja:</strong>
                    <div>@WhatsAppLinkBuilder.BuildProductConsultationMessage(_product.Name, _selectedColor, _selectedSize)</div>
                </div>
            }

            @if (_product.Variants.Count > 0)
            {
                <table class="lux-variant-table" aria-label="Cores e tamanhos">
                    <thead>
                        <tr>
                            <th>Cor</th>
                            <th>Tamanho</th>
                            <th>Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _product.Variants)
                        {
                            <tr>
                                <td>@v.Color</td>
                                <td>@v.Size</td>
                                <td>@(v.StockQuantity > 3 ? "Disponível" : v.StockQuantity > 0 ? "Últimas peças" : "Esgotado")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string? StoreSlug { get; set; }

    private PublicStoreSettingsDto? _store;
    private ProductDetailDto? _product;
    private bool _loading = true;
    private string? _selectedImageUrl;
    private string? _selectedColor;
    private string? _selectedSize;

    private string HomeHref => string.IsNullOrWhiteSpace(StoreSlug) ? "/" : $"/loja/{StoreSlug}";
    private string CatalogHref => string.IsNullOrWhiteSpace(StoreSlug) ? "/catalogo" : $"/loja/{StoreSlug}/catalogo";

    private string? CurrentImageUrl =>
        _selectedImageUrl ?? _product?.Images.FirstOrDefault()?.PublicUrl;

    private IReadOnlyList<ColorOptionDto> DistinctColors =>
        _product?.Variants
            .GroupBy(v => v.Color, StringComparer.OrdinalIgnoreCase)
            .Select(g => new ColorOptionDto(g.Key, g.First().ColorHex))
            .ToList() ?? [];

    private IReadOnlyList<string> SizesForSelectedColor
    {
        get
        {
            if (_product is null) return [];
            var q = string.IsNullOrWhiteSpace(_selectedColor)
                ? _product.Variants
                : _product.Variants.Where(v => string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase));

            return q.Select(v => v.Size).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private ProductVariantDto? SelectedVariant =>
        _product?.Variants.FirstOrDefault(v =>
            (string.IsNullOrWhiteSpace(_selectedColor) || string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_selectedSize) || string.Equals(v.Size, _selectedSize, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _store = await CatalogDataGateway.GetStoreInfoAsync();
            _product = await CatalogDataGateway.GetProductDetailAsync(Slug);
            _selectedImageUrl = _product?.Images.FirstOrDefault()?.PublicUrl;

            var firstInStock = _product?.Variants.FirstOrDefault(v => v.StockQuantity > 0)
                               ?? _product?.Variants.FirstOrDefault();
            _selectedColor = firstInStock?.Color;
            _selectedSize = firstInStock?.Size;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectColor(string color)
    {
        _selectedColor = color;
        var match = _product?.Variants.FirstOrDefault(v =>
            string.Equals(v.Color, color, StringComparison.OrdinalIgnoreCase) &&
            v.StockQuantity > 0)
            ?? _product?.Variants.FirstOrDefault(v => string.Equals(v.Color, color, StringComparison.OrdinalIgnoreCase));

        _selectedSize = match?.Size;
    }

    private bool HasStockFor(string size) =>
        _product?.Variants.Any(v =>
            (string.IsNullOrWhiteSpace(_selectedColor) || string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(v.Size, size, StringComparison.OrdinalIgnoreCase) &&
            v.StockQuantity > 0) ?? false;
}
