@page "/produto/{Slug}"
@page "/loja/{StoreSlug}/produto/{Slug}"
@implements IDisposable
@inject CatalogDataGateway CatalogDataGateway

<PageTitle>@(_product?.Name ?? "Peça") — @(_store?.StoreName ?? "YouLink Loja")</PageTitle>

@if (_loading)
{
    <div class="lux-empty-card">
        <p>Carregando detalhes da peça...</p>
    </div>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Vitrine Pausada</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle">@(_store.DeactivationReason ?? "Vitrine temporariamente indisponível.")</p>
    </section>
}
else if (_product is null)
{
    <section class="lux-empty-card">
        <h2>Peça não encontrada</h2>
        <p class="lux-hero-subtitle">Esta peça pode ter sido arquivada ou removida do catálogo.</p>
        <a href="@CatalogHref" class="lux-btn lux-btn-primary">Voltar ao Catálogo</a>
    </section>
}
else
{
    <nav class="lux-breadcrumb" aria-label="Caminho da página">
        <a href="@HomeHref">Início</a>
        <span>/</span>
        <a href="@CatalogHref">Catálogo</a>
        <span>/</span>
        <a href="@($"{CatalogHref}?categoria={Uri.EscapeDataString(_product.CategorySlug)}")">@_product.CategoryName</a>
        <span>/</span>
        <strong>@_product.Name</strong>
    </nav>

    <div class="lux-detail-grid">
        <div>
            <div class="lux-detail-stage">
                @if (WhatsAppLinkBuilder.IsSafeMediaUrl(CurrentImageUrl))
                {
                    <img src="@WhatsAppLinkBuilder.SanitizeMediaUrl(CurrentImageUrl)" alt="@_product.Name" />
                }
                else
                {
                    <div class="lux-product-placeholder">
                        <span>Imagem indisponível</span>
                    </div>
                }
            </div>

            @if (_product.Images.Count > 1)
            {
                <div class="lux-thumb-strip">
                    @foreach (var img in _product.Images.Where(i => WhatsAppLinkBuilder.IsSafeMediaUrl(i.PublicUrl)))
                    {
                        var safeThumbUrl = WhatsAppLinkBuilder.SanitizeMediaUrl(img.PublicUrl);
                        <button type="button"
                                class="lux-thumb-btn @(CurrentImageUrl == img.PublicUrl ? "active" : "")"
                                @onclick="() => _selectedImageUrl = safeThumbUrl">
                            <img src="@safeThumbUrl" alt="@(img.AltText ?? _product.Name)" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="lux-detail-info">
            <span class="lux-hero-eyebrow">@_product.CategoryName</span>
            <h1 class="lux-section-title">@_product.Name</h1>
            <div class="lux-detail-price">@_product.BasePrice.ToString("C")</div>

            @if (!string.IsNullOrWhiteSpace(_product.Description))
            {
                <p class="lux-hero-subtitle">@_product.Description</p>
            }

            @if (DistinctColors.Count > 0)
            {
                <div class="lux-filter-group">
                    <span class="lux-filter-label">Cor: @(_selectedColor ?? "Escolha")</span>
                    <div class="lux-option-chips">
                        @foreach (var color in DistinctColors)
                        {
                            var active = string.Equals(_selectedColor, color.Color, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="lux-chip-btn @(active ? "active" : "")"
                                    @onclick="() => SelectColor(color.Color)">
                                <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
                                    <circle cx="7" cy="7" r="5.5" fill="@color.ColorHex" stroke="rgba(120,113,108,0.5)" stroke-width="1" />
                                </svg>
                                <span>@color.Color</span>
                            </button>
                        }
                    </div>
                </div>
            }

            @if (SizesForSelectedColor.Count > 0)
            {
                <div class="lux-filter-group">
                    <span class="lux-filter-label">2. Escolha o Tamanho: @(_selectedSize ?? "Toque para escolher")</span>
                    <div class="lux-option-chips">
                        @foreach (var size in SizesForSelectedColor)
                        {
                            var active = string.Equals(_selectedSize, size, StringComparison.OrdinalIgnoreCase);
                            var hasStock = HasStockFor(size);
                            <button type="button"
                                    class="lux-chip-btn @(active ? "active" : "")"
                                    disabled="@(!hasStock)"
                                    @onclick="() => _selectedSize = size">
                                @size @(!hasStock ? "(esgotado)" : "")
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="lux-status-box">
                @if (SelectedVariant is not null)
                {
                    if (SelectedVariant.StockQuantity > 3)
                    {
                        <strong>✓ Disponível agora para pedido</strong>
                        <span> — Pronta entrega na cor e tamanho selecionados.</span>
                    }
                    else if (SelectedVariant.StockQuantity > 0)
                    {
                        <strong>🔥 Últimas unidades neste tamanho</strong>
                        <span> — Garanta a sua rapidamente pelo WhatsApp abaixo.</span>
                    }
                    else
                    {
                        <strong>Este tamanho acabou no momento</strong>
                        <span> — Chame nossa equipe no WhatsApp para saber sobre reposição ou outro tamanho.</span>
                    }
                }
                else
                {
                    <span>Fale com nossa equipe no WhatsApp para confirmar disponibilidade imediata.</span>
                }
            </div>

            @if (_store is not null && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
            {
                <a href="@WhatsAppLinkBuilder.BuildProductConsultationLink(_store.WhatsappNumber, _product.Name, _selectedColor, _selectedSize)"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="lux-btn lux-btn-whatsapp"
                   style="width: 100%; font-size: 0.98rem; padding: 0.95rem 1.25rem;">
                    💬 Pedir esta Peça no WhatsApp
                </a>

                <div class="lux-msg-preview">
                    <strong>Mensagem pronta que vamos enviar para a loja:</strong>
                    <div>@WhatsAppLinkBuilder.BuildProductConsultationMessage(_product.Name, _selectedColor, _selectedSize)</div>
                </div>

                @if (_store.DirectPixSalesReady)
                {
                    <div style="margin-top: 1.25rem; border: 1.5px solid #16A34A; background: var(--brand-bg, #FAF8F5); border-radius: 12px; padding: 1.15rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                            <strong style="font-size: 1rem;">💸 Comprar Direto pelo App (Exclusivo Pix)</strong>
                            <span style="font-size: 0.72rem; font-weight: 700; background: #DCFCE7; color: #166534; padding: 0.2rem 0.55rem; border-radius: 999px;">
                                Pagamento somente via Pix
                            </span>
                        </div>
                        <p style="font-size: 0.82rem; color: var(--brand-text-muted, #57534E); margin: 0 0 0.85rem; line-height: 1.45;">
                            Área atendida pelo vendedor: <strong>@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.Describe(_store.DeliveryScopeMode, _store.MaxDeliveryDistanceKm, _store.OriginCity, _store.OriginState)</strong>.
                        </p>

                        @if (_createdPixOrder is null)
                        {
                            @if (!string.IsNullOrWhiteSpace(_checkoutError))
                            {
                                <div style="background: rgba(239,68,68,0.12); border: 1px solid #EF4444; color: #991B1B; padding: 0.65rem 0.8rem; border-radius: 8px; font-size: 0.82rem; margin-bottom: 0.75rem;">
                                    @_checkoutError
                                </div>
                            }

                            @if (SelectedVariant is null || SelectedVariant.StockQuantity <= 0)
                            {
                                <div style="font-size: 0.84rem; color: #991B1B; font-weight: 600;">
                                    Escolha uma cor e tamanho com estoque disponível para comprar via Pix.
                                </div>
                            }
                            else
                            {
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; margin-bottom: 0.65rem;">
                                    <div>
                                        <label style="display:block; font-size:0.74rem; font-weight:700; margin-bottom:0.2rem;">CEP de Entrega *</label>
                                        <div style="display: flex; gap: 0.35rem;">
                                            <input type="text" @bind="_buyerCep" placeholder="01310-100"
                                                   style="flex:1; min-width:0; padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                            <button type="button" class="lux-btn lux-btn-outline" style="padding:0.45rem 0.7rem; font-size:0.8rem;"
                                                    disabled="@_calculatingShipping" @onclick="CheckShippingQuoteAsync">
                                                @(_calculatingShipping ? "..." : "Calcular")
                                            </button>
                                        </div>
                                    </div>
                                    <div>
                                        <label style="display:block; font-size:0.74rem; font-weight:700; margin-bottom:0.2rem;">Quantidade (máx @SelectedVariant.StockQuantity)</label>
                                        <input type="number" min="1" max="@SelectedVariant.StockQuantity" @bind="_orderQuantity"
                                               style="width:100%; padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    </div>
                                </div>

                                @if (_shippingQuote is not null)
                                {
                                    <div style="padding: 0.65rem 0.8rem; border-radius: 8px; font-size: 0.82rem; margin-bottom: 0.75rem; @(_shippingQuote.Eligibility.IsAllowed ? "background: rgba(22,163,74,0.12); border: 1px solid #16A34A;" : "background: rgba(239,68,68,0.12); border: 1px solid #EF4444;")">
                                        <div><strong>@(_shippingQuote.Eligibility.IsAllowed ? "✓ Endereço atendido:" : "✕ Fora do alcance do vendedor:")</strong> @_shippingQuote.Eligibility.ReasonMessage</div>
                                        @if (_shippingQuote.Eligibility.IsAllowed && _shippingQuote.CorreiosQuote is not null)
                                        {
                                            <div style="margin-top: 0.3rem; font-size: 0.78rem;">
                                                Estimativa Correios para referência do envio:
                                                <strong>PAC ~@_shippingQuote.CorreiosQuote.PacPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong> (@_shippingQuote.CorreiosQuote.PacDaysMin–@_shippingQuote.CorreiosQuote.PacDaysMax dias úteis) |
                                                <strong>SEDEX ~@_shippingQuote.CorreiosQuote.SedexPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong> (@_shippingQuote.CorreiosQuote.SedexDaysMin–@_shippingQuote.CorreiosQuote.SedexDaysMax dias úteis).
                                            </div>
                                        }
                                    </div>
                                }

                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.55rem; margin-bottom: 0.65rem;">
                                    <input type="text" @bind="_buyerName" placeholder="Seu Nome Completo *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerWhatsapp" placeholder="Seu WhatsApp (DDD + Número) *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerStreet" placeholder="Rua / Logradouro *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerNumber" placeholder="Número *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerComplement" placeholder="Complemento (Apto, Bloco...)"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerNeighborhood" placeholder="Bairro *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" @bind="_buyerCity" placeholder="Cidade *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />
                                    <input type="text" maxlength="2" @bind="_buyerState" placeholder="UF (ex.: SP) *"
                                           style="padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px; text-transform:uppercase;" />
                                </div>

                                <input type="text" @bind="_buyerNotes" placeholder="Observações de entrega (opcional)"
                                       style="width:100%; margin-bottom:0.75rem; padding:0.5rem 0.65rem; border:1px solid var(--brand-border,#D6D3D1); border-radius:6px;" />

                                <button type="button"
                                        class="lux-btn lux-btn-primary"
                                        style="width: 100%; background: #16A34A; color: #FFFFFF; padding: 0.9rem; font-weight: 800;"
                                        disabled="@(_submittingOrder || (_shippingQuote is not null && !_shippingQuote.Eligibility.IsAllowed))"
                                        @onclick="SubmitPixOrderAsync">
                                    @(_submittingOrder
                                        ? "Gerando pedido Pix..."
                                        : $"💸 Finalizar Pedido no Pix ({((_product.BasePrice * Math.Max(1, _orderQuantity))).ToString("C", new System.Globalization.CultureInfo("pt-BR"))})")
                                </button>
                                <div style="font-size: 0.74rem; color: var(--brand-text-muted, #57534E); margin-top: 0.4rem;">
                                    Após finalizar no Pix, o vendedor receberá seu endereço e organizará o envio (Correios/entrega combinada). Não aceita cartão.
                                </div>
                            }
                        }
                        else
                        {
                            <div style="background: rgba(22,163,74,0.12); border: 1px solid #16A34A; border-radius: 8px; padding: 0.85rem;">
                                @if (_pixStatus?.IsPaid == true || _createdPixOrder.Status == "PagoSeparandoEnvio")
                                {
                                    <div style="background: #16A34A; color: #FFFFFF; border-radius: 8px; padding: 0.85rem; margin-bottom: 0.75rem;">
                                        <div style="font-weight: 800; font-size: 1.05rem;">
                                            ✅ Pagamento Pix confirmado automaticamente!
                                        </div>
                                        <div style="font-size: 0.84rem; margin-top: 0.25rem;">
                                            Pedido <strong>@_createdPixOrder.OrderNumber</strong> pago! A loja já recebeu a confirmação e vai separar o envio para <strong>@_createdPixOrder.DeliveryCity/@_createdPixOrder.DeliveryState</strong>.
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="font-weight: 800; color: #166534; font-size: 1rem;">
                                        ✅ Pedido @_createdPixOrder.OrderNumber gerado!
                                    </div>
                                    <p style="font-size: 0.82rem; margin: 0.35rem 0 0.65rem;">
                                        Pague via <strong>Pix</strong> usando o QR Code ou o código Copia e Cola abaixo.
                                        @if (string.Equals(_createdPixOrder.PaymentProvider, "MercadoPago", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Assim que você pagar no banco, esta tela confirma o pagamento automaticamente em segundos.</span>
                                        }
                                        else
                                        {
                                            <span>O vendedor recebeu seu endereço em <strong>@_createdPixOrder.DeliveryCity/@_createdPixOrder.DeliveryState</strong> (~@_createdPixOrder.DistanceKmFromSeller.ToString("0.#") km) e preparará o envio!</span>
                                        }
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(_createdPixOrder.PixQrCodeBase64))
                                    {
                                        <div style="text-align: center; margin: 0.5rem 0 0.75rem;">
                                            <img src="@($"data:image/png;base64,{_createdPixOrder.PixQrCodeBase64}")"
                                                 alt="QR Code Pix"
                                                 style="max-width: 190px; width: 100%; border-radius: 10px; background: #FFFFFF; padding: 8px; border: 1px solid #16A34A;" />
                                        </div>
                                    }

                                    @if (!string.Equals(_createdPixOrder.PaymentProvider, "MercadoPago", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="font-size: 0.8rem; margin-bottom: 0.35rem;">
                                            <strong>Chave Pix do Vendedor:</strong> <code>@_createdPixOrder.PixKey</code>
                                        </div>
                                    }

                                    <div style="font-size: 0.8rem; font-weight: 700; margin-bottom: 0.25rem;">
                                        Código Pix Copia e Cola (R$ @_createdPixOrder.TotalPixAmount.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))):
                                    </div>
                                    <textarea readonly rows="3" style="width:100%; font-family:monospace; font-size:0.74rem; padding:0.45rem; border-radius:6px; border:1px solid #16A34A; margin-bottom:0.5rem;">@_createdPixOrder.PixBrCode</textarea>
                                    @if (string.Equals(_createdPixOrder.PaymentProvider, "MercadoPago", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div style="font-size: 0.76rem; color: #166534; font-weight: 600; margin-bottom: 0.55rem;">
                                            ⏳ Verificando confirmação Pix automaticamente a cada 4 segundos...
                                        </div>
                                    }
                                }

                                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                                    <a href="@BuildOrderProofWhatsAppUrl(_createdPixOrder)" target="_blank" rel="noopener noreferrer"
                                       class="lux-btn lux-btn-whatsapp" style="flex:1;">
                                        💬 Falar com a Loja no WhatsApp
                                    </a>
                                    <button type="button" class="lux-btn lux-btn-outline" @onclick="ResetPixOrderForm">
                                        Novo Pedido
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @if (_product.Variants.Count > 0)
            {
                <table class="lux-variant-table" aria-label="Cores e tamanhos">
                    <thead>
                        <tr>
                            <th>Cor</th>
                            <th>Tamanho</th>
                            <th>Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _product.Variants)
                        {
                            <tr>
                                <td>@v.Color</td>
                                <td>@v.Size</td>
                                <td>@(v.StockQuantity > 3 ? "Disponível" : v.StockQuantity > 0 ? "Últimas peças" : "Esgotado")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [Parameter]
    public string? StoreSlug { get; set; }

    private PublicStoreSettingsDto? _store;
    private ProductDetailDto? _product;
    private bool _loading = true;
    private string? _selectedImageUrl;
    private string? _selectedColor;
    private string? _selectedSize;

    private string HomeHref => string.IsNullOrWhiteSpace(StoreSlug) ? "/" : $"/loja/{StoreSlug}";
    private string CatalogHref => string.IsNullOrWhiteSpace(StoreSlug) ? "/catalogo" : $"/loja/{StoreSlug}/catalogo";

    private string? CurrentImageUrl =>
        _selectedImageUrl ?? _product?.Images.FirstOrDefault()?.PublicUrl;

    private IReadOnlyList<ColorOptionDto> DistinctColors =>
        _product?.Variants
            .GroupBy(v => v.Color, StringComparer.OrdinalIgnoreCase)
            .Select(g => new ColorOptionDto(g.Key, g.First().ColorHex))
            .ToList() ?? [];

    private IReadOnlyList<string> SizesForSelectedColor
    {
        get
        {
            if (_product is null) return [];
            var q = string.IsNullOrWhiteSpace(_selectedColor)
                ? _product.Variants
                : _product.Variants.Where(v => string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase));

            return q.Select(v => v.Size).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private ProductVariantDto? SelectedVariant =>
        _product?.Variants.FirstOrDefault(v =>
            (string.IsNullOrWhiteSpace(_selectedColor) || string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_selectedSize) || string.Equals(v.Size, _selectedSize, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _store = await CatalogDataGateway.GetStoreInfoOrNullAsync(StoreSlug);
            if (!string.IsNullOrWhiteSpace(StoreSlug) && _store is null)
            {
                _product = null;
                return;
            }

            _store ??= await CatalogDataGateway.GetStoreInfoAsync(StoreSlug);
            _product = await CatalogDataGateway.GetProductDetailAsync(Slug, StoreSlug);
            _selectedImageUrl = _product?.Images.FirstOrDefault()?.PublicUrl;

            var firstInStock = _product?.Variants.FirstOrDefault(v => v.StockQuantity > 0)
                               ?? _product?.Variants.FirstOrDefault();
            _selectedColor = firstInStock?.Color;
            _selectedSize = firstInStock?.Size;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectColor(string color)
    {
        _selectedColor = color;
        var match = _product?.Variants.FirstOrDefault(v =>
            string.Equals(v.Color, color, StringComparison.OrdinalIgnoreCase) &&
            v.StockQuantity > 0)
            ?? _product?.Variants.FirstOrDefault(v => string.Equals(v.Color, color, StringComparison.OrdinalIgnoreCase));

        _selectedSize = match?.Size;
    }

    private bool HasStockFor(string size) =>
        _product?.Variants.Any(v =>
            (string.IsNullOrWhiteSpace(_selectedColor) || string.Equals(v.Color, _selectedColor, StringComparison.OrdinalIgnoreCase)) &&
            string.Equals(v.Size, size, StringComparison.OrdinalIgnoreCase) &&
            v.StockQuantity > 0) ?? false;

    private string _buyerCep = string.Empty;
    private int _orderQuantity = 1;
    private string _buyerName = string.Empty;
    private string _buyerWhatsapp = string.Empty;
    private string _buyerStreet = string.Empty;
    private string _buyerNumber = string.Empty;
    private string _buyerComplement = string.Empty;
    private string _buyerNeighborhood = string.Empty;
    private string _buyerCity = string.Empty;
    private string _buyerState = string.Empty;
    private string _buyerNotes = string.Empty;
    private bool _calculatingShipping;
    private bool _submittingOrder;
    private string? _checkoutError;
    private ShippingQuoteResponse? _shippingQuote;
    private StoreOrderDto? _createdPixOrder;
    private PublicOrderStatusDto? _pixStatus;
    private CancellationTokenSource? _pollingCts;

    private async Task CheckShippingQuoteAsync()
    {
        _checkoutError = null;
        _calculatingShipping = true;
        try
        {
            var lookup = await CatalogDataGateway.LookupCepAsync(_buyerCep);
            if (lookup is not null)
            {
                _buyerCep = lookup.Cep;
                if (string.IsNullOrWhiteSpace(_buyerStreet) && !string.IsNullOrWhiteSpace(lookup.Street))
                    _buyerStreet = lookup.Street;
                if (string.IsNullOrWhiteSpace(_buyerNeighborhood) && !string.IsNullOrWhiteSpace(lookup.Neighborhood))
                    _buyerNeighborhood = lookup.Neighborhood;
                if (!string.IsNullOrWhiteSpace(lookup.City))
                    _buyerCity = lookup.City;
                if (!string.IsNullOrWhiteSpace(lookup.State))
                    _buyerState = lookup.State;
            }

            _shippingQuote = await CatalogDataGateway.QuoteShippingAsync(new ShippingQuoteRequest
            {
                DestinationCep = _buyerCep,
                DestinationCity = _buyerCity,
                DestinationState = _buyerState,
                WeightGrams = (_store?.DefaultPackageWeightGrams ?? 450) * Math.Max(1, _orderQuantity)
            }, StoreSlug);
        }
        catch (Exception ex)
        {
            _checkoutError = ex.Message;
        }
        finally
        {
            _calculatingShipping = false;
        }
    }

    private async Task SubmitPixOrderAsync()
    {
        if (_product is null || SelectedVariant is null)
            return;

        _checkoutError = null;
        _submittingOrder = true;
        try
        {
            var order = await CatalogDataGateway.PlacePixOrderAsync(new CreatePixOrderRequest
            {
                ProductId = _product.Id,
                ProductVariantId = SelectedVariant.Id,
                Quantity = Math.Max(1, _orderQuantity),
                CustomerName = _buyerName,
                CustomerWhatsapp = _buyerWhatsapp,
                Cep = _buyerCep,
                Street = _buyerStreet,
                Number = _buyerNumber,
                Complement = _buyerComplement,
                Neighborhood = _buyerNeighborhood,
                City = _buyerCity,
                State = _buyerState,
                CustomerNotes = _buyerNotes
            }, StoreSlug);

            _createdPixOrder = order;
            _pixStatus = null;

            if (string.Equals(order.PaymentProvider, "MercadoPago", StringComparison.OrdinalIgnoreCase))
            {
                StartPixStatusPolling(order);
            }
        }
        catch (Exception ex)
        {
            _checkoutError = ex.Message;
        }
        finally
        {
            _submittingOrder = false;
        }
    }

    private void StartPixStatusPolling(StoreOrderDto order)
    {
        StopPixStatusPolling();
        _pollingCts = new CancellationTokenSource();
        var ct = _pollingCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
                while (await timer.WaitForNextTickAsync(ct))
                {
                    var status = await CatalogDataGateway.GetPublicOrderStatusAsync(
                        order.Id,
                        order.PublicStatusToken,
                        StoreSlug,
                        ct);

                    if (status is not null)
                    {
                        await InvokeAsync(() =>
                        {
                            _pixStatus = status;
                            StateHasChanged();
                        });

                        if (status.IsPaid || status.Status == "Cancelado")
                        {
                            break;
                        }
                    }
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
            }
        }, ct);
    }

    private void StopPixStatusPolling()
    {
        try
        {
            _pollingCts?.Cancel();
            _pollingCts?.Dispose();
        }
        catch
        {
        }
        _pollingCts = null;
    }

    private void ResetPixOrderForm()
    {
        StopPixStatusPolling();
        _createdPixOrder = null;
        _pixStatus = null;
        _checkoutError = null;
    }

    public void Dispose()
    {
        StopPixStatusPolling();
    }

    private string BuildOrderProofWhatsAppUrl(StoreOrderDto order)
    {
        var phone = _store?.WhatsappNumber ?? "5511900000000";
        var msg = $"Olá! Acabei de gerar o pedido Pix {order.OrderNumber} no valor de R$ {order.TotalPixAmount:N2} ({_product?.Name} - {SelectedVariant?.Color}/{SelectedVariant?.Size}). Endereço de entrega: {order.FormattedDeliveryAddress}. Segue comprovante do Pix!";
        return $"https://wa.me/{phone}?text={Uri.EscapeDataString(msg)}";
    }
}
