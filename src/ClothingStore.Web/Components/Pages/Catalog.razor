@page "/catalogo"
@page "/loja/{StoreSlug}/catalogo"
@inject CatalogDataGateway CatalogDataGateway

<PageTitle>Catálogo — @(_store?.StoreName ?? "YouLink Loja")</PageTitle>

@if (_storeNotFound)
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Endereço Não Encontrado</span>
        <h1 class="lux-hero-title">Loja não encontrada</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            Nenhuma vitrine ativa encontrada em <strong>/loja/@StoreSlug</strong>.
        </p>
    </section>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Loja em Atualização</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            @(_store.DeactivationReason ?? "Este catálogo está sendo atualizado com novidades.")
        </p>
        @if (!string.IsNullOrWhiteSpace(_store.WhatsappNumber))
        {
            <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
               target="_blank"
               rel="noopener noreferrer"
               class="lux-btn lux-btn-whatsapp">
                💬 Falar com a Loja no WhatsApp
            </a>
        }
    </section>
}
else
{
    <div class="lux-section-head">
        <div>
            <span class="lux-section-kicker">Escolha Fácil</span>
            <h1 class="lux-section-title">@(_store?.StoreName ?? "Todas as Roupas")</h1>
        </div>
        <span class="lux-product-sizes" style="font-size: 0.9rem; font-weight: 600;">@_products.Count peça(s) encontrada(s)</span>
    </div>

    @if (_filters.Categories.Count > 0)
    {
        <div class="lux-category-rail" style="margin-bottom: 1.5rem;" aria-label="Categorias rápidas">
            <button type="button"
                    class="lux-category-pill @(string.IsNullOrWhiteSpace(_selectedCategorySlug) ? "active" : "")"
                    @onclick="() => SelectCategoryAsync(null)">
                Todas
            </button>
            @foreach (var cat in _filters.Categories)
            {
                var isSelected = string.Equals(_selectedCategorySlug, cat.Slug, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="lux-category-pill @(isSelected ? "active" : "")"
                        @onclick="() => SelectCategoryAsync(cat.Slug)">
                    <span>@cat.Name</span>
                    <span class="lux-category-count">@cat.ProductCount</span>
                </button>
            }
        </div>
    }

    <div class="lux-catalog-layout">
        <aside class="lux-filter-panel" aria-label="Filtros do catálogo">
            <div class="lux-filter-group">
                <label class="lux-filter-label" for="cat-search">Buscar peça</label>
                <input id="cat-search"
                       class="lux-input"
                       placeholder="Ex.: Linho, Blazer, Vestido..."
                       @bind="_search"
                       @bind:event="oninput"
                       @bind:after="ApplyFiltersAsync" />
            </div>

            <div class="lux-filter-group">
                <label class="lux-filter-label" for="cat-category">Categoria</label>
                <select id="cat-category" class="lux-select" @bind="_selectedCategorySlug" @bind:after="ApplyFiltersAsync">
                    <option value="">Todas as categorias</option>
                    @foreach (var cat in _filters.Categories)
                    {
                        <option value="@cat.Slug">@cat.Name (@cat.ProductCount)</option>
                    }
                </select>
            </div>

            <div class="lux-filter-group">
                <label class="lux-filter-label" for="cat-color">Cor</label>
                <select id="cat-color" class="lux-select" @bind="_selectedColor" @bind:after="ApplyFiltersAsync">
                    <option value="">Todas as cores</option>
                    @foreach (var col in _filters.Colors)
                    {
                        <option value="@col.Color">@col.Color</option>
                    }
                </select>
            </div>

            <div class="lux-filter-group">
                <label class="lux-filter-label" for="cat-size">Tamanho</label>
                <select id="cat-size" class="lux-select" @bind="_selectedSize" @bind:after="ApplyFiltersAsync">
                    <option value="">Todos os tamanhos</option>
                    @foreach (var sz in _filters.Sizes)
                    {
                        <option value="@sz">@sz</option>
                    }
                </select>
            </div>

            <div class="lux-filter-group">
                <label class="lux-check-row">
                    <input type="checkbox" @bind="_onlyInStock" @bind:after="ApplyFiltersAsync" />
                    <span>Mostrar só peças disponíveis agora</span>
                </label>
            </div>

            <div class="lux-hero-actions">
                <button type="button" class="lux-btn lux-btn-outline lux-btn-sm" style="width: 100%;" @onclick="ClearFiltersAsync">
                    Limpar Filtros
                </button>
            </div>
        </aside>

        <div>
            @if (_loading)
            {
                <div class="lux-empty-card">
                    <p>Atualizando seleção de peças...</p>
                </div>
            }
            else if (_products.Count == 0)
            {
                <div class="lux-empty-card">
                    <h3>Nenhuma peça encontrada</h3>
                    <p class="lux-hero-subtitle">Ajuste os filtros ao lado para visualizar outras peças da coleção.</p>
                    <button type="button" class="lux-btn lux-btn-outline" @onclick="ClearFiltersAsync">
                        Restaurar Catálogo
                    </button>
                </div>
            }
            else
            {
                <div class="lux-product-grid">
                    @foreach (var product in _products)
                    {
                        <ProductCard Product="@product" StoreSlug="@EffectiveStoreSlug" />
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string? StoreSlug { get; set; }

    [SupplyParameterFromQuery(Name = "categoria")]
    public string? QueryCategorySlug { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? QueryCategoryAlt { get; set; }

    [SupplyParameterFromQuery(Name = "busca")]
    public string? QuerySearch { get; set; }

    private PublicStoreSettingsDto? _store;
    private CatalogFiltersDto _filters = new([], [], []);
    private IReadOnlyList<CatalogProductCardDto> _products = [];
    private bool _loading = true;
    private bool _storeNotFound;

    private string? _search;
    private string? _selectedCategorySlug;
    private string? _selectedColor;
    private string? _selectedSize;
    private bool _onlyInStock;

    private string? EffectiveStoreSlug =>
        !string.IsNullOrWhiteSpace(StoreSlug) ? StoreSlug : _store?.StoreSlug;

    protected override async Task OnParametersSetAsync()
    {
        _storeNotFound = false;
        _selectedCategorySlug ??= !string.IsNullOrWhiteSpace(QueryCategorySlug)
            ? QueryCategorySlug
            : QueryCategoryAlt;
        _search ??= QuerySearch;

        _store = await CatalogDataGateway.GetStoreInfoOrNullAsync(StoreSlug);
        if (!string.IsNullOrWhiteSpace(StoreSlug) && _store is null)
        {
            _storeNotFound = true;
            _loading = false;
            return;
        }

        _store ??= await CatalogDataGateway.GetStoreInfoAsync(StoreSlug);
        if (_store?.IsSiteActive == false)
        {
            _loading = false;
            return;
        }

        _filters = await CatalogDataGateway.GetFiltersAsync(StoreSlug);
        await LoadProductsAsync();
    }

    private Task ApplyFiltersAsync() => LoadProductsAsync();

    private Task SelectCategoryAsync(string? categorySlug)
    {
        _selectedCategorySlug = categorySlug;
        return LoadProductsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _search = null;
        _selectedCategorySlug = null;
        _selectedColor = null;
        _selectedSize = null;
        _onlyInStock = false;
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _loading = true;
        try
        {
            var filter = new CatalogQueryFilter(
                Search: string.IsNullOrWhiteSpace(_search) ? null : _search.Trim(),
                CategorySlug: string.IsNullOrWhiteSpace(_selectedCategorySlug) ? null : _selectedCategorySlug.Trim(),
                Color: string.IsNullOrWhiteSpace(_selectedColor) ? null : _selectedColor.Trim(),
                Size: string.IsNullOrWhiteSpace(_selectedSize) ? null : _selectedSize.Trim(),
                OnlyInStock: _onlyInStock);

            _products = await CatalogDataGateway.GetProductsAsync(filter, StoreSlug);
        }
        finally
        {
            _loading = false;
        }
    }
}
