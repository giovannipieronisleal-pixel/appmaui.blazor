@page "/"
@page "/loja/{StoreSlug}"
@inject CatalogDataGateway CatalogDataGateway
@inject NavigationManager Navigation

<PageTitle>@(_store?.StoreName ?? "Loja Online") — Roupas &amp; Catálogo</PageTitle>

@if (_loading)
{
    <div class="lux-empty-card">
        <p class="lux-hero-eyebrow">Carregando Loja</p>
        <h2>Preparando as novidades para você...</h2>
    </div>
}
else if (_store is { IsSiteActive: false })
{
    <section class="lux-empty-card">
        <span class="lux-hero-eyebrow">Loja em Atualização</span>
        <h1 class="lux-hero-title">@_store.StoreName</h1>
        <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
            @(_store.DeactivationReason ?? "Estamos atualizando nossa vitrine com novas peças. Você já pode falar direto com nossa equipe pelo WhatsApp!")
        </p>

        @if (!string.IsNullOrWhiteSpace(_store.WhatsappNumber))
        {
            <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
               target="_blank"
               rel="noopener noreferrer"
               class="lux-btn lux-btn-whatsapp">
                💬 Falar com a Loja no WhatsApp
            </a>
        }
    </section>
}
else
{
    <section class="lux-hero @HeroVariantClass">
        <div class="lux-hero-copy">
            @if (_design.ShowLookbookBadge)
            {
                <span class="lux-hero-eyebrow">@HeroEyebrowText</span>
            }

            <h1 class="lux-hero-title">@HeroHeadlineText</h1>
            <p class="lux-hero-subtitle">@(_store?.StoreDescription ?? "Escolha suas peças favoritas, confira cores e tamanhos disponíveis e faça seu pedido direto pelo WhatsApp.")</p>

            <div class="lux-hero-actions">
                <a href="@CatalogHref()" class="lux-btn lux-btn-primary">Ver Todas as Roupas</a>

                @if (_store is not null && !string.IsNullOrWhiteSpace(_store.WhatsappNumber))
                {
                    <a href="@WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName)"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="lux-btn lux-btn-whatsapp">
                        💬 Tirar Dúvidas no WhatsApp
                    </a>
                }
            </div>

            <form class="lux-quick-search" @onsubmit="GoSearch" @onsubmit:preventDefault="true">
                <input type="text"
                       class="lux-input"
                       placeholder="O que você procura? Ex.: Vestido, Calça, Camisa..."
                       @bind="_quickSearch" />
                <button type="submit" class="lux-btn lux-btn-outline">
                    Buscar
                </button>
            </form>
        </div>

        @if (_design.HeroLayout == "split")
        {
            <aside class="lux-concierge-panel" aria-label="Como comprar">
                <h2 class="lux-concierge-heading">Comprar Aqui é Muito Simples</h2>
                <div class="lux-concierge-step">
                    <span class="lux-step-num">1</span>
                    <div>
                        <strong>Escolha a sua roupa</strong>
                        <span>Veja as fotos, o preço e toque na peça que mais combina com você.</span>
                    </div>
                </div>
                <div class="lux-concierge-step">
                    <span class="lux-step-num">2</span>
                    <div>
                        <strong>Toque na cor e no tamanho</strong>
                        <span>Você vê na hora o que temos disponível antes de chamar a loja.</span>
                    </div>
                </div>
                <div class="lux-concierge-step">
                    <span class="lux-step-num">3</span>
                    <div>
                        <strong>Finalize no WhatsApp</strong>
                        <span>Um toque abre a conversa pronta com nossa equipe para entrega ou retirada.</span>
                    </div>
                </div>
            </aside>
        }
    </section>

    @if (_categories.Count > 0)
    {
        <section class="lux-section">
            <div class="lux-section-head">
                <div>
                    <span class="lux-section-kicker">Escolha por Estilo</span>
                    <h2 class="lux-section-title">Categorias da Loja</h2>
                </div>
                <a href="@CatalogHref()" class="lux-link-arrow">Ver tudo &rarr;</a>
            </div>

            <div class="lux-category-rail">
                <a href="@CatalogHref()" class="lux-category-pill active">
                    <span>Todas as roupas</span>
                </a>
                @foreach (var cat in _categories)
                {
                    <a href="@CatalogHref(cat.Slug)" class="lux-category-pill">
                        <span>@cat.Name</span>
                        <span class="lux-category-count">@cat.ProductCount</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="lux-section">
        <div class="lux-section-head">
            <div>
                <span class="lux-section-kicker">Novidades &amp; Destaques</span>
                <h2 class="lux-section-title">Peças para Você Escolher</h2>
            </div>
            <a href="@CatalogHref()" class="lux-link-arrow">Ver Todas (@_featuredProducts.Count+) &rarr;</a>
        </div>

        @if (_featuredProducts.Count == 0)
        {
            <div class="lux-empty-card">
                <h3>Em breve novas peças!</h3>
                <p class="lux-hero-subtitle" style="margin-left: auto; margin-right: auto;">
                    Novos looks estão sendo preparados. Fale com nossa equipe no WhatsApp para saber o que acaba de chegar.
                </p>
            </div>
        }
        else
        {
            <div class="lux-product-grid">
                @foreach (var product in _featuredProducts)
                {
                    <ProductCard Product="@product" StoreSlug="@EffectiveStoreSlug" />
                }
            </div>
        }
    </section>

    <section class="lux-trust-strip" aria-label="Facilidades da loja">
        <div class="lux-trust-card">
            <span>🛍️</span>
            <div>
                <strong>Compra Fácil e Direta</strong>
                <span>Sem cadastro complicado: gostou da peça, é só pedir no WhatsApp.</span>
            </div>
        </div>
        <div class="lux-trust-card">
            <span>✨</span>
            <div>
                <strong>Tamanhos Reais na Hora</strong>
                <span>Confira cores e tamanhos disponíveis antes mesmo de enviar mensagem.</span>
            </div>
        </div>
        <div class="lux-trust-card">
            <span>💬</span>
            <div>
                <strong>Atendimento Humano</strong>
                <span>Tire dúvidas sobre tecido, caimento e entrega direto com quem atende na loja.</span>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? StoreSlug { get; set; }

    private PublicStoreSettingsDto? _store;
    private StoreDesignDto _design = StoreDesignDto.CreateMinimalistaLuxo();
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<CatalogProductCardDto> _featuredProducts = [];
    private bool _loading = true;
    private string? _quickSearch;

    private string? EffectiveStoreSlug =>
        !string.IsNullOrWhiteSpace(StoreSlug) ? StoreSlug : _store?.StoreSlug;

    private string HeroVariantClass => _design.HeroLayout switch
    {
        "centered" => "lux-hero-centered",
        "banner" => "lux-hero-banner",
        _ => "lux-hero-split"
    };

    private string HeroEyebrowText =>
        !string.IsNullOrWhiteSpace(_design.HeroEyebrow)
            ? _design.HeroEyebrow
            : "Nova Coleção Disponível";

    private string HeroHeadlineText =>
        !string.IsNullOrWhiteSpace(_design.HeroHeadline)
            ? _design.HeroHeadline
            : (_store?.StoreName ?? "Catálogo Online");

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _store = await CatalogDataGateway.GetStoreInfoAsync();
            _design = StoreDesignCssHelper.Sanitize(_store?.Design);

            if (_store?.IsSiteActive != false)
            {
                _categories = await CatalogDataGateway.GetCategoriesAsync();
                var products = await CatalogDataGateway.GetProductsAsync(new CatalogQueryFilter());
                _featuredProducts = products.Take(12).ToList();
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoSearch()
    {
        var basePath = CatalogHref();
        if (string.IsNullOrWhiteSpace(_quickSearch))
        {
            Navigation.NavigateTo(basePath);
            return;
        }
        Navigation.NavigateTo($"{basePath}?busca={Uri.EscapeDataString(_quickSearch.Trim())}");
    }

    private string CatalogHref(string? categorySlug = null)
    {
        var basePath = string.IsNullOrWhiteSpace(EffectiveStoreSlug)
            ? "/catalogo"
            : $"/loja/{EffectiveStoreSlug}/catalogo";

        return string.IsNullOrWhiteSpace(categorySlug)
            ? basePath
            : $"{basePath}?categoria={Uri.EscapeDataString(categorySlug)}";
    }
}
