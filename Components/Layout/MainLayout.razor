@inherits LayoutComponentBase
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ThemeService Theme
@inject StoreBrandStateService BrandState
@inject GoogleCloudSyncService CloudSync
@inject AppUpdateService UpdateService
@implements IDisposable

<div class="@Theme.CurrentThemeClass">
    <StoreDesignStyleInjector Design="@BrandState.EffectiveDesign" />
    @if (!Gateway.IsAuthenticated && !IsPublicCatalogRoute())
    {
        <div class="adm-login-wrapper">
            <div class="adm-login-container">
                <appmaui.blazor.Components.Pages.Login />
            </div>
        </div>
    }
    else if (IsPublicCatalogRoute())
    {
        <main class="adm-public-main">
            @Body
        </main>
    }
    else
    {
        <div class="adm-shell">
            <aside class="adm-sidebar">
                <div class="adm-brand">
                    <div style="display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.45rem; padding-bottom: 0.45rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
                        <img src="images/youlink-mark.svg" alt="YouLink" style="width: 24px; height: 24px; border-radius: 6px;" />
                        <span style="font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; color: #FAF8F5;">YouLink</span>
                    </div>
                    <div>@_storeName.ToUpperInvariant()</div>
                    <div style="font-size: 0.75rem; font-weight: 400; opacity: 0.8; margin-top: 0.2rem;">
                        /loja/@_storeSlug
                    </div>
                </div>

                <NavMenu OnOpenProfile="OpenUserProfileModal" OnLogoutRequested="HandleLogout" />
            </aside>

            <div class="adm-main">
                <header class="adm-topbar">
                    <div class="adm-topbar-meta" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <strong class="adm-topbar-title">@_storeName</strong>
                        <a href="/planos"
                           style="text-decoration: none;"
                           title="Ver planos e versões do site"
                           class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                            @(BrandState.IsPremiumPlan ? "✦ Premium Sob Medida" : BrandState.IsIntermediatePlan ? "◈ Meia Versão (5 Temas)" : "Minimalista Luxo")
                        </a>
                        <span class="adm-topbar-hide-sm pill-badge @(Gateway.IsAdmin ? "pill-green" : "pill-slate")">
                            @(Gateway.IsAdmin ? "Admin" : "Equipe")
                        </span>

                        @if (!string.IsNullOrWhiteSpace(_onlineBaseUrl))
                        {
                            <span class="adm-topbar-hide-sm pill-badge pill-blue" title="Catálogo 24h Online no Google Cloud">
                                ☁️ 24h Online
                            </span>
                        }
                    </div>

                    <div class="adm-topbar-actions" style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                        @if (UpdateService.AvailableRelease?.IsUpdateAvailable == true)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-accent"
                                    style="padding: 0.4rem 0.68rem; min-height: 36px; font-size: 0.8rem; font-weight: 800;"
                                    title="Há uma atualização pronta para baixar e instalar pelo app"
                                    @onclick="UpdateService.OpenPopup">
                                ⬆️ Atualizar v@(UpdateService.AvailableRelease.LatestVersion)
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-outline adm-topbar-hide-sm"
                                    style="padding: 0.4rem 0.6rem; min-height: 36px; font-size: 0.78rem;"
                                    title="Verificar atualizações do aplicativo"
                                    disabled="@UpdateService.IsChecking"
                                    @onclick="CheckUpdatesManuallyFromTopbarAsync">
                                @(UpdateService.IsChecking ? "⏳" : "🔄") v@(UpdateService.CurrentVersion)
                            </button>
                        }

                        <!-- Botão Alternador Rápido de Tema Claro / Escuro -->
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="padding: 0.4rem 0.65rem; min-height: 36px; font-size: 0.82rem;"
                                title="@($"Tema atual: {Theme.ThemeDisplayName}. Toque para alternar.")"
                                @onclick="Theme.ToggleTheme">
                            @(Theme.IsDarkMode ? "☀️" : "🌙")<span class="adm-topbar-hide-xs"> @(Theme.IsDarkMode ? "Claro" : "Escuro")</span>
                        </button>

                        <a href="/loja/@_storeSlug"
                           class="adm-btn adm-btn-success"
                           style="padding: 0.4rem 0.7rem; min-height: 36px; font-size: 0.8rem;">
                            🌐 <span class="adm-topbar-hide-xs">Ver </span>Catálogo
                        </a>

                        <button type="button"
                                class="adm-btn adm-btn-outline adm-topbar-hide-sm"
                                style="padding: 0.4rem 0.7rem; min-height: 36px; font-size: 0.8rem;"
                                @onclick="OpenBrowserAsync">
                            Abrir no Navegador &nearr;
                        </button>

                        <!-- Botão de Perfil do Usuário & Segurança (2FA) -->
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="padding: 0.35rem 0.65rem; min-height: 36px; font-size: 0.8rem; display: flex; align-items: center; gap: 0.45rem; border-color: var(--adm-accent);"
                                title="Configurações do Usuário: E-mail, Senha e 2FA"
                                @onclick="() => _showUserProfileModal = true">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: var(--adm-accent); color: #fff; font-size: 0.72rem; font-weight: 800;">
                                @GetUserInitials(Gateway.CurrentEmployee?.FullName)
                            </span>
                            <span class="adm-topbar-hide-xs" style="max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @(Gateway.CurrentEmployee?.FullName ?? "Meu Perfil")
                            </span>
                            <span class="adm-topbar-hide-xs pill-badge @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "pill-green" : "pill-slate")" style="font-size: 0.68rem; padding: 0.1rem 0.35rem;">
                                @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "🛡️ 2FA Ativo" : "⚙️ Perfil")
                            </span>
                        </button>

                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="padding: 0.4rem 0.65rem; min-height: 36px; font-size: 0.8rem;"
                                title="Sair ou trocar de conta"
                                @onclick="HandleLogout">
                            🚪 <span class="adm-topbar-hide-xs">Trocar Conta / </span>Sair
                        </button>
                    </div>
                </header>

                @if ((UpdateService.AvailableRelease?.IsUpdateAvailable == true || _compatibilityStatus?.UpdateRecommended == true) && !_dismissedUpdateBanner)
                {
                    var latestVersionLabel = UpdateService.AvailableRelease?.IsUpdateAvailable == true
                        ? UpdateService.AvailableRelease.LatestVersion
                        : _compatibilityStatus?.LatestAppVersion ?? string.Empty;
                    <div class="adm-compat-banner" style="display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; flex-wrap: wrap; padding: 0.6rem 1rem; background: color-mix(in srgb, var(--adm-accent) 12%, var(--adm-surface)); border-bottom: 1px solid var(--adm-border); font-size: 0.82rem;">
                        <span>
                            ✨ <strong>Atualização v@(latestVersionLabel) disponível</strong> — toque para baixar e atualizar diretamente pelo app.
                        </span>
                        <div style="display: flex; gap: 0.45rem; align-items: center;">
                            <button type="button" class="adm-btn adm-btn-accent" style="padding: 0.3rem 0.65rem; font-size: 0.78rem;" @onclick="UpdateService.OpenPopup">
                                🚀 Atualizar v@(latestVersionLabel)
                            </button>
                            <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.3rem 0.55rem; font-size: 0.76rem;" @onclick="() => _dismissedUpdateBanner = true">
                                Dispensar
                            </button>
                        </div>
                    </div>
                }

                <main class="adm-content">
                    @Body
                </main>
            </div>
        </div>
    }

    <appmaui.blazor.Components.Pages.UserProfileModal @bind-IsOpen="_showUserProfileModal" OnLogoutRequested="HandleLogout" />
    <appmaui.blazor.Components.Shared.AppUpdateModal />
</div>

@code {
    private string _storeName = "Minha Loja";
    private string _storeSlug = "minha-loja";
    private string? _onlineBaseUrl;
    private bool _showUserProfileModal;
    private ApiCompatibilityStatusDto? _compatibilityStatus;
    private bool _dismissedUpdateBanner;

    private static string GetUserInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Theme.OnThemeChanged += OnThemeChanged;
        BrandState.OnBrandChanged += OnBrandChanged;
        CloudSync.OnSyncStatusChanged += OnSyncStatusChanged;
        UpdateService.StateChanged += OnUpdateStateChanged;

        UpdateService.StartBackgroundMonitor();
        await Gateway.TryRestoreSessionAsync();
        await RefreshStoreInfoAsync();
        _ = RunStartupBackgroundChecksAsync();
    }

    private async Task RefreshUpdatesInBackgroundAsync()
    {
        try
        {
            await UpdateService.CheckForUpdatesAsync();
            _compatibilityStatus = Gateway.LatestCompatibilityStatus;
        }
        catch
        {
        }
    }

    private async Task CheckUpdatesManuallyFromTopbarAsync()
    {
        await UpdateService.CheckForUpdatesAsync(manualTrigger: true);
        UpdateService.OpenPopup();
    }

    private async Task RunStartupBackgroundChecksAsync()
    {
        await RefreshUpdatesInBackgroundAsync();

        try
        {
            await CloudSync.EnsureCloudMirrorPopulatedAsync();
        }
        catch
        {
        }
    }

    private bool IsPublicCatalogRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return relative.StartsWith("site", StringComparison.OrdinalIgnoreCase) ||
               relative.StartsWith("loja/", StringComparison.OrdinalIgnoreCase);
    }

    private async Task RefreshStoreInfoAsync()
    {
        try
        {
            var store = await CatalogService.GetPublicStoreSettingsAsync();
            _storeName = store.StoreName;
            _storeSlug = store.StoreSlug;
            _onlineBaseUrl = store.OnlineBaseUrl;
            BrandState.ApplyFromPublicSettings(store);
        }
        catch
        {
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshStoreInfoAsync();
        _ = RefreshUpdatesInBackgroundAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnAuthStateChanged()
    {
        _ = RefreshUpdatesInBackgroundAsync();
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnBrandChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async void OnSyncStatusChanged()
    {
        await RefreshStoreInfoAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnUpdateStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenBrowserAsync()
    {
        // Se houver URL do Google Cloud configurada, abre diretamente a URL online 24h!
        var targetBase = !string.IsNullOrWhiteSpace(_onlineBaseUrl) ? _onlineBaseUrl : "http://localhost:5190";
        var url = WhatsAppLinkBuilder.BuildStoreCatalogUrl(targetBase, _storeSlug);
        try
        {
            LocalWebServerLauncher.Initialize(CatalogService);
            await LocalWebServerLauncher.OpenCatalogInBrowserAsync(url, _storeSlug);
        }
        catch
        {
        }
    }

    private void OpenUserProfileModal() => _showUserProfileModal = true;

    private void HandleLogout()
    {
        Gateway.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Gateway.AuthStateChanged -= OnAuthStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Theme.OnThemeChanged -= OnThemeChanged;
        BrandState.OnBrandChanged -= OnBrandChanged;
        CloudSync.OnSyncStatusChanged -= OnSyncStatusChanged;
        UpdateService.StateChanged -= OnUpdateStateChanged;
    }
}
