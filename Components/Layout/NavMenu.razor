@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@implements IDisposable

<nav class="adm-nav">
    <NavLink class="adm-nav-item" href="/" Match="NavLinkMatch.All">
        <span>Dashboard</span>
    </NavLink>

    <NavLink class="adm-nav-item" href="/produtos">
        <span>Produtos &amp; Variantes</span>
    </NavLink>

    <NavLink class="adm-nav-item" href="/estoque">
        <span>Controle de Estoque</span>
    </NavLink>

    @if (Gateway.IsAdmin)
    {
        <div class="adm-nav-section-label" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #71717A; padding: 1rem 0.85rem 0.25rem;">
            Administração
        </div>

        <NavLink class="adm-nav-item" href="/funcionarios">
            <span>Funcionários &amp; Acesso</span>
        </NavLink>

        <NavLink class="adm-nav-item" href="/configuracoes-loja">
            <span>Configurações da loja</span>
        </NavLink>
    }

    <div class="adm-nav-section-label" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #71717A; padding: 1rem 0.85rem 0.25rem;">
        Catálogo Público (QR Code)
    </div>

    <NavLink class="adm-nav-item" href="@($"/loja/{_storeSlug}")">
        <span>Ver Site (/loja/@_storeSlug)</span>
    </NavLink>
</nav>

@code {
    private string _storeSlug = "minha-loja";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshSlugAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshSlugAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSlugAsync()
    {
        try
        {
            var info = await CatalogService.GetPublicStoreSettingsAsync();
            _storeSlug = info.StoreSlug;
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
