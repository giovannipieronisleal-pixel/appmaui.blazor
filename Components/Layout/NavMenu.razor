@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@implements IDisposable

<nav class="adm-nav">
    <NavLink class="adm-nav-item" href="/" Match="NavLinkMatch.All">
        <span class="adm-nav-icon">📊</span>
        <span>Início</span>
    </NavLink>

    <NavLink class="adm-nav-item" href="/produtos">
        <span class="adm-nav-icon">👗</span>
        <span>Produtos</span>
    </NavLink>

    <NavLink class="adm-nav-item" href="/estoque">
        <span class="adm-nav-icon">📦</span>
        <span>Estoque</span>
    </NavLink>

    @if (Gateway.IsAdmin)
    {
        <div class="adm-nav-section-label" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94A3B8; padding: 1rem 0.85rem 0.25rem;">
            Administração
        </div>

        <NavLink class="adm-nav-item" href="/funcionarios">
            <span class="adm-nav-icon">👥</span>
            <span>Equipe</span>
        </NavLink>

        <NavLink class="adm-nav-item" href="/configuracoes-loja">
            <span class="adm-nav-icon">⚙️</span>
            <span>Loja</span>
        </NavLink>
    }

    <div class="adm-nav-section-label" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94A3B8; padding: 1rem 0.85rem 0.25rem;">
        Catálogo Público
    </div>

    <NavLink class="adm-nav-item" href="@($"/loja/{_storeSlug}")">
        <span class="adm-nav-icon">🌐</span>
        <span>Site</span>
    </NavLink>
</nav>

@code {
    private string _storeSlug = "minha-loja";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshSlugAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshSlugAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSlugAsync()
    {
        try
        {
            var info = await CatalogService.GetPublicStoreSettingsAsync();
            _storeSlug = info.StoreSlug;
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
