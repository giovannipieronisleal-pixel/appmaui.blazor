@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject StoreBrandStateService BrandState
@inject NavigationManager Navigation
@implements IDisposable

<nav class="adm-nav">
    <NavLink class="adm-nav-item" href="/" Match="NavLinkMatch.All">
        <span class="adm-nav-icon">📊</span>
        <span>Início</span>
    </NavLink>

    <NavLink class="adm-nav-item" href="/produtos">
        <span class="adm-nav-icon">👗</span>
        <span>Produtos</span>
    </NavLink>

    <NavLink class="@($"adm-nav-item {(Gateway.IsAdmin ? "adm-nav-secondary" : string.Empty)}")" href="/estoque">
        <span class="adm-nav-icon">📦</span>
        <span>Estoque</span>
    </NavLink>

    @if (Gateway.IsAdmin || Gateway.CanManageStock)
    {
        var hasPaidSales = BrandState.IsIntermediatePlan || BrandState.IsPremiumPlan;
        <NavLink class="adm-nav-item" href="/vendas">
            <span class="adm-nav-icon">💰</span>
            <span>Vendas@(hasPaidSales ? string.Empty : " 🔒")</span>
        </NavLink>
    }

    @if (Gateway.IsAdmin)
    {
        <div class="adm-nav-section-label">
            Administração
        </div>

        <NavLink class="adm-nav-item adm-nav-secondary" href="/funcionarios">
            <span class="adm-nav-icon">👥</span>
            <span>Equipe</span>
        </NavLink>

        <NavLink class="adm-nav-item adm-nav-secondary" href="/configuracoes-loja">
            <span class="adm-nav-icon">🎨</span>
            <span>Loja &amp; Visual</span>
        </NavLink>

        <NavLink class="adm-nav-item" href="/pedidos">
            <span class="adm-nav-icon">🧾</span>
            <span>Pedidos</span>
        </NavLink>

        <NavLink class="adm-nav-item adm-nav-secondary" href="/planos">
            <span class="adm-nav-icon">💎</span>
            <span>Planos</span>
        </NavLink>
    }

    <div class="adm-nav-section-label">
        Catálogo Público
    </div>

    <NavLink class="adm-nav-item adm-nav-secondary" href="@($"/loja/{_storeSlug}")">
        <span class="adm-nav-icon">🌐</span>
        <span>Site</span>
    </NavLink>

    <button type="button"
            class="adm-nav-item adm-nav-more-btn @(IsSecondaryRouteActive() || _mobileMoreOpen ? "active" : string.Empty)"
            @onclick="ToggleMobileMore"
            aria-expanded="@_mobileMoreOpen"
            aria-label="Mais opções do menu">
        <span class="adm-nav-icon">⋯</span>
        <span>Mais</span>
    </button>
</nav>

@if (Gateway.IsAuthenticated && Gateway.CurrentEmployee is not null)
{
    var accountSubText = !string.IsNullOrWhiteSpace(Gateway.CurrentEmployee.Email)
        ? Gateway.CurrentEmployee.Email
        : Gateway.CurrentEmployee.EffectiveUsername;
    <div class="adm-sidebar-footer">
        <div class="adm-sidebar-account-card">
            <div class="adm-sidebar-account-row">
                <span class="adm-sidebar-avatar">@GetUserInitials(Gateway.CurrentEmployee.FullName)</span>
                <div class="adm-sidebar-account-meta">
                    <div class="adm-sidebar-account-name-row">
                        <strong class="adm-sidebar-account-name">@Gateway.CurrentEmployee.FullName</strong>
                        <span class="pill-badge @(Gateway.IsAdmin ? "pill-green" : "pill-slate") adm-sidebar-role-badge">
                            @(Gateway.IsAdmin ? "Admin" : "Equipe")
                        </span>
                    </div>
                    <span class="adm-sidebar-account-sub" title="@accountSubText">@accountSubText</span>
                </div>
            </div>
            <div class="adm-sidebar-account-actions">
                <button type="button" class="adm-sidebar-acc-btn" @onclick="OpenProfileAsync">
                    👤 Perfil &amp; 2FA
                </button>
                <button type="button" class="adm-sidebar-acc-btn adm-sidebar-acc-btn-logout" @onclick="LogoutAsync">
                    🚪 Trocar Conta
                </button>
            </div>
        </div>
    </div>
}

@if (_mobileMoreOpen)
{
    <div class="adm-mobile-sheet-backdrop" @onclick="CloseMobileMore">
        <div class="adm-mobile-sheet" role="dialog" aria-modal="true" aria-labelledby="adm-mobile-sheet-heading" @onclick:stopPropagation="true">
            <div class="adm-mobile-sheet-handle-wrap" aria-hidden="true">
                <div class="adm-mobile-sheet-handle"></div>
            </div>
            <div class="adm-mobile-sheet-header">
                <div class="adm-mobile-sheet-heading-group">
                    <strong id="adm-mobile-sheet-heading" class="adm-mobile-sheet-title">Menu da Loja</strong>
                    <span class="adm-mobile-sheet-subtitle">Toque na opção que deseja abrir</span>
                </div>
                <button type="button" class="adm-mobile-sheet-close" @onclick="CloseMobileMore" aria-label="Fechar menu">✕</button>
            </div>
            @if (Gateway.IsAuthenticated && Gateway.CurrentEmployee is not null)
            {
                <div class="adm-mobile-account-box">
                    <div class="adm-mobile-account-info">
                        <span class="adm-mobile-account-avatar">@GetUserInitials(Gateway.CurrentEmployee.FullName)</span>
                        <div class="adm-mobile-account-text">
                            <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                                <strong class="adm-mobile-account-name">@Gateway.CurrentEmployee.FullName</strong>
                                <span class="pill-badge @(Gateway.IsAdmin ? "pill-green" : "pill-slate")">
                                    @(Gateway.IsAdmin ? "Admin" : "Equipe")
                                </span>
                            </div>
                            <span class="adm-mobile-account-email">@(!string.IsNullOrWhiteSpace(Gateway.CurrentEmployee.Email) ? Gateway.CurrentEmployee.Email : Gateway.CurrentEmployee.EffectiveUsername)</span>
                        </div>
                    </div>
                    <div class="adm-mobile-account-actions">
                        <button type="button" class="adm-mobile-account-btn" @onclick="OpenProfileAsync">
                            👤 Meu Perfil &amp; 2FA
                        </button>
                        <button type="button" class="adm-mobile-account-btn adm-mobile-account-btn-danger" @onclick="LogoutAsync">
                            🚪 Sair / Trocar Conta
                        </button>
                    </div>
                </div>
            }
            <div class="adm-mobile-sheet-grid">
                <NavLink class="adm-mobile-sheet-link" href="/estoque" @onclick="CloseMobileMore">
                    <span class="adm-mobile-sheet-icon">📦</span>
                    <span class="adm-mobile-sheet-copy">
                        <span class="adm-mobile-sheet-item-title">Estoque</span>
                        <span class="adm-mobile-sheet-item-desc">Controlar quantidades e tamanhos</span>
                    </span>
                    <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                </NavLink>
                @if (Gateway.IsAdmin || Gateway.CanManageStock)
                {
                    <NavLink class="adm-mobile-sheet-link" href="/vendas" @onclick="CloseMobileMore">
                        <span class="adm-mobile-sheet-icon">💰</span>
                        <span class="adm-mobile-sheet-copy">
                            <span class="adm-mobile-sheet-item-title">Vendas</span>
                            <span class="adm-mobile-sheet-item-desc">Caixa, Pix e faturamento</span>
                        </span>
                        <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                    </NavLink>
                }
                @if (Gateway.IsAdmin)
                {
                    <NavLink class="adm-mobile-sheet-link" href="/pedidos" @onclick="CloseMobileMore">
                        <span class="adm-mobile-sheet-icon">🧾</span>
                        <span class="adm-mobile-sheet-copy">
                            <span class="adm-mobile-sheet-item-title">Pedidos Pix</span>
                            <span class="adm-mobile-sheet-item-desc">Confirmar pagamentos e entregas</span>
                        </span>
                        <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                    </NavLink>
                    <NavLink class="adm-mobile-sheet-link" href="/funcionarios" @onclick="CloseMobileMore">
                        <span class="adm-mobile-sheet-icon">👥</span>
                        <span class="adm-mobile-sheet-copy">
                            <span class="adm-mobile-sheet-item-title">Equipe</span>
                            <span class="adm-mobile-sheet-item-desc">Acessos e funcionários da loja</span>
                        </span>
                        <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                    </NavLink>
                    <NavLink class="adm-mobile-sheet-link" href="/configuracoes-loja" @onclick="CloseMobileMore">
                        <span class="adm-mobile-sheet-icon">🎨</span>
                        <span class="adm-mobile-sheet-copy">
                            <span class="adm-mobile-sheet-item-title">Loja &amp; Visual</span>
                            <span class="adm-mobile-sheet-item-desc">Nome, logo, cores e servidor</span>
                        </span>
                        <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                    </NavLink>
                    <NavLink class="adm-mobile-sheet-link" href="/planos" @onclick="CloseMobileMore">
                        <span class="adm-mobile-sheet-icon">💎</span>
                        <span class="adm-mobile-sheet-copy">
                            <span class="adm-mobile-sheet-item-title">Planos &amp; Domínio</span>
                            <span class="adm-mobile-sheet-item-desc">Assinatura, Gift Card e endereço</span>
                        </span>
                        <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                    </NavLink>
                }
                <NavLink class="adm-mobile-sheet-link adm-mobile-sheet-link-storefront" href="@($"/loja/{_storeSlug}")" @onclick="CloseMobileMore">
                    <span class="adm-mobile-sheet-icon adm-mobile-sheet-icon-storefront">🌐</span>
                    <span class="adm-mobile-sheet-copy">
                        <span class="adm-mobile-sheet-item-title">Ver Vitrine / Site</span>
                        <span class="adm-mobile-sheet-item-desc">Abrir catálogo online dos clientes</span>
                    </span>
                    <span class="adm-mobile-sheet-chevron" aria-hidden="true">›</span>
                </NavLink>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnOpenProfile { get; set; }
    [Parameter] public EventCallback OnLogoutRequested { get; set; }

    private string _storeSlug = "minha-loja";
    private bool _mobileMoreOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Gateway.AuthStateChanged += OnAuthStateChanged;
        await RefreshSlugAsync();
    }

    private void ToggleMobileMore() => _mobileMoreOpen = !_mobileMoreOpen;
    private void CloseMobileMore() => _mobileMoreOpen = false;

    private async Task OpenProfileAsync()
    {
        _mobileMoreOpen = false;
        if (OnOpenProfile.HasDelegate)
        {
            await OnOpenProfile.InvokeAsync();
        }
    }

    private async Task LogoutAsync()
    {
        _mobileMoreOpen = false;
        if (OnLogoutRequested.HasDelegate)
        {
            await OnLogoutRequested.InvokeAsync();
        }
        else
        {
            Gateway.Logout();
            Navigation.NavigateTo("/");
        }
    }

    private static string GetUserInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][..1].ToUpperInvariant();

        return $"{parts[0][..1]}{parts[^1][..1]}".ToUpperInvariant();
    }

    private bool IsSecondaryRouteActive()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        return path.StartsWith("estoque")
            || path.StartsWith("funcionarios")
            || path.StartsWith("configuracoes")
            || path.StartsWith("planos")
            || path.StartsWith("loja");
    }

    private async void OnAuthStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileMoreOpen = false;
        await RefreshSlugAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshSlugAsync()
    {
        try
        {
            var info = await CatalogService.GetPublicStoreSettingsAsync();
            _storeSlug = info.StoreSlug;
            BrandState.ApplyFromPublicSettings(info);
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Gateway.AuthStateChanged -= OnAuthStateChanged;
    }
}
