@page "/site"
@page "/loja/{StoreSlug}"
@page "/loja/{StoreSlug}/catalogo"
@page "/site/produto/{Slug}"
@page "/loja/{StoreSlug}/produto/{Slug}"
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject OrderAndShippingService OrderService
@inject StoreBrandStateService BrandState
@inject NavigationManager Navigation

<StoreDesignStyleInjector Design="@_store.Design" />

@{
    var baseSite = !string.IsNullOrWhiteSpace(_store.OnlineBaseUrl) ? _store.OnlineBaseUrl : "http://localhost:5190";
    var fullStoreUrl = WhatsAppLinkBuilder.BuildStoreCatalogUrl(baseSite, _store.StoreSlug);
}

@if (Gateway.IsAuthenticated)
{
    <!-- Barra Superior de Controle (Exibida apenas para usuários autenticados no App) -->
    <div class="adm-public-preview-bar" style="background: #18181B; color: #FFFFFF; border-color: rgba(255,255,255,0.12);">
        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; flex: 1 1 220px; min-width: 0;">
            @if (_store.IsSiteActive)
            {
                <span style="background: #16A34A; color: #FFFFFF; font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; text-transform: uppercase;">
                    🟢 Site Visível para o Público
                </span>
            }
            else
            {
                <span style="background: #DC2626; color: #FFFFFF; font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; text-transform: uppercase;">
                    🔴 Site Oculto / Pausado para Clientes
                </span>
            }

            <span class="adm-public-preview-url" style="font-size: 0.84rem; color: #D4D4D8;">
                Como seus clientes veem: <strong style="color: #FFFFFF; font-family: monospace;">@fullStoreUrl</strong>
            </span>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            @if (Gateway.IsAdmin)
            {
                <button type="button"
                        class="adm-btn"
                        style="background: @(_store.IsSiteActive ? "#991B1B" : "#15803D"); color: #FFFFFF; padding: 0.35rem 0.75rem; font-size: 0.8rem;"
                        @onclick="TogglePublicVisibilityAsync">
                    @(_store.IsSiteActive ? "Ocultar do Público" : "Publicar Site Agora")
                </button>
            }

            <button type="button"
                    class="adm-btn"
                    style="background: #27272A; color: #FFFFFF; border: 1px solid #3F3F46; padding: 0.35rem 0.75rem; font-size: 0.8rem;"
                    @onclick="() => CopyLinkAsync(fullStoreUrl)">
                @(_copied ? "Link Copiado!" : "Copiar Link")
            </button>

            <button type="button"
                    class="adm-btn"
                    style="background: #27272A; color: #FFFFFF; border: 1px solid #3F3F46; padding: 0.35rem 0.75rem; font-size: 0.8rem;"
                    @onclick="() => OpenExternalWebsiteAsync(fullStoreUrl)">
                Abrir no Navegador &nearr;
            </button>

            <a href="/" class="adm-btn" style="background: #FFFFFF; color: #18181B; padding: 0.35rem 0.75rem; font-size: 0.8rem; font-weight: 700;">
                Voltar ao Painel
            </a>
        </div>
    </div>

    @if (!_store.IsSiteActive)
    {
        <div class="alert-banner alert-error" style="margin-bottom: 1rem;">
            <strong>Atenção:</strong> Seu site está pausado. Seus clientes que abrirem o link verão apenas o aviso de loja em atualização até você clicar em <strong>"Publicar Site Agora"</strong>.
        </div>
    }
}

<!-- Cabeçalho da Loja (Carregado Dinamicamente das Configurações da Loja) -->
@{
    var activeDesign = StoreDesignCssHelper.Sanitize(_store.Design);
    var previewHeroModifier = activeDesign.HeroLayout switch
    {
        "centered" => "lux-preview-hero-centered",
        "banner" => "lux-preview-hero-banner",
        _ => string.Empty
    };
    var previewEyebrow = !string.IsNullOrWhiteSpace(activeDesign.HeroEyebrow)
        ? activeDesign.HeroEyebrow
        : "Nova Coleção Disponível";
    var previewHeadline = !string.IsNullOrWhiteSpace(activeDesign.HeroHeadline)
        ? activeDesign.HeroHeadline
        : _store.StoreName;
}
<div class="lux-preview-frame">
    <header class="lux-preview-header">
        <div style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;" @onclick="GoToCatalogHome">
            @if (!string.IsNullOrWhiteSpace(_store.LogoPublicUrl))
            {
                <img src="@_store.LogoPublicUrl" alt="@_store.StoreName" style="height: 42px; max-width: 150px; object-fit: contain;" />
            }
            <span style="font-family: var(--brand-font-display); font-size: 1.3rem; font-weight: 700; letter-spacing: -0.015em; color: var(--brand-text);">
                @_store.StoreName
            </span>
        </div>

        <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <button type="button"
                    style="background:none;border:none;font-weight:600;font-size:0.92rem;cursor:pointer;color:var(--brand-text);"
                    @onclick="GoToCatalogHome">
                Início &amp; Roupas
            </button>
            <button type="button"
                    class="adm-btn adm-btn-success"
                    style="background: #16A34A; color: #FFFFFF;"
                    @onclick="() => OpenWhatsAppLinkAsync(WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName))">
                💬 WhatsApp da Loja
            </button>
        </div>
    </header>

    @if (!_store.IsSiteActive)
    {
        <section style="padding: 3rem 1.75rem; text-align: center; max-width: 620px; margin: 0 auto;">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🛍️</div>
            <h1 style="font-family: var(--brand-font-display); font-size: 2rem; margin: 0 0 0.75rem; color: var(--brand-text);">
                @_store.StoreName está em atualização
            </h1>
            <p style="color: var(--brand-text-muted); font-size: 0.98rem; line-height: 1.6; margin-bottom: 1.5rem;">
                @(_store.DeactivationReason ?? "Estamos preparando novas peças para você! Fale com nossa equipe no WhatsApp.")
            </p>
            @if (!string.IsNullOrWhiteSpace(_store.WhatsappNumber))
            {
                <button type="button"
                        class="adm-btn adm-btn-success"
                        style="background: #16A34A; color: #FFFFFF; padding: 0.85rem 1.5rem;"
                        @onclick="() => OpenWhatsAppLinkAsync(WhatsAppLinkBuilder.BuildGeneralStoreLink(_store.WhatsappNumber, _store.StoreName))">
                    💬 Falar com a Loja no WhatsApp
                </button>
            }
        </section>
    }
    else if (string.IsNullOrWhiteSpace(Slug))
    {
        <!-- Hero de Apresentação da Loja -->
        <section class="lux-preview-hero @previewHeroModifier">
            <div style="max-width: 760px; @(activeDesign.HeroLayout == "centered" ? "margin: 0 auto;" : "")">
                @if (activeDesign.ShowLookbookBadge)
                {
                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: var(--brand-accent);">
                        @previewEyebrow
                    </span>
                }
                <h1 style="font-family: var(--brand-font-display); font-size: clamp(1.85rem, 3.6vw, 2.75rem); font-weight: 500; margin: 0.45rem 0 0.75rem; letter-spacing: -0.02em;">
                    @previewHeadline
                </h1>
                <p style="font-size: 0.98rem; color: @(activeDesign.HeroLayout == "banner" ? "#D6D0C4" : "var(--brand-text-muted)"); margin: 0 0 1.25rem; line-height: 1.6;">
                    @_store.StoreDescription
                </p>
            </div>

            <!-- Filtros do Catálogo (Busca, Categoria, Tamanho, Cor) -->
            <div style="background: var(--brand-surface); color: var(--brand-text); border: 1px solid var(--brand-border); border-radius: var(--brand-radius-card); padding: 1.1rem; margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(175px, 1fr)); gap: 0.85rem; align-items: end; text-align: left;">
                <div>
                    <label class="adm-label">Pesquisar produto</label>
                    <input type="text"
                           class="adm-input"
                           placeholder="Ex.: Camiseta, Linho, Vestido..."
                           @bind="_search"
                           @bind:event="oninput"
                           @bind:after="ApplyFiltersAsync" />
                </div>

                <div>
                    <label class="adm-label">Categoria</label>
                    <select class="adm-select" @bind="_selectedCategorySlug" @bind:after="ApplyFiltersAsync">
                        <option value="">Todas as categorias</option>
                        @foreach (var cat in _filters.Categories)
                        {
                            <option value="@cat.Slug">@cat.Name (@cat.ProductCount)</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="adm-label">Tamanho</label>
                    <select class="adm-select" @bind="_selectedSize" @bind:after="ApplyFiltersAsync">
                        <option value="">Todos os tamanhos</option>
                        @foreach (var size in _filters.Sizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="adm-label">Cor</label>
                    <select class="adm-select" @bind="_selectedColor" @bind:after="ApplyFiltersAsync">
                        <option value="">Todas as cores</option>
                        @foreach (var color in _filters.Colors)
                        {
                            <option value="@color.Color">@color.Color</option>
                        }
                    </select>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
                    <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; cursor: pointer;">
                        <input type="checkbox" @bind="_onlyInStock" @bind:after="ApplyFiltersAsync" />
                        <span>Em estoque</span>
                    </label>
                    <button type="button" class="adm-btn adm-btn-outline" @onclick="ClearFiltersAsync">Limpar</button>
                </div>
            </div>
        </section>

        <!-- Grade de Produtos do Catálogo -->
        <section style="padding: 1.75rem;">
            @if (_filters.Categories.Count > 0)
            {
                <div class="adm-pill-chips" style="margin-bottom: 1.15rem;">
                    <button type="button"
                            class="adm-chip-filter @(string.IsNullOrWhiteSpace(_selectedCategorySlug) ? "active" : "")"
                            @onclick="() => QuickFilterCategoryAsync(null)">
                        Todas as peças
                    </button>
                    @foreach (var cat in _filters.Categories)
                    {
                        var activeCat = string.Equals(_selectedCategorySlug, cat.Slug, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="adm-chip-filter @(activeCat ? "active" : "")"
                                @onclick="() => QuickFilterCategoryAsync(cat.Slug)">
                            @cat.Name (@cat.ProductCount)
                        </button>
                    }
                </div>
            }

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.3rem; font-weight: 700; margin: 0; font-family: var(--brand-font-display);">Roupas Disponíveis (@_products.Count)</h2>
            </div>

            <div class="lux-preview-grid">
                @foreach (var prod in _products)
                {
                    <article class="lux-preview-card">
                        <div class="lux-preview-card-img" style="cursor: pointer;"
                             @onclick="() => OpenProductDetail(prod.Slug)">
                            @if (!string.IsNullOrWhiteSpace(prod.PrimaryImageUrl))
                            {
                                <img src="@prod.PrimaryImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--brand-text-muted);">Sem foto</div>
                            }

                            @if (!prod.HasAvailableStock)
                            {
                                <span style="position: absolute; top: 0.65rem; left: 0.65rem; background: rgba(24,24,27,0.88); color: #FFFFFF; font-size: 0.7rem; font-weight: 700; padding: 0.22rem 0.6rem; border-radius: 999px;">
                                    Esgotado
                                </span>
                            }
                            else if (prod.TotalStockQuantity <= 3)
                            {
                                <span style="position: absolute; top: 0.65rem; left: 0.65rem; background: rgba(182,145,88,0.94); color: #FFFFFF; font-size: 0.7rem; font-weight: 700; padding: 0.22rem 0.6rem; border-radius: 999px;">
                                    Últimas peças
                                </span>
                            }
                            else
                            {
                                <span style="position: absolute; top: 0.65rem; left: 0.65rem; background: rgba(22,163,74,0.92); color: #FFFFFF; font-size: 0.7rem; font-weight: 700; padding: 0.22rem 0.6rem; border-radius: 999px;">
                                    Disponível
                                </span>
                            }
                        </div>

                        <div class="lux-preview-card-body">
                            <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand-accent);">
                                @prod.CategoryName
                            </span>
                            <div style="font-family: var(--brand-font-display); font-size: 1.08rem; font-weight: 600; cursor: pointer; color: var(--brand-text);" @onclick="() => OpenProductDetail(prod.Slug)">
                                @prod.Name
                            </div>
                            <div style="font-size: 1.06rem; font-weight: 700; color: var(--brand-text);">
                                @prod.BasePrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--brand-border);">
                                <div style="display: flex; gap: 0.3rem;">
                                    @foreach (var c in prod.AvailableColors)
                                    {
                                        <span style="width: 13px; height: 13px; border-radius: 50%; background: @c.ColorHex; border: 1px solid rgba(120,113,108,0.35);" title="@c.Color"></span>
                                    }
                                </div>
                                <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                                    @foreach (var s in prod.AvailableSizes)
                                    {
                                        <span style="font-size: 0.72rem; font-weight: 600; background: var(--brand-surface-subtle); color: var(--brand-text); padding: 0.12rem 0.42rem; border-radius: 4px;">@s</span>
                                    }
                                </div>
                            </div>

                            <button type="button"
                                    class="adm-btn adm-btn-primary"
                                    style="width: 100%; margin-top: 0.65rem;"
                                    @onclick="() => OpenProductDetail(prod.Slug)">
                                Ver Fotos &amp; Escolher Tamanho
                            </button>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
    else if (_selectedProduct is not null)
    {
        <!-- Página Individual do Produto -->
        <section style="padding: 1.75rem;">
            <button type="button"
                    class="adm-btn adm-btn-outline"
                    style="margin-bottom: 1.25rem;"
                    @onclick="GoToCatalogHome">
                &larr; Voltar para o Catálogo (@_store.StoreName)
            </button>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1.5rem; align-items: start;">
                <!-- Galeria de Fotografias -->
                <div>
                    <div style="aspect-ratio: 4 / 5; background: var(--brand-surface-subtle); border-radius: var(--brand-radius-card); overflow: hidden; border: 1px solid var(--brand-border); margin-bottom: 0.75rem;">
                        @if (!string.IsNullOrWhiteSpace(_activeImageUrl))
                        {
                            <img src="@_activeImageUrl" alt="@_selectedProduct.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                    </div>

                    @if (_selectedProduct.Images.Count > 1)
                    {
                        <div style="display: flex; gap: 0.6rem; overflow-x: auto;">
                            @foreach (var img in _selectedProduct.Images)
                            {
                                <img src="@img.PublicUrl"
                                     alt="@_selectedProduct.Name"
                                     style="width: 72px; height: 90px; object-fit: cover; border-radius: var(--brand-radius-btn); cursor: pointer; border: 2px solid @(_activeImageUrl == img.PublicUrl ? "var(--brand-accent)" : "transparent");"
                                     @onclick="() => _activeImageUrl = img.PublicUrl" />
                            }
                        </div>
                    }
                </div>

                <!-- Seleção de Cor, Tamanho e Botão Consultar pelo WhatsApp -->
                <div style="background: var(--brand-surface); border: 1px solid var(--brand-border); border-radius: var(--brand-radius-card); padding: 1.75rem;">
                    <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand-accent);">
                        @_selectedProduct.CategoryName
                    </span>
                    <h1 style="font-family: var(--brand-font-display); font-size: 1.85rem; font-weight: 600; margin: 0.35rem 0 0.5rem; color: var(--brand-text);">@_selectedProduct.Name</h1>
                    <div style="font-family: var(--brand-font-display); font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem; color: var(--brand-text);">
                        @_selectedProduct.BasePrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                    </div>

                    <p style="color: var(--brand-text-muted); font-size: 0.95rem; margin-bottom: 1.35rem; line-height: 1.6;">
                        @_selectedProduct.Description
                    </p>

                    @if (_selectedProduct.Variants.Count > 0)
                    {
                        <!-- 1. Cor -->
                        <div style="margin-bottom: 1.25rem;">
                            <label class="adm-label">1. Selecione a Cor: <strong>@_detailColor</strong></label>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                @foreach (var c in _selectedProduct.Variants.GroupBy(v => v.Color, StringComparer.OrdinalIgnoreCase))
                                {
                                    var isCurrent = string.Equals(_detailColor, c.Key, StringComparison.OrdinalIgnoreCase);
                                    <button type="button"
                                            class="adm-btn @(isCurrent ? "adm-btn-primary" : "adm-btn-outline")"
                                            @onclick="() => SelectDetailColor(c.Key)">
                                        <span style="width: 12px; height: 12px; border-radius: 50%; background: @c.First().ColorHex; border: 1px solid rgba(0,0,0,0.2);"></span>
                                        <span>@c.Key</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- 2. Tamanho -->
                        <div style="margin-bottom: 1.35rem;">
                            <label class="adm-label">2. Selecione o Tamanho: <strong>@_detailSize</strong></label>
                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                @foreach (var v in _selectedProduct.Variants.Where(v => string.Equals(v.Color, _detailColor, StringComparison.OrdinalIgnoreCase)))
                                {
                                    var isCurrent = string.Equals(_detailSize, v.Size, StringComparison.OrdinalIgnoreCase);
                                    <button type="button"
                                            class="adm-btn @(isCurrent ? "adm-btn-primary" : "adm-btn-outline")"
                                            @onclick="() => _detailSize = v.Size">
                                        <span>@v.Size</span>
                                        <span style="font-size: 0.75rem; opacity: 0.85;">
                                            (@(v.StockQuantity > 3 ? "Disponível" : v.StockQuantity > 0 ? "Últimas" : "Esgotado"))
                                        </span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="padding: 0.85rem; background: var(--brand-surface-subtle); border: 1px solid var(--brand-border); border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.88rem; color: var(--brand-text-muted);">
                            Consulte cores e tamanhos diretamente pelo nosso WhatsApp abaixo.
                        </div>
                    }

                    <!-- Botão Oficial Consultar pelo WhatsApp -->
                    <button type="button"
                            class="adm-btn adm-btn-success"
                            style="width: 100%; padding: 0.95rem; font-size: 1.02rem; background: #16A34A; color: #FFFFFF;"
                            @onclick="ConsultProductOnWhatsAppAsync">
                        💬 Pedir esta Peça no WhatsApp
                    </button>

                    <div style="background: var(--brand-surface-subtle); border: 1px solid var(--brand-border); border-radius: 8px; padding: 0.9rem; margin-top: 1rem; font-size: 0.85rem; color: var(--brand-text);">
                        <div style="font-weight: 700; margin-bottom: 0.25rem; color: var(--brand-accent);">
                            Mensagem pronta para a loja:
                        </div>
                        <div style="color: var(--brand-text-muted);">
                            "@WhatsAppLinkBuilder.BuildProductConsultationMessage(_selectedProduct.Name, _detailColor, _detailSize)"
                        </div>
                    </div>

                    @if (_store.DirectPixSalesReady)
                    {
                        var selectedVariant = SelectedDetailVariant;
                        <div style="margin-top: 1.25rem; border: 1.5px solid #16A34A; background: var(--brand-bg); border-radius: 12px; padding: 1.15rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.45rem;">
                                <strong style="font-size: 1rem;">💸 Comprar Direto pelo App (Apenas Pix)</strong>
                                <span class="pill-badge pill-green">Exclusivo Pix</span>
                            </div>
                            <p style="font-size: 0.82rem; color: var(--brand-text-muted); margin: 0 0 0.85rem; line-height: 1.45;">
                                Alcance configurado pelo vendedor: <strong>@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.Describe(_store.DeliveryScopeMode, _store.MaxDeliveryDistanceKm, _store.OriginCity, _store.OriginState)</strong>.
                            </p>

                            @if (_createdPixOrder is null)
                            {
                                @if (!string.IsNullOrWhiteSpace(_checkoutError))
                                {
                                    <div class="adm-alert adm-alert-error" style="margin-bottom: 0.75rem;">@_checkoutError</div>
                                }

                                @if (selectedVariant is null || selectedVariant.StockQuantity <= 0)
                                {
                                    <div style="font-size: 0.84rem; color: var(--adm-danger); font-weight: 700;">
                                        Escolha uma cor e tamanho com estoque disponível para comprar via Pix.
                                    </div>
                                }
                                else
                                {
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; margin-bottom: 0.65rem;">
                                        <div>
                                            <label class="adm-label">CEP de Entrega *</label>
                                            <div style="display: flex; gap: 0.35rem;">
                                                <input type="text" class="adm-input" @bind="_buyerCep" placeholder="01310-100" />
                                                <button type="button" class="adm-btn adm-btn-outline" style="white-space: nowrap;"
                                                        disabled="@_calculatingShipping" @onclick="CheckShippingQuoteAsync">
                                                    @(_calculatingShipping ? "..." : "Calcular")
                                                </button>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="adm-label">Quantidade (máx @selectedVariant.StockQuantity)</label>
                                            <input type="number" min="1" max="@selectedVariant.StockQuantity" class="adm-input" @bind="_orderQuantity" />
                                        </div>
                                    </div>

                                    @if (_shippingQuote is not null)
                                    {
                                        <div style="padding: 0.65rem 0.8rem; border-radius: 8px; font-size: 0.82rem; margin-bottom: 0.75rem; @(_shippingQuote.Eligibility.IsAllowed ? "background: rgba(22,163,74,0.12); border: 1px solid #16A34A;" : "background: rgba(239,68,68,0.12); border: 1px solid #EF4444;")">
                                            <div><strong>@(_shippingQuote.Eligibility.IsAllowed ? "✓ Endereço atendido:" : "✕ Fora do limite de distância:")</strong> @_shippingQuote.Eligibility.ReasonMessage</div>
                                            @if (_shippingQuote.Eligibility.IsAllowed && _shippingQuote.CorreiosQuote is not null)
                                            {
                                                <div style="margin-top: 0.25rem; font-size: 0.78rem;">
                                                    Correios estimado para referência do envio:
                                                    <strong>PAC ~@_shippingQuote.CorreiosQuote.PacPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong> (@_shippingQuote.CorreiosQuote.PacDaysMin–@_shippingQuote.CorreiosQuote.PacDaysMax dias úteis) |
                                                    <strong>SEDEX ~@_shippingQuote.CorreiosQuote.SedexPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong> (@_shippingQuote.CorreiosQuote.SedexDaysMin–@_shippingQuote.CorreiosQuote.SedexDaysMax dias úteis).
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.55rem; margin-bottom: 0.65rem;">
                                        <input type="text" class="adm-input" @bind="_buyerName" placeholder="Seu Nome Completo *" />
                                        <input type="text" class="adm-input" @bind="_buyerWhatsapp" placeholder="Seu WhatsApp (DDD + Número) *" />
                                        <input type="text" class="adm-input" @bind="_buyerStreet" placeholder="Rua / Logradouro *" />
                                        <input type="text" class="adm-input" @bind="_buyerNumber" placeholder="Número *" />
                                        <input type="text" class="adm-input" @bind="_buyerComplement" placeholder="Complemento" />
                                        <input type="text" class="adm-input" @bind="_buyerNeighborhood" placeholder="Bairro *" />
                                        <input type="text" class="adm-input" @bind="_buyerCity" placeholder="Cidade *" />
                                        <input type="text" maxlength="2" class="adm-input" style="text-transform: uppercase;" @bind="_buyerState" placeholder="UF *" />
                                    </div>

                                    <input type="text" class="adm-input" style="margin-bottom: 0.75rem;" @bind="_buyerNotes" placeholder="Observações para o envio (opcional)" />

                                    <button type="button"
                                            class="adm-btn adm-btn-success"
                                            style="width: 100%; background: #16A34A; color: #FFFFFF; padding: 0.9rem; font-weight: 800;"
                                            disabled="@(_submittingOrder || (_shippingQuote is not null && !_shippingQuote.Eligibility.IsAllowed))"
                                            @onclick="SubmitPixOrderAsync">
                                        @(_submittingOrder
                                            ? "Gerando pedido Pix..."
                                            : $"💸 Finalizar Pedido no Pix ({((_selectedProduct.BasePrice * Math.Max(1, _orderQuantity))).ToString("C", new System.Globalization.CultureInfo("pt-BR"))})")
                                    </button>
                                }
                            }
                            else
                            {
                                <div style="background: rgba(22,163,74,0.12); border: 1px solid #16A34A; border-radius: 10px; padding: 0.9rem;">
                                    <div style="font-weight: 800; color: #166534; font-size: 1rem;">
                                        ✅ Pedido @_createdPixOrder.OrderNumber gerado!
                                    </div>
                                    <p style="font-size: 0.82rem; margin: 0.35rem 0 0.65rem; line-height: 1.45;">
                                        Pague apenas via <strong>Pix</strong> usando a chave ou o código Copia e Cola abaixo. O vendedor recebeu seu endereço em <strong>@_createdPixOrder.DeliveryCity/@_createdPixOrder.DeliveryState</strong> (~@_createdPixOrder.DistanceKmFromSeller.ToString("0.#") km) e organizará a entrega!
                                    </p>
                                    <div style="font-size: 0.8rem; margin-bottom: 0.35rem;">
                                        <strong>Chave Pix do Vendedor:</strong> <code>@_createdPixOrder.PixKey</code>
                                    </div>
                                    <div style="font-size: 0.8rem; font-weight: 700; margin-bottom: 0.25rem;">
                                        Código Pix Copia e Cola (@_createdPixOrder.TotalPixAmount.ToString("C", new System.Globalization.CultureInfo("pt-BR"))):
                                    </div>
                                    <textarea readonly rows="3" class="adm-input" style="font-family: monospace; font-size: 0.75rem; margin-bottom: 0.55rem;">@_createdPixOrder.PixBrCode</textarea>
                                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                        <button type="button" class="adm-btn adm-btn-primary" @onclick="CopyPixBrCodeAsync">
                                            @(_copiedPixCode ? "✓ Código Pix Copiado!" : "📋 Copiar Código Pix")
                                        </button>
                                        <button type="button" class="adm-btn adm-btn-success" @onclick="OpenOrderProofWhatsAppAsync">
                                            💬 Enviar Comprovante no WhatsApp
                                        </button>
                                        <button type="button" class="adm-btn adm-btn-outline" @onclick="() => _createdPixOrder = null">
                                            Novo Pedido
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public string? StoreSlug { get; set; }

    [Parameter]
    public string? Slug { get; set; }

    private PublicStoreSettingsDto _store = new("Minha Loja", "minha-loja", "5511900000000", "", null, DateTimeOffset.UtcNow);
    private CatalogFiltersDto _filters = new([], [], []);
    private IReadOnlyList<CatalogProductCardDto> _products = [];
    private ProductDetailDto? _selectedProduct;

    private string? _search;
    private string? _selectedCategorySlug;
    private string? _selectedColor;
    private string? _selectedSize;
    private bool _onlyInStock;

    private string? _activeImageUrl;
    private string? _detailColor;
    private string? _detailSize;
    private bool _copied;

    protected override async Task OnParametersSetAsync()
    {
        _store = await CatalogService.GetPublicStoreSettingsAsync();
        BrandState.ApplyFromPublicSettings(_store);
        _filters = await CatalogService.GetCatalogFiltersAsync();

        if (!string.IsNullOrWhiteSpace(Slug))
        {
            _selectedProduct = await CatalogService.GetPublicProductDetailAsync(Slug);
            if (_selectedProduct is not null)
            {
                _activeImageUrl = _selectedProduct.Images.FirstOrDefault()?.PublicUrl;
                var firstVar = _selectedProduct.Variants.FirstOrDefault(v => v.StockQuantity > 0)
                    ?? _selectedProduct.Variants.FirstOrDefault();
                _detailColor = firstVar?.Color;
                _detailSize = firstVar?.Size;
            }
        }
        else
        {
            _selectedProduct = null;
            await ApplyFiltersAsync();
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _products = await CatalogService.GetCatalogProductsAsync(new CatalogQueryFilter(
            Search: _search,
            CategorySlug: _selectedCategorySlug,
            Color: _selectedColor,
            Size: _selectedSize,
            OnlyInStock: _onlyInStock));
    }

    private Task QuickFilterCategoryAsync(string? categorySlug)
    {
        _selectedCategorySlug = categorySlug;
        return ApplyFiltersAsync();
    }

    private async Task TogglePublicVisibilityAsync()
    {
        try
        {
            if (_store.IsSiteActive)
            {
                await Gateway.DeactivateSiteAsync("Site ocultado pelo administrador.");
            }
            else
            {
                await Gateway.ActivateSiteAsync();
            }

            _store = await CatalogService.GetPublicStoreSettingsAsync();
            BrandState.ApplyFromPublicSettings(_store);
        }
        catch
        {
        }
    }

    private async Task ClearFiltersAsync()
    {
        _search = null;
        _selectedCategorySlug = null;
        _selectedColor = null;
        _selectedSize = null;
        _onlyInStock = false;
        await ApplyFiltersAsync();
    }

    private void OpenProductDetail(string productSlug) =>
        Navigation.NavigateTo($"/loja/{_store.StoreSlug}/produto/{productSlug}");

    private void GoToCatalogHome() =>
        Navigation.NavigateTo($"/loja/{_store.StoreSlug}");

    private void SelectDetailColor(string color)
    {
        _detailColor = color;
        if (_selectedProduct is not null)
        {
            var match = _selectedProduct.Variants
                .Where(v => string.Equals(v.Color, color, StringComparison.OrdinalIgnoreCase))
                .FirstOrDefault();
            _detailSize = match?.Size;
        }
    }

    private async Task ConsultProductOnWhatsAppAsync()
    {
        if (_selectedProduct is null)
            return;

        var url = WhatsAppLinkBuilder.BuildProductConsultationLink(
            _store.WhatsappNumber,
            _selectedProduct.Name,
            _detailColor,
            _detailSize);

        await OpenWhatsAppLinkAsync(url);
    }

    private async Task CopyLinkAsync(string url)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(url);
            _copied = true;
        }
        catch
        {
        }
    }

    private static async Task OpenWhatsAppLinkAsync(string url)
    {
        try
        {
            await Launcher.Default.OpenAsync(new Uri(url));
        }
        catch
        {
        }
    }

    private async Task OpenExternalWebsiteAsync(string url)
    {
        try
        {
            LocalWebServerLauncher.Initialize(CatalogService, OrderService);
            await LocalWebServerLauncher.OpenCatalogInBrowserAsync(url);
        }
        catch
        {
        }
    }

    private ProductVariantDto? SelectedDetailVariant =>
        _selectedProduct?.Variants.FirstOrDefault(v =>
            (string.IsNullOrWhiteSpace(_detailColor) || string.Equals(v.Color, _detailColor, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(_detailSize) || string.Equals(v.Size, _detailSize, StringComparison.OrdinalIgnoreCase)));

    private string _buyerCep = string.Empty;
    private int _orderQuantity = 1;
    private string _buyerName = string.Empty;
    private string _buyerWhatsapp = string.Empty;
    private string _buyerStreet = string.Empty;
    private string _buyerNumber = string.Empty;
    private string _buyerComplement = string.Empty;
    private string _buyerNeighborhood = string.Empty;
    private string _buyerCity = string.Empty;
    private string _buyerState = string.Empty;
    private string _buyerNotes = string.Empty;
    private bool _calculatingShipping;
    private bool _submittingOrder;
    private bool _copiedPixCode;
    private string? _checkoutError;
    private ShippingQuoteResponse? _shippingQuote;
    private StoreOrderDto? _createdPixOrder;

    private async Task CheckShippingQuoteAsync()
    {
        _checkoutError = null;
        _calculatingShipping = true;
        try
        {
            var lookup = await OrderService.LookupCepAsync(_buyerCep);
            _buyerCep = lookup.Cep;
            if (string.IsNullOrWhiteSpace(_buyerStreet) && !string.IsNullOrWhiteSpace(lookup.Street))
                _buyerStreet = lookup.Street;
            if (string.IsNullOrWhiteSpace(_buyerNeighborhood) && !string.IsNullOrWhiteSpace(lookup.Neighborhood))
                _buyerNeighborhood = lookup.Neighborhood;
            if (!string.IsNullOrWhiteSpace(lookup.City))
                _buyerCity = lookup.City;
            if (!string.IsNullOrWhiteSpace(lookup.State))
                _buyerState = lookup.State;

            _shippingQuote = await OrderService.QuoteShippingForBuyerAsync(new ShippingQuoteRequest
            {
                DestinationCep = _buyerCep,
                DestinationCity = _buyerCity,
                DestinationState = _buyerState,
                WeightGrams = _store.DefaultPackageWeightGrams * Math.Max(1, _orderQuantity)
            });
        }
        catch (Exception ex)
        {
            _checkoutError = ex.Message;
        }
        finally
        {
            _calculatingShipping = false;
        }
    }

    private async Task SubmitPixOrderAsync()
    {
        var selectedVariant = SelectedDetailVariant;
        if (_selectedProduct is null || selectedVariant is null)
            return;

        _checkoutError = null;
        _copiedPixCode = false;
        _submittingOrder = true;
        try
        {
            _createdPixOrder = await OrderService.PlacePixOrderAsync(new CreatePixOrderRequest
            {
                ProductId = _selectedProduct.Id,
                ProductVariantId = selectedVariant.Id,
                Quantity = Math.Max(1, _orderQuantity),
                CustomerName = _buyerName,
                CustomerWhatsapp = _buyerWhatsapp,
                Cep = _buyerCep,
                Street = _buyerStreet,
                Number = _buyerNumber,
                Complement = _buyerComplement,
                Neighborhood = _buyerNeighborhood,
                City = _buyerCity,
                State = _buyerState,
                CustomerNotes = _buyerNotes
            });
        }
        catch (Exception ex)
        {
            _checkoutError = ex.Message;
        }
        finally
        {
            _submittingOrder = false;
        }
    }

    private async Task CopyPixBrCodeAsync()
    {
        if (_createdPixOrder is null)
            return;

        try
        {
            await Clipboard.Default.SetTextAsync(_createdPixOrder.PixBrCode);
            _copiedPixCode = true;
        }
        catch
        {
        }
    }

    private async Task OpenOrderProofWhatsAppAsync()
    {
        if (_createdPixOrder is null)
            return;

        var msg = $"Olá! Acabei de gerar o pedido Pix {_createdPixOrder.OrderNumber} no valor de R$ {_createdPixOrder.TotalPixAmount:N2} ({_selectedProduct?.Name}). Endereço de entrega: {_createdPixOrder.FormattedDeliveryAddress}. Segue comprovante do Pix!";
        var url = $"https://wa.me/{_store.WhatsappNumber}?text={Uri.EscapeDataString(msg)}";
        await OpenWhatsAppLinkAsync(url);
    }
}
