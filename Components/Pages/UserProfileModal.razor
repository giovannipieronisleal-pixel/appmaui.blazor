@using ClothingStore.Application.Services
@using ClothingStore.Domain.Common
@inject MauiAdminGateway Gateway

@if (IsOpen)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.72); display: flex; align-items: center; justify-content: center; z-index: 9999; padding: 1rem; backdrop-filter: blur(4px);">
        <div class="adm-card" style="width: 100%; max-width: 620px; max-height: 90vh; overflow-y: auto; padding: 1.75rem; box-shadow: 0 25px 60px rgba(0,0,0,0.5); border: 2px solid var(--adm-border); border-radius: 16px;">
            <!-- Header do Modal -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
                <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--adm-accent); color: #fff; font-size: 1.25rem; font-weight: 800; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
                        @GetInitials(Gateway.CurrentEmployee?.FullName)
                    </div>
                    <div>
                        <h2 style="font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--adm-text);">
                            @(Gateway.CurrentEmployee?.FullName ?? "Meu Perfil")
                        </h2>
                        <div style="display: flex; align-items: center; gap: 0.45rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--adm-muted);">
                            <span>@(Gateway.CurrentEmployee?.Email)</span>
                            <span>&bull;</span>
                            <span class="pill-badge @(Gateway.IsAdmin ? "pill-green" : "pill-slate")" style="font-size: 0.72rem; padding: 0.1rem 0.4rem;">
                                @(Gateway.IsAdmin ? "Administrador" : "Equipe")
                            </span>
                        </div>
                    </div>
                </div>

                <button type="button"
                        style="background: none; border: none; font-size: 1.4rem; cursor: pointer; color: var(--adm-muted); padding: 0.25rem;"
                        @onclick="Close">
                    ✕
                </button>
            </div>

            <!-- Abas de Navegação -->
            <div style="display: flex; gap: 0.35rem; background: var(--adm-input-bg); border-radius: 10px; padding: 4px; margin-bottom: 1.25rem; border: 1px solid var(--adm-border); overflow-x: auto;">
                <button type="button"
                        class="adm-btn @(_currentTab == "profile" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1; border: none; padding: 0.5rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("profile")'>
                    👤 Meus Dados
                </button>
                <button type="button"
                        class="adm-btn @(_currentTab == "password" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1; border: none; padding: 0.5rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("password")'>
                    🔑 Senha
                </button>
                <button type="button"
                        class="adm-btn @(_currentTab == "pin" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1; border: none; padding: 0.5rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("pin")'>
                    🔢 PIN (4 Dígitos)
                </button>
                <button type="button"
                        class="adm-btn @(_currentTab == "2fa" ? "adm-btn-primary" : "adm-btn-outline")"
                        style="flex: 1; border: none; padding: 0.5rem 0.65rem; font-size: 0.82rem; font-weight: 700; white-space: nowrap;"
                        @onclick='() => SetTab("2fa")'>
                    🛡️ 2FA (Dois Fatores)
                </button>
            </div>

            <!-- Alertas -->
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert-banner alert-error" style="margin-bottom: 1rem;">@_error</div>
            }

            @if (!string.IsNullOrWhiteSpace(_success))
            {
                <div class="alert-banner alert-success" style="margin-bottom: 1rem;">@_success</div>
            }

            <!-- ========================================== -->
            <!-- ABA 1: MEUS DADOS                          -->
            <!-- ========================================== -->
            @if (_currentTab == "profile")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label class="adm-label">Nome Completo *</label>
                        <input type="text" class="adm-input" @bind="_profileFullName" />
                    </div>

                    <div>
                        <label class="adm-label">E-mail / Login de Acesso *</label>
                        <input type="email" class="adm-input" @bind="_profileEmail" />
                    </div>

                    <div>
                        <label class="adm-label">Telefone / WhatsApp</label>
                        <input type="text" class="adm-input" @bind="_profilePhone" placeholder="Ex.: 21975219710" />
                    </div>

                    <div>
                        <label class="adm-label">Cargo / Nível de Acesso</label>
                        <input type="text" class="adm-input" value="@(Gateway.CurrentEmployee?.JobTitle ?? "Administrador")" disabled style="opacity: 0.75;" />
                    </div>

                    <button type="button"
                            class="adm-btn adm-btn-primary"
                            style="padding: 0.8rem; font-weight: 700; margin-top: 0.25rem;"
                            disabled="@_isBusy"
                            @onclick="SaveProfileAsync">
                        @(_isBusy ? "Salvando..." : "💾 Salvar Alterações de Perfil")
                    </button>
                </div>
            }

            <!-- ========================================== -->
            <!-- ABA 2: ALTERAR SENHA                       -->
            <!-- ========================================== -->
            else if (_currentTab == "password")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div>
                        <label class="adm-label">Senha Atual *</label>
                        <input type="password" class="adm-input" @bind="_pwdCurrent" placeholder="Digite sua senha atual" />
                    </div>

                    <div>
                        <label class="adm-label">Nova Senha (mínimo 4 caracteres) *</label>
                        <input type="password" class="adm-input" @bind="_pwdNew" placeholder="Digite a nova senha" />
                    </div>

                    <div>
                        <label class="adm-label">Confirmar Nova Senha *</label>
                        <input type="password" class="adm-input" @bind="_pwdConfirm" placeholder="Repita a nova senha" />
                    </div>

                    <button type="button"
                            class="adm-btn adm-btn-primary"
                            style="padding: 0.8rem; font-weight: 700; margin-top: 0.25rem;"
                            disabled="@_isBusy"
                            @onclick="ChangePasswordAsync">
                        @(_isBusy ? "Atualizando..." : "🔑 Atualizar Senha de Acesso")
                    </button>
                </div>
            }

            <!-- ========================================== -->
            <!-- ABA 3: PIN DE SEGURANÇA (4 DÍGITOS)        -->
            <!-- ========================================== -->
            else if (_currentTab == "pin")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <strong style="color: var(--adm-text);">PIN de Segurança de 4 Dígitos</strong>
                            <span class="pill-badge @(Gateway.CurrentEmployee?.HasSecurityPin == true ? "pill-green" : "pill-slate")">
                                @(Gateway.CurrentEmployee?.HasSecurityPin == true ? "🟢 PIN Ativo" : "⚪ Sem PIN")
                            </span>
                        </div>
                        <p style="font-size: 0.82rem; color: var(--adm-muted); margin: 0; line-height: 1.45;">
                            O PIN numérico facilita autorizações rápidas no aplicativo sem precisar digitar senhas longas a todo momento.
                        </p>
                    </div>

                    <div>
                        <label class="adm-label">Senha Atual da Conta (para confirmar identidade) *</label>
                        <input type="password" class="adm-input" @bind="_pinCurrentPassword" placeholder="Sua senha de login" />
                    </div>

                    <div>
                        <label class="adm-label">Novo PIN Numérico (4 Dígitos) *</label>
                        <input type="password"
                               class="adm-input"
                               maxlength="4"
                               style="font-size: 1.4rem; text-align: center; letter-spacing: 0.4em; font-family: monospace;"
                               @bind="_pinCode"
                               placeholder="••••" />
                    </div>

                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button type="button"
                                class="adm-btn adm-btn-primary"
                                style="flex: 1; padding: 0.8rem; font-weight: 700;"
                                disabled="@_isBusy"
                                @onclick="SavePinAsync">
                            @(_isBusy ? "Salvando..." : "🔢 Salvar / Atualizar PIN")
                        </button>

                        @if (Gateway.CurrentEmployee?.HasSecurityPin == true)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-danger"
                                    style="padding: 0.8rem;"
                                    disabled="@_isBusy"
                                    @onclick="RemovePinAsync">
                                Remover PIN
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- ========================================== -->
            <!-- ABA 4: AUTENTICAÇÃO EM 2 FATORES (2FA)     -->
            <!-- ========================================== -->
            else if (_currentTab == "2fa")
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    <!-- Card de Status do 2FA -->
                    <div style="background: var(--adm-input-bg); border: 1.5px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                            <strong style="font-size: 1rem; color: var(--adm-text);">Verificação em Duas Etapas (2FA)</strong>
                            <span class="pill-badge @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "pill-green" : "pill-slate")">
                                @(Gateway.CurrentEmployee?.HasTwoFactorEnabled == true ? "🟢 Ativado (Protegido)" : "⚪ Desativado")
                            </span>
                        </div>
                        <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0; line-height: 1.45;">
                            Compatível com <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong> e <strong>Authy</strong>.
                            Ao ativar, você precisará de um código dinâmico a cada login, impedindo invasões mesmo que descubram sua senha.
                        </p>
                    </div>

                    @if (Gateway.CurrentEmployee?.HasTwoFactorEnabled == true)
                    {
                        <!-- CONTA JÁ PROTEGIDA -->
                        <div style="padding: 1.25rem; background: rgba(34, 197, 94, 0.08); border: 1px solid var(--adm-success); border-radius: 10px; text-align: center;">
                            <div style="font-size: 2.2rem; margin-bottom: 0.35rem;">🛡️</div>
                            <strong style="color: var(--adm-success); font-size: 1rem; display: block;">Sua conta está 100% protegida com 2FA!</strong>
                            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.35rem 0 0;">
                                O login no sistema exige senha + código temporário de 6 dígitos.
                            </p>
                        </div>

                        <!-- Opção para desativar -->
                        <div style="border-top: 1px solid var(--adm-border); padding-top: 1rem; margin-top: 0.5rem;">
                            <label class="adm-label">Para desativar o 2FA, digite sua senha atual:</label>
                            <input type="password" class="adm-input" @bind="_disableTwoFactorPassword" placeholder="Sua senha atual" />
                            <button type="button"
                                    class="adm-btn adm-btn-danger"
                                    style="margin-top: 0.75rem; width: 100%; padding: 0.75rem; font-weight: 700;"
                                    disabled="@_isBusy"
                                    @onclick="DisableTwoFactorAsync">
                                @(_isBusy ? "Desativando..." : "Desativar Autenticação em 2 Etapas")
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- PROCESSO DE ATIVAÇÃO DO 2FA -->
                        @if (_twoFactorSetup is null)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-primary"
                                    style="padding: 0.85rem; font-size: 0.95rem; font-weight: 700;"
                                    disabled="@_isBusy"
                                    @onclick="StartTwoFactorSetupAsync">
                                @(_isBusy ? "Gerando chaves..." : "⚡ Iniciar Configuração do 2FA Agora")
                            </button>
                        }
                        else
                        {
                            <!-- Passo 1: Chave Secreta & QR Code -->
                            <div style="display: flex; flex-direction: column; gap: 0.75rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                                <strong style="color: var(--adm-text); font-size: 0.92rem;">
                                    1. Adicione a chave no seu aplicativo autenticador
                                </strong>
                                <p style="font-size: 0.8rem; color: var(--adm-muted); margin: 0;">
                                    Abra o Google Authenticator ou Microsoft Authenticator no celular, escolha "Inserir chave de configuração" e cole a chave abaixo:
                                </p>

                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <input type="text"
                                           class="adm-input"
                                           readonly
                                           value="@_twoFactorSetup.SecretKey"
                                           style="font-family: monospace; font-size: 1.1rem; font-weight: 800; letter-spacing: 0.15em; text-align: center; color: var(--adm-accent);" />
                                    <button type="button" class="adm-btn adm-btn-outline" @onclick="CopySecretKeyAsync">
                                        @(_copiedSecret ? "✓ Copiado" : "Copiar")
                                    </button>
                                </div>
                            </div>

                            <!-- Passo 2: Códigos de Emergência / Backup -->
                            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem;">
                                <strong style="color: var(--adm-text); font-size: 0.92rem; display: block; margin-bottom: 0.35rem;">
                                    2. Códigos de Recuperação de Emergência
                                </strong>
                                <p style="font-size: 0.78rem; color: var(--adm-muted); margin: 0 0 0.5rem;">
                                    Guarde estes 4 códigos em um lugar seguro. Eles permitem entrar se você perder o celular:
                                </p>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem;">
                                    @foreach (var backupCode in _twoFactorSetup.BackupCodes)
                                    {
                                        <div style="background: var(--adm-surface); border: 1px solid var(--adm-border); padding: 0.45rem; border-radius: 6px; font-family: monospace; font-size: 0.88rem; font-weight: 700; text-align: center; color: var(--adm-text);">
                                            @backupCode
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Passo 3: Confirmar com Código de 6 Dígitos -->
                            <div>
                                <label class="adm-label">3. Digite o código de 6 dígitos gerado no app para confirmar:</label>
                                <input type="text"
                                       class="adm-input"
                                       maxlength="6"
                                       style="font-size: 1.4rem; text-align: center; letter-spacing: 0.3em; font-family: monospace; font-weight: 800;"
                                       @bind="_twoFactorVerifyCode"
                                       placeholder="000000" />
                            </div>

                            <button type="button"
                                    class="adm-btn adm-btn-success"
                                    style="padding: 0.85rem; font-size: 0.95rem; font-weight: 800;"
                                    disabled="@_isBusy"
                                    @onclick="ConfirmAndEnableTwoFactorAsync">
                                @(_isBusy ? "Ativando..." : "🛡️ Confirmar e Ativar 2FA na Minha Conta")
                            </button>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string _currentTab = "profile";
    private bool _isBusy;
    private string? _error;
    private string? _success;

    // Perfil
    private string _profileFullName = string.Empty;
    private string _profileEmail = string.Empty;
    private string _profilePhone = string.Empty;

    // Senha
    private string _pwdCurrent = string.Empty;
    private string _pwdNew = string.Empty;
    private string _pwdConfirm = string.Empty;

    // PIN
    private string _pinCurrentPassword = string.Empty;
    private string _pinCode = string.Empty;

    // 2FA
    private TwoFactorSetupDto? _twoFactorSetup;
    private string _twoFactorVerifyCode = string.Empty;
    private bool _copiedSecret;
    private string _disableTwoFactorPassword = string.Empty;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _error = null;
            _success = null;
            _profileFullName = Gateway.CurrentEmployee?.FullName ?? "";
            _profileEmail = Gateway.CurrentEmployee?.Email ?? "";
            _profilePhone = Gateway.CurrentEmployee?.Phone ?? "";
        }
    }

    private void SetTab(string tab)
    {
        _currentTab = tab;
        _error = null;
        _success = null;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpperInvariant();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private async Task SaveProfileAsync()
    {
        _error = null;
        _success = null;
        _isBusy = true;
        try
        {
            await Gateway.UpdateUserProfileAsync(new UpdateUserProfileRequest(_profileFullName, _profileEmail, _profilePhone));
            _success = "✓ Dados de perfil atualizados com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_pwdCurrent))
        {
            _error = "Informe sua senha atual.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_pwdNew) || _pwdNew.Length < 4)
        {
            _error = "A nova senha deve ter no mínimo 4 caracteres.";
            return;
        }

        if (_pwdNew != _pwdConfirm)
        {
            _error = "A confirmação da nova senha não confere.";
            return;
        }

        _isBusy = true;
        try
        {
            await Gateway.ChangePasswordAsync(new ChangePasswordRequest(_pwdCurrent, _pwdNew));
            _pwdCurrent = string.Empty;
            _pwdNew = string.Empty;
            _pwdConfirm = string.Empty;
            _success = "✓ Senha atualizada com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SavePinAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_pinCurrentPassword))
        {
            _error = "Informe sua senha atual para autorizar.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_pinCode) || _pinCode.Length != 4 || !_pinCode.All(char.IsDigit))
        {
            _error = "O PIN deve conter exatamente 4 números.";
            return;
        }

        _isBusy = true;
        try
        {
            await Gateway.SetSecurityPinAsync(new SetSecurityPinRequest(_pinCurrentPassword, _pinCode));
            _pinCurrentPassword = string.Empty;
            _pinCode = string.Empty;
            _success = "✓ PIN numérico configurado com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemovePinAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_pinCurrentPassword))
        {
            _error = "Informe sua senha atual para autorizar a remoção do PIN.";
            return;
        }

        _isBusy = true;
        try
        {
            await Gateway.RemoveSecurityPinAsync(new RemoveSecurityPinRequest(_pinCurrentPassword));
            _pinCurrentPassword = string.Empty;
            _pinCode = string.Empty;
            _success = "✓ PIN de segurança removido.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task StartTwoFactorSetupAsync()
    {
        _error = null;
        _success = null;
        _isBusy = true;
        try
        {
            _twoFactorSetup = await Gateway.GenerateTwoFactorSetupAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CopySecretKeyAsync()
    {
        if (_twoFactorSetup is not null)
        {
            await Clipboard.Default.SetTextAsync(_twoFactorSetup.SecretKey);
            _copiedSecret = true;
            _ = Task.Delay(2500).ContinueWith(_ =>
            {
                _copiedSecret = false;
                InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task ConfirmAndEnableTwoFactorAsync()
    {
        if (_twoFactorSetup is null)
            return;

        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_twoFactorVerifyCode) || _twoFactorVerifyCode.Length != 6)
        {
            _error = "Digite o código de 6 dígitos gerado pelo app autenticador.";
            return;
        }

        _isBusy = true;
        try
        {
            await Gateway.EnableTwoFactorAsync(new EnableTwoFactorRequest(
                _twoFactorSetup.SecretKey,
                _twoFactorVerifyCode.Trim(),
                _twoFactorSetup.BackupCodes));

            _success = "🎉 Autenticação em Duas Etapas (2FA) ATIVADA com sucesso!";
            _twoFactorSetup = null;
            _twoFactorVerifyCode = string.Empty;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DisableTwoFactorAsync()
    {
        _error = null;
        _success = null;

        if (string.IsNullOrWhiteSpace(_disableTwoFactorPassword))
        {
            _error = "Informe sua senha atual para desativar o 2FA.";
            return;
        }

        _isBusy = true;
        try
        {
            await Gateway.DisableTwoFactorAsync(new DisableTwoFactorRequest(_disableTwoFactorPassword));
            _disableTwoFactorPassword = string.Empty;
            _success = "✓ Autenticação em duas etapas desativada.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
