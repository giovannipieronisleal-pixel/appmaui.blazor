@page "/planos"
@implements IDisposable
@inject MauiAdminGateway Gateway
@inject StoreBrandStateService BrandState
@inject ClothingStore.Application.Services.CatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Planos &amp; Versões do Site</PageTitle>

@if (!Gateway.IsAuthenticated)
{
    <Login />
}
else if (_loading)
{
    <div class="adm-card">
        <p style="margin: 0; color: var(--adm-muted);">Carregando planos e versões disponíveis...</p>
    </div>
}
else if (_settings is null)
{
    <div class="adm-alert adm-alert-error">@(_error ?? "Não foi possível carregar os dados dos planos.")</div>
}
else
{
    <div class="adm-page-header">
        <div>
            <h1 class="adm-page-title">Planos &amp; Versões do Site</h1>
            <p class="adm-page-subtitle">
                Todos os planos já incluem <strong>Servidor 24h + HTTPS + Endereço/Domínio</strong> da vitrine (sem cobrança à parte) para não encarecer sua operação.
            </p>
        </div>

        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/loja/@_settings.StoreSlug" class="adm-btn adm-btn-outline">
                🌐 Ver Site Público
            </a>
            @if (Gateway.IsAdmin)
            {
                <a href="/configuracoes-loja" class="adm-btn adm-btn-primary">
                    ⚙️ Configurações &amp; Estúdio
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="adm-alert adm-alert-error">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="adm-alert adm-alert-success">@_successMessage</div>
    }

    <!-- Status Atual do Plano -->
    <section class="adm-card" style="margin-bottom: 1.25rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <div style="display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;">
                    <span class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                        @GetPlanBadgeLabel()
                    </span>
                    <span class="pill-badge @(_settings.IsSiteActive ? "pill-green" : "pill-red")">
                        @(_settings.IsSiteActive ? "🟢 Site Visível para o Público" : "🔴 Site Pausado / Oculto")
                    </span>
                    @if (string.Equals(_settings.ActivePlanBillingKind, ClothingStore.Domain.Entities.PlanActivationCode.BillingKindGiftedUnpaid, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="pill-badge pill-gold">☁️ Cortesia (Sem Pagamento) · Servidor na Conta do Admin</span>
                    }
                </div>
                <p style="margin: 0; font-size: 0.9rem; color: var(--adm-muted);">
                    @GetPlanSummaryText()
                </p>
                @if (string.Equals(_settings.ActivePlanBillingKind, ClothingStore.Domain.Entities.PlanActivationCode.BillingKindGiftedUnpaid, StringComparison.OrdinalIgnoreCase))
                {
                    <div style="margin-top: 0.55rem; padding: 0.7rem 0.85rem; border-radius: 10px; background: var(--adm-surface-subtle); border: 1px dashed var(--adm-accent); font-size: 0.84rem; line-height: 1.45;">
                        <strong>☁️ Servidor Hospedado na Conta YouLink:</strong> Como você recebeu este plano sem pagamento, seu catálogo fica hospedado automaticamente no servidor do administrador. Escolha abaixo se quer <strong>usar um domínio grátis</strong> ou <strong>comprar seu domínio próprio</strong>!
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.55rem;">
                            <button type="button" class="adm-btn adm-btn-success" style="font-size: 0.8rem; padding: 0.42rem 0.78rem;" @onclick="SearchFreeDomainsAsync">
                                🎁 Escolher Domínio Grátis
                            </button>
                            <a href="/configuracoes-loja" class="adm-btn adm-btn-outline" style="font-size: 0.8rem; padding: 0.42rem 0.78rem; text-decoration: none;">
                                🛒 Comprar / Configurar Domínio Próprio
                            </a>
                        </div>
                    </div>
                }
            </div>

            <div style="text-align: right; font-size: 0.84rem; color: var(--adm-muted);">
                @if (_settings.PlanExpiresAt.HasValue)
                {
                    <div>
                        Validade: <strong style="color: var(--adm-text);">@_settings.PlanExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                }
                else
                {
                    <div>Validade: <strong style="color: var(--adm-text);">Sem expiração</strong></div>
                }

                @if (!string.IsNullOrWhiteSpace(_settings.ActiveGiftCardCode))
                {
                    <div style="margin-top: 0.2rem;">
                        Último Gift Card: <strong style="color: var(--adm-text);">@_settings.ActiveGiftCardCode</strong>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Destaque de Inclusão Total + Buscador de Domínios Grátis com Plano Mais Barato -->
    <section class="adm-card" style="margin-bottom: 1.25rem; border: 1.5px solid var(--adm-accent); background: linear-gradient(135deg, rgba(182,145,88,0.09), transparent 65%);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
            <div>
                <h2 style="margin: 0; font-size: 1.06rem; font-weight: 800;">
                    🎁 Procure um Domínio Grátis &amp; Deixe Seu Plano Mais Barato
                </h2>
                <p style="margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--adm-muted);">
                    Servidor 24h + HTTPS já estão inclusos. Se escolher um <strong>domínio gratuito disponível</strong> (<code>.duckdns.org</code>, <code>.dpdns.org</code>, <code>.pages.dev</code> ou endereço da plataforma), você economiza <strong>@FreeDomainFinder.DefaultMonthlyDiscountWithFreeDomain.ToString("C")/mês</strong> na mensalidade!
                </p>
            </div>
            <span class="pill-badge pill-green">Domínio R$ 0,00 + Desconto no Plano</span>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
            <input type="text"
                   class="adm-input"
                   style="flex: 1 1 220px; min-width: 0;"
                   @bind="_freeDomainQuery"
                   placeholder="Digite o nome da sua loja (ex.: auramodas)" />
            <button type="button"
                    class="adm-btn adm-btn-accent"
                    disabled="@_searchingFreeDomains"
                    @onclick="SearchFreeDomainsAsync">
                @(_searchingFreeDomains ? "Procurando..." : "🌐 Procurar Domínios Grátis")
            </button>
            @if (_useFreeDomainCheaperPlan)
            {
                <button type="button"
                        class="adm-btn adm-btn-outline"
                        @onclick="ClearFreeDomainOffer">
                    ✕ Voltar ao preço padrão
                </button>
            }
        </div>

        @if (_freeDomainSearch?.FeaturedOffer is not null)
        {
            var featured = _freeDomainSearch.FeaturedOffer;
            var sampleCheaper = FreeDomainFinder.CalculateCheaperPlanWithFreeDomain(_settings.IntermediaryPlanMonthlyPrice);
            <div style="margin-top: 0.85rem; padding: 0.85rem 1rem; border-radius: 10px; background: rgba(22,163,74,0.1); border: 1.5px solid var(--adm-success); display: flex; justify-content: space-between; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
                <div style="flex: 1 1 260px;">
                    <div style="font-weight: 800; color: var(--adm-success); font-size: 0.94rem;">
                        🎁 Olha! Este domínio está disponível gratuitamente: <code>@featured.Domain</code>
                    </div>
                    <div style="font-size: 0.83rem; color: var(--adm-text); margin-top: 0.25rem;">
                        Deseja usar ele gratuitamente (<strong>@featured.ProviderName</strong>) e ter um <strong>plano mais barato</strong> (por ex. Meia Versão de <s>@_settings.IntermediaryPlanMonthlyPrice.ToString("C")</s> por <strong>@sampleCheaper.CheaperMonthlyPrice.ToString("C")/mês</strong>)?
                    </div>
                </div>
                <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                    <button type="button"
                            class="adm-btn @(_useFreeDomainCheaperPlan && _selectedFreeDomain == featured.Domain ? "adm-btn-primary" : "adm-btn-success")"
                            @onclick="() => ApplyFreeDomainOffer(featured)">
                        @(_useFreeDomainCheaperPlan && _selectedFreeDomain == featured.Domain ? "✓ Domínio Grátis Aplicado!" : "✓ Sim, Usar Domínio Grátis & Plano Mais Barato")
                    </button>
                    @if (Gateway.IsAdmin)
                    {
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                disabled="@_savingPreset"
                                @onclick="() => ActivateFreeDomainOnStoreNowAsync(featured)">
                            💾 Salvar este Domínio Grátis na Minha Loja Agora
                        </button>
                    }
                </div>
            </div>

            @if (_freeDomainSearch.Candidates.Count > 1)
            {
                <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.65rem; align-items: center;">
                    <span style="font-size: 0.78rem; color: var(--adm-muted); font-weight: 700;">Outras opções grátis:</span>
                    @foreach (var item in _freeDomainSearch.Candidates.Where(c => c.IsAvailable).Take(6))
                    {
                        var isPicked = _useFreeDomainCheaperPlan && string.Equals(_selectedFreeDomain, item.Domain, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="pill-badge @(isPicked ? "pill-gold" : "pill-green")"
                                style="cursor: pointer; border: none; padding: 0.28rem 0.65rem; font-size: 0.76rem;"
                                @onclick="() => ApplyFreeDomainOffer(item)">
                            @(isPicked ? "✓ " : "🌐 ")@item.Domain
                        </button>
                    }
                </div>
            }
        }

        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--adm-border); display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.83rem; font-weight: 700; cursor: pointer;">
                <input type="checkbox" @bind="_useOwnDedicatedServerDiscount" />
                <span>☁️ Vou usar Meu Servidor Próprio (Google Cloud Run / Render / Fly.io: <strong>-R$ 10,00/mês</strong>)</span>
            </label>

            @if (_settings.QualifiesForDedicatedServerBenefit)
            {
                <span class="pill-badge pill-green">
                    👑 Conta Google Pro / Workspace (@GoogleAccountTierVerifier.GetTierFriendlyLabel(_settings.GoogleAccountTier)): -R$ 5,00/mês extra automático!
                </span>
            }
            else if (Gateway.IsAdmin)
            {
                <a href="/configuracoes-loja" class="pill-badge pill-gold" style="text-decoration: none; font-size: 0.76rem;">
                    🔐 Verificar Conta Google Pro (-R$ 5/mês) ou Servidor Próprio →
                </a>
            }
        </div>
    </section>

    <!-- Comparativo dos 3 Planos (clique em qualquer card para contratar/vender o plano) -->
    <section class="plans-grid" style="margin-bottom: 1.4rem;">
        <!-- Básico -->
        <article class="plan-card plan-card-clickable @(!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan ? "plan-active" : string.Empty)"
                 role="button"
                 tabindex="0"
                 @onclick='() => GoToPlanCheckout(StoreDesignPresets.PlanBasic)'>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <span class="pill-badge pill-slate">Básico</span>
                @if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
                {
                    <span class="pill-badge pill-green">Plano Atual</span>
                }
            </div>
            <h2 style="margin: 0; font-size: 1.2rem; font-weight: 800;">Plano Básico</h2>
            <div class="plan-price">
                @if (HasAnyPlanDiscount && GetDisplayPlanPrice(_settings.BasicPlanMonthlyPrice) < _settings.BasicPlanMonthlyPrice)
                {
                    <s style="font-size: 0.9rem; color: var(--adm-muted); font-weight: 500; margin-right: 0.35rem;">@_settings.BasicPlanMonthlyPrice.ToString("C")</s>
                }
                @GetDisplayPlanPrice(_settings.BasicPlanMonthlyPrice).ToString("C") <small>/mês</small>
            </div>
            <p style="margin: 0; font-size: 0.85rem; color: var(--adm-muted);">
                Visual oficial padrão pensado para leitura simples e compra direta pelo WhatsApp.
            </p>
            <ul class="plan-feature-list">
                <li><strong>1 versão oficial fixa:</strong> Minimalista Luxo</li>
                <li><strong>Servidor 24h + HTTPS inclusos</strong> (sem taxa extra de nuvem)</li>
                <li><strong>Domínio / Endereço da vitrine incluso</strong> no valor do plano</li>
                <li>Não configurável (visual pronto e equilibrado)</li>
                <li>Catálogo simples com busca, categorias e estoque real</li>
                <li>QR Code e botão direto de compra no WhatsApp</li>
            </ul>
            <a href="@GetCheckoutUrl(StoreDesignPresets.PlanBasic)"
               class="adm-btn @(!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan ? "adm-btn-outline" : "adm-btn-primary")"
               style="margin-top: 0.35rem; text-align: center;"
               @onclick:stopPropagation="true">
                @(!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan ? "Renovar Plano Básico →" : "Contratar Plano Básico →")
            </a>
        </article>

        <!-- Intermediário (Meia Versão) -->
        <article class="plan-card plan-card-clickable plan-popular @(BrandState.IsIntermediatePlan ? "plan-active" : string.Empty)"
                 role="button"
                 tabindex="0"
                 @onclick='() => GoToPlanCheckout(StoreDesignPresets.PlanIntermediate)'>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <span class="pill-badge pill-green">Meia Versão</span>
                @if (BrandState.IsIntermediatePlan)
                {
                    <span class="pill-badge pill-gold">Plano Atual</span>
                }
                else
                {
                    <span class="pill-badge pill-slate">5 Versões Prontas</span>
                }
            </div>
            <h2 style="margin: 0; font-size: 1.2rem; font-weight: 800;">Plano Intermediário</h2>
            <div class="plan-price">
                @if (HasAnyPlanDiscount && GetDisplayPlanPrice(_settings.IntermediaryPlanMonthlyPrice) < _settings.IntermediaryPlanMonthlyPrice)
                {
                    <s style="font-size: 0.9rem; color: var(--adm-muted); font-weight: 500; margin-right: 0.35rem;">@_settings.IntermediaryPlanMonthlyPrice.ToString("C")</s>
                }
                @GetDisplayPlanPrice(_settings.IntermediaryPlanMonthlyPrice).ToString("C") <small>/mês</small>
            </div>
            <p style="margin: 0; font-size: 0.85rem; color: var(--adm-muted);">
                Troque o visual da sua loja entre <strong>5 versões pré-prontas</strong> para combinar com seu público, sem precisar configurar nada.
            </p>
            <ul class="plan-feature-list">
                <li><strong>5 versões de site pré-prontas</strong> (escolha abaixo)</li>
                <li><strong>Servidor 24h + HTTPS inclusos</strong> (sem cobrança separada)</li>
                <li><strong>Domínio / Endereço da loja incluso</strong> sem taxa adicional</li>
                <li><strong>Painel Vendas &amp; Quanto Vendeu:</strong> faturamento por período, peças mais vendidas e vendas WhatsApp/balcão</li>
                <li><strong>Vendas no app apenas por Pix</strong> (ativável), distância máxima e cálculo Correios</li>
                <li><strong>Não configurável:</strong> layouts fixos calibrados para o público</li>
                <li>Troca instantânea com 1 clique sem mexer em código</li>
                <li>Ideal para destacar a identidade da coleção sem complexidade</li>
            </ul>
            <a href="@GetCheckoutUrl(StoreDesignPresets.PlanIntermediate)"
               class="adm-btn @(BrandState.IsIntermediatePlan ? "adm-btn-outline" : "adm-btn-primary")"
               style="margin-top: 0.35rem; text-align: center;"
               @onclick:stopPropagation="true">
                @(BrandState.IsIntermediatePlan ? "Renovar Meia Versão →" : "Contratar Meia Versão →")
            </a>
        </article>

        <!-- Premium -->
        <article class="plan-card plan-card-clickable @(BrandState.IsPremiumPlan ? "plan-active" : string.Empty)"
                 role="button"
                 tabindex="0"
                 @onclick='() => GoToPlanCheckout(StoreDesignPresets.PlanPremium)'>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <span class="pill-badge pill-gold">✦ Moldável</span>
                @if (BrandState.IsPremiumPlan)
                {
                    <span class="pill-badge pill-green">Plano Atual</span>
                }
            </div>
            <h2 style="margin: 0; font-size: 1.2rem; font-weight: 800;">Plano Premium Sob Medida</h2>
            <div class="plan-price">
                @if (HasAnyPlanDiscount && GetDisplayPlanPrice(_settings.PremiumPlanMonthlyPrice) < _settings.PremiumPlanMonthlyPrice)
                {
                    <s style="font-size: 0.9rem; color: var(--adm-muted); font-weight: 500; margin-right: 0.35rem;">@_settings.PremiumPlanMonthlyPrice.ToString("C")</s>
                }
                @GetDisplayPlanPrice(_settings.PremiumPlanMonthlyPrice).ToString("C") <small>/mês</small>
            </div>
            <p style="margin: 0; font-size: 0.85rem; color: var(--adm-muted);">
                Liberdade total para moldar cada cor, tipografia, borda, espaçamento e banner no Estúdio Visual.
            </p>
            <ul class="plan-feature-list">
                <li><strong>Todas as 5 versões pré-prontas</strong> como base inicial</li>
                <li><strong>Servidor 24h + HTTPS + Domínio inclusos</strong> no plano (zero taxa à parte)</li>
                <li><strong>Painel Vendas &amp; Quanto Vendeu:</strong> faturamento por período, peças mais vendidas e vendas WhatsApp/balcão</li>
                <li><strong>Vendas no app apenas por Pix</strong> (ativável), limite de distância e cálculo Correios</li>
                <li>Suporte opcional a domínio personalizado sem custo extra na plataforma</li>
                <li>Estúdio Visual completo: paleta livre, fontes e cantos</li>
                <li>Texto de destaque, faixa promocional e grade customizáveis</li>
                <li>Pré-visualização em tempo real antes de publicar ao público</li>
            </ul>
            <div style="display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.35rem;">
                @if (Gateway.IsAdmin && BrandState.IsPremiumPlan)
                {
                    <a href="/configuracoes-loja"
                       class="adm-btn adm-btn-accent"
                       style="text-align: center;"
                       @onclick:stopPropagation="true">
                        ✦ Abrir Estúdio Sob Medida
                    </a>
                }
                <a href="@GetCheckoutUrl(StoreDesignPresets.PlanPremium)"
                   class="adm-btn @(BrandState.IsPremiumPlan ? "adm-btn-outline" : "adm-btn-accent")"
                   style="text-align: center;"
                   @onclick:stopPropagation="true">
                    @(BrandState.IsPremiumPlan ? "Renovar Plano Premium →" : "Contratar Premium Sob Medida →")
                </a>
            </div>
        </article>
    </section>

    <!-- As 5 Versões Pré-Prontas de Site -->
    <section class="adm-card" style="margin-bottom: 1.4rem;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
            <div>
                <h2 style="margin: 0 0 0.25rem 0; font-size: 1.15rem; font-weight: 800;">
                    5 Versões de Site Pré-Prontas (Meia Versão)
                </h2>
                <p style="margin: 0; font-size: 0.87rem; color: var(--adm-muted); max-width: 720px;">
                    @if (BrandState.IsIntermediatePlan)
                    {
                        <span>
                            Seu plano <strong>Intermediário (Meia Versão)</strong> libera todas as 5 versões pré-prontas abaixo.
                            Escolha uma delas e clique em aplicar — neste plano os temas não são configuráveis manualmente.
                        </span>
                    }
                    else if (BrandState.IsPremiumPlan)
                    {
                        <span>
                            No plano <strong>Premium</strong> você também pode aplicar qualquer uma das 5 versões prontas aqui com 1 clique ou ajustá-la depois no Estúdio Visual.
                        </span>
                    }
                    else
                    {
                        <span>
                            No <strong>Plano Básico</strong> a loja usa a versão fixa <strong>Minimalista Luxo</strong>. Ative um Gift Card do Plano Intermediário ou Premium abaixo para desbloquear todas as 5 versões.
                        </span>
                    }
                </p>
            </div>

            @if (Gateway.IsAdmin && (BrandState.IsIntermediatePlan || BrandState.IsPremiumPlan))
            {
                <button type="button"
                        class="adm-btn adm-btn-primary"
                        disabled="@_savingPreset"
                        @onclick="ApplySelectedVersionAsync">
                    @(_savingPreset ? "Aplicando versão..." : "✓ Aplicar Versão Escolhida no Site")
                </button>
            }
        </div>

        <div class="version-showcase-grid">
            @foreach (var preset in StoreDesignPresets.All)
            {
                var isLockedForBasic = !BrandState.IsIntermediatePlan &&
                                       !BrandState.IsPremiumPlan &&
                                       !string.Equals(preset.Key, "minimalista-luxo", StringComparison.OrdinalIgnoreCase);
                var isSelected = string.Equals(_selectedPresetKey, preset.Key, StringComparison.OrdinalIgnoreCase);
                var isActiveLive = string.Equals(_activePresetKey, preset.Key, StringComparison.OrdinalIgnoreCase);

                <button type="button"
                        class="version-showcase-card @(isSelected ? "active" : string.Empty)"
                        disabled="@(!Gateway.IsAdmin || isLockedForBasic || _savingPreset)"
                        @onclick="() => SelectPreset(preset.Key)">
                    <div class="version-mini-bar" style="background: @preset.Design.BackgroundColor;">
                        <div style="height: 16px; background: @preset.Design.PrimaryColor; display: flex; align-items: center; justify-content: space-between; padding: 0 0.5rem;">
                            <span style="width: 36px; height: 4px; border-radius: 2px; background: @preset.Design.PrimaryTextColor; opacity: 0.9;"></span>
                            <span style="width: 14px; height: 4px; border-radius: 2px; background: @preset.Design.AccentColor;"></span>
                        </div>
                        <div style="flex: 1; padding: 0.4rem 0.55rem; display: flex; align-items: center; justify-content: space-between; gap: 0.4rem;">
                            <div style="display: flex; flex-direction: column; gap: 0.22rem;">
                                <span style="width: 72px; height: 5px; border-radius: 2px; background: @preset.Design.TextColor; opacity: 0.85;"></span>
                                <span style="width: 48px; height: 4px; border-radius: 2px; background: @preset.Design.MutedTextColor; opacity: 0.55;"></span>
                            </div>
                            <span style="padding: 0.16rem 0.45rem; border-radius: 4px; background: @preset.Design.SurfaceColor; border: 1px solid @preset.Design.BorderColor; font-size: 0.65rem; font-weight: 700; color: @preset.Design.TextColor;">
                                Ver Look
                            </span>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                        <strong style="font-size: 0.96rem;">@preset.Name</strong>
                        @if (isActiveLive)
                        {
                            <span class="pill-badge pill-green">Em uso no site</span>
                        }
                        else if (isLockedForBasic)
                        {
                            <span class="pill-badge pill-slate">🔒 Meia Versão+</span>
                        }
                        else if (isSelected)
                        {
                            <span class="pill-badge pill-gold">Selecionada</span>
                        }
                    </div>

                    <div style="font-size: 0.82rem; color: var(--adm-muted); line-height: 1.4;">
                        @preset.Tagline
                    </div>

                    @if (!string.IsNullOrWhiteSpace(preset.AudienceHint))
                    {
                        <div style="font-size: 0.77rem; color: var(--adm-text); opacity: 0.86;">
                            👥 @preset.AudienceHint
                        </div>
                    }
                </button>
            }
        </div>
    </section>

    <!-- Resgate de Gift Card & Upgrade via Pix -->
    <section class="adm-card">
        <h2 style="margin: 0 0 0.35rem 0; font-size: 1.12rem; font-weight: 800;">
            Ativar Plano ou Upgrade com Gift Card
        </h2>
        <p style="margin: 0 0 1rem 0; font-size: 0.86rem; color: var(--adm-muted);">
            Solicite seu código de ativação (<code>LUXO-BASC-...</code>, <code>LUXO-INTR-...</code> ou <code>LUXO-PREM-...</code>) via Pix
            <strong style="color: var(--adm-text);">@_settings.PicpayPixKey</strong> e resgate aqui na hora — já com <strong>Servidor 24h + HTTPS + Domínio/Endereço</strong> inclusos no plano.
        </p>

        @if (!Gateway.IsAdmin)
        {
            <div class="adm-alert adm-alert-error" style="margin: 0;">
                Apenas o administrador da loja pode trocar o plano ou alterar a versão do site.
            </div>
        }
        else
        {
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: flex-end;">
                <div style="flex: 1; min-width: 240px;">
                    <label class="adm-label" for="plan-giftcard-input">Código do Gift Card</label>
                    <input id="plan-giftcard-input"
                           class="adm-input"
                           placeholder="Ex.: LUXO-INTR-30D-ABCD1234"
                           @bind="_giftCardCode" />
                </div>
                <button type="button"
                        class="adm-btn adm-btn-accent"
                        disabled="@(_redeemingCode || string.IsNullOrWhiteSpace(_giftCardCode))"
                        @onclick="RedeemGiftCardAsync">
                    @(_redeemingCode ? "Validando código..." : "🎟️ Ativar Gift Card")
                </button>
            </div>
        }
    </section>
}

@code {
    private AdminStoreSettingsDto? _settings;
    private bool _loading = true;
    private bool _savingPreset;
    private bool _redeemingCode;
    private string _selectedPresetKey = "minimalista-luxo";
    private string _activePresetKey = "minimalista-luxo";
    private string _giftCardCode = string.Empty;
    private string _freeDomainQuery = string.Empty;
    private bool _searchingFreeDomains;
    private bool _useFreeDomainCheaperPlan;
    private bool _useOwnDedicatedServerDiscount;
    private string? _selectedFreeDomain;
    private FreeDomainSearchResponse? _freeDomainSearch;
    private string? _error;
    private string? _successMessage;

    private bool HasAnyPlanDiscount =>
        _useFreeDomainCheaperPlan ||
        _useOwnDedicatedServerDiscount ||
        (_settings?.QualifiesForDedicatedServerBenefit == true);

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        if (Gateway.IsAuthenticated)
        {
            await LoadAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async void OnAuthStateChanged()
    {
        if (Gateway.IsAuthenticated)
        {
            await LoadAsync();
        }
        else
        {
            _settings = null;
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Gateway.IsAdmin)
            {
                _settings = await Gateway.GetStoreSettingsAsync();
                BrandState.ApplyFromAdminSettings(_settings);
            }
            else
            {
                var pub = await CatalogService.GetPublicStoreSettingsAsync();
                _settings = new AdminStoreSettingsDto(
                    Guid.Empty,
                    pub.StoreName,
                    pub.StoreSlug,
                    pub.WhatsappNumber,
                    pub.StoreDescription,
                    null,
                    pub.LogoPublicUrl,
                    3,
                    pub.UpdatedAt,
                    pub.OnlineBaseUrl,
                    pub.AutoSyncOnlineOnSave,
                    pub.LastOnlineSyncAt,
                    pub.IsSiteActive,
                    pub.DeactivationReason,
                    pub.LastActivityAt,
                    pub.StoreName,
                    pub.PlanTier,
                    49.90m,
                    129.90m,
                    "picpay.me/sua-conta",
                    pub.Design,
                    pub.PlanActivatedAt,
                    null,
                    null,
                    89.90m);
                BrandState.ApplyFromPublicSettings(pub);
            }

            var currentPreset = _settings.Design?.PresetKey;
            _activePresetKey = StoreDesignPresets.ResolveByPresetKey(currentPreset).PresetKey;
            _selectedPresetKey = _activePresetKey;
            if (string.IsNullOrWhiteSpace(_freeDomainQuery))
                _freeDomainQuery = _settings.StoreName;

            if (string.Equals(_settings.ServerHostingMode, GoogleAccountTierVerifier.HostingModeDedicatedOwnServer, StringComparison.OrdinalIgnoreCase))
                _useOwnDedicatedServerDiscount = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetCheckoutUrl(string planTier)
    {
        var queryParts = new List<string>();
        if (_useFreeDomainCheaperPlan && !string.IsNullOrWhiteSpace(_selectedFreeDomain))
        {
            queryParts.Add($"freeDomain={Uri.EscapeDataString(_selectedFreeDomain)}");
            queryParts.Add("cheaper=1");
        }

        if (_useOwnDedicatedServerDiscount)
        {
            queryParts.Add("ownServer=1");
        }

        return queryParts.Count == 0
            ? $"/contratar-plano/{planTier}"
            : $"/contratar-plano/{planTier}?{string.Join("&", queryParts)}";
    }

    private void GoToPlanCheckout(string planTier)
    {
        Navigation.NavigateTo(GetCheckoutUrl(planTier));
    }

    private async Task SearchFreeDomainsAsync()
    {
        if (_settings is null)
            return;

        _searchingFreeDomains = true;
        _error = null;
        try
        {
            var query = string.IsNullOrWhiteSpace(_freeDomainQuery) ? _settings.StoreName : _freeDomainQuery;
            _freeDomainSearch = await Gateway.SearchFreeDomainsAsync(query);
        }
        catch (Exception ex)
        {
            _error = $"Erro ao buscar domínios gratuitos: {ex.Message}";
        }
        finally
        {
            _searchingFreeDomains = false;
        }
    }

    private void ApplyFreeDomainOffer(FreeDomainCandidateDto candidate)
    {
        _selectedFreeDomain = candidate.Domain;
        _useFreeDomainCheaperPlan = true;
        _successMessage = $"🎁 Domínio gratuito '{candidate.Domain}' aplicado! Todos os planos ficaram {FreeDomainFinder.DefaultMonthlyDiscountWithFreeDomain:C}/mês mais baratos.";
    }

    private async Task ActivateFreeDomainOnStoreNowAsync(FreeDomainCandidateDto candidate)
    {
        if (_settings is null || !Gateway.IsAdmin)
            return;

        _savingPreset = true;
        _error = null;
        _successMessage = null;
        try
        {
            var req = BuildUpdateRequest(_settings, (_settings.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone());
            req.OnlineBaseUrl = candidate.NormalizedUrl;
            req.DomainAcquisitionMode = ClothingStore.Domain.Entities.StoreSettings.DomainModeFreeDomain;

            var updated = await Gateway.UpdateStoreSettingsAsync(req);
            _settings = updated;
            BrandState.ApplyFromAdminSettings(updated);
            _selectedFreeDomain = candidate.Domain;
            _useFreeDomainCheaperPlan = true;
            _successMessage = $"✓ Domínio grátis '{candidate.Domain}' ({candidate.NormalizedUrl}) salvo na sua loja! Hospedagem atual: {(_settings.ServerHostingMode == "DedicatedOwnServer" ? "Meu Servidor Próprio" : "Servidor na Conta YouLink")}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingPreset = false;
        }
    }

    private void ClearFreeDomainOffer()
    {
        _useFreeDomainCheaperPlan = false;
        _selectedFreeDomain = null;
    }

    private decimal GetDisplayPlanPrice(decimal regularPrice) =>
        GoogleAccountTierVerifier.CalculatePlanBenefits(
            regularPrice,
            _useFreeDomainCheaperPlan,
            _settings?.GoogleAccountTier,
            _useOwnDedicatedServerDiscount).FinalMonthlyPrice;

    private void SelectPreset(string presetKey)
    {
        _selectedPresetKey = presetKey;
        _successMessage = null;
        _error = null;
    }

    private async Task ApplySelectedVersionAsync()
    {
        if (_settings is null || !Gateway.IsAdmin)
            return;

        if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
        {
            _error = "Para usar as outras versões pré-prontas, ative um Gift Card do Plano Intermediário (Meia Versão) ou Premium.";
            return;
        }

        _savingPreset = true;
        _error = null;
        _successMessage = null;

        try
        {
            var chosenPreset = StoreDesignPresets.All.FirstOrDefault(p =>
                string.Equals(p.Key, _selectedPresetKey, StringComparison.OrdinalIgnoreCase))
                ?? StoreDesignPresets.All[0];

            var req = BuildUpdateRequest(_settings, chosenPreset.Design.Clone());
            var updated = await Gateway.UpdateStoreSettingsAsync(req);

            _settings = updated;
            BrandState.ApplyFromAdminSettings(updated);
            _activePresetKey = StoreDesignPresets.ResolveByPresetKey(updated.Design?.PresetKey).PresetKey;
            _selectedPresetKey = _activePresetKey;
            _successMessage = $"Versão '{chosenPreset.Name}' aplicada! Seus clientes já veem essa identidade no site público.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingPreset = false;
        }
    }

    private async Task RedeemGiftCardAsync()
    {
        if (!Gateway.IsAdmin || string.IsNullOrWhiteSpace(_giftCardCode))
            return;

        _redeemingCode = true;
        _error = null;
        _successMessage = null;

        try
        {
            var response = await Gateway.RedeemActivationCodeAsync(new RedeemActivationCodeRequest
            {
                Code = _giftCardCode.Trim()
            });

            _settings = response.UpdatedSettings;
            BrandState.ApplyFromAdminSettings(response.UpdatedSettings);
            _activePresetKey = StoreDesignPresets.ResolveByPresetKey(_settings.Design?.PresetKey).PresetKey;
            _selectedPresetKey = _activePresetKey;
            _giftCardCode = string.Empty;
            _successMessage = response.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _redeemingCode = false;
        }
    }

    private static UpdateStoreSettingsRequest BuildUpdateRequest(AdminStoreSettingsDto current, StoreDesignDto design) => new()
    {
        StoreName = current.StoreName,
        StoreSlug = current.StoreSlug,
        WhatsappNumber = current.WhatsappNumber,
        StoreDescription = current.StoreDescription,
        LogoPublicUrl = current.LogoPublicUrl,
        DefaultLowStockThreshold = current.DefaultLowStockThreshold,
        OnlineBaseUrl = current.OnlineBaseUrl,
        AutoSyncOnlineOnSave = current.AutoSyncOnlineOnSave,
        LastOnlineSyncAt = current.LastOnlineSyncAt,
        IsSiteActive = current.IsSiteActive,
        DeactivationReason = current.DeactivationReason,
        LastActivityAt = current.LastActivityAt,
        PublishedStoreName = current.PublishedStoreName,
        PlanTier = current.PlanTier,
        BasicPlanMonthlyPrice = current.BasicPlanMonthlyPrice,
        IntermediaryPlanMonthlyPrice = current.IntermediaryPlanMonthlyPrice,
        PremiumPlanMonthlyPrice = current.PremiumPlanMonthlyPrice,
        PicpayPixKey = current.PicpayPixKey,
        Design = design
    };

    private string GetPlanBadgeLabel() =>
        BrandState.IsPremiumPlan
            ? "✦ Plano Premium Sob Medida"
            : BrandState.IsIntermediatePlan
                ? "◈ Plano Intermediário (Meia Versão)"
                : "Plano Básico · Minimalista Luxo";

    private string GetPlanSummaryText()
    {
        if (BrandState.IsPremiumPlan)
            return "Você tem acesso completo às 5 versões pré-prontas, Estúdio Visual Sob Medida, vendas diretas no app por Pix (ativável) com limite de distância e cálculo dos Correios.";
        if (BrandState.IsIntermediatePlan)
            return "Você pode alternar livremente entre 5 versões de site pré-prontas e ativar vendas diretas no app por Pix com limite de distância e estimativa dos Correios.";
        return "Sua loja opera com o layout fixo Minimalista Luxo, pensado para compras rápidas pelo WhatsApp.";
    }

    public void Dispose()
    {
        Gateway.AuthStateChanged -= OnAuthStateChanged;
    }
}
