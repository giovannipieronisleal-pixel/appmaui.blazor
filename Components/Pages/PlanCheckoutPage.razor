@page "/contratar-plano"
@page "/contratar-plano/{PlanTier?}"
@using ClothingStore.Application.Services
@using ClothingStore.Shared.Helpers
@implements IDisposable
@inject MauiAdminGateway Gateway
@inject StoreBrandStateService BrandState
@inject CatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Contratar @GetPlanTitle(_selectedTier)</PageTitle>

@if (!Gateway.IsAuthenticated)
{
    <Login />
}
else if (_loading)
{
    <div class="adm-card">
        <p style="margin: 0; color: var(--adm-muted);">Carregando detalhes do plano selecionado...</p>
    </div>
}
else if (_settings is null)
{
    <div class="adm-alert adm-alert-error">@(_error ?? "Não foi possível carregar os dados de contratação.")</div>
}
else
{
    <div class="adm-page-header">
        <div>
            <h1 class="adm-page-title">Contratar @GetPlanTitle(_selectedTier)</h1>
            <p class="adm-page-subtitle">
                Servidor em nuvem 24h, HTTPS e domínio/endereço da loja <strong>já estão inclusos no plano (R$ 0,00 extra)</strong>. Revise o pacote e conclua direto pelo celular via Pix (Copia e Cola).
            </p>
        </div>

        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
            <a href="/planos" class="adm-btn adm-btn-outline">
                ← Voltar para Planos
            </a>
            @if (Gateway.IsAdmin)
            {
                <a href="/configuracoes-loja" class="adm-btn adm-btn-outline">
                    ⚙️ Configurações da Loja
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="adm-alert adm-alert-error">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="adm-alert adm-alert-success">@_successMessage</div>
    }

    @if (CurrentPlanPrompt.ShouldPrompt && _activePlanOrder is null)
    {
        <section class="adm-card" style="margin-bottom: 1.25rem; border: 1.5px solid var(--adm-accent); background: linear-gradient(135deg, rgba(182,145,88,0.12), transparent 70%); display: flex; justify-content: space-between; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
            <div style="flex: 1 1 260px;">
                <div style="font-weight: 800; font-size: 0.96rem; color: var(--adm-text);">@CurrentPlanPrompt.Headline</div>
                <div style="font-size: 0.84rem; color: var(--adm-muted); margin-top: 0.2rem;">@CurrentPlanPrompt.Message</div>
            </div>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button type="button" class="adm-btn adm-btn-accent" @onclick="() => _showExistingPlanModal = true">
                    🔄 Mudar de Plano / Opções
                </button>
                @if (Gateway.IsAdmin)
                {
                    <a href="/configuracoes-loja" class="adm-btn adm-btn-outline" style="text-decoration: none;">
                        ✨ Ir para Estúdio
                    </a>
                }
            </div>
        </section>
    }

    <!-- Escolha rápida do Plano -->
    <section class="adm-card" style="margin-bottom: 1.25rem;">
        <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--adm-muted); margin-bottom: 0.65rem;">
            1. Plano Selecionado
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 0.75rem;">
            <button type="button"
                    class="theme-card-option @(_selectedTier == StoreDesignPresets.PlanBasic ? "active" : string.Empty)"
                    @onclick="() => SelectTier(StoreDesignPresets.PlanBasic)">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.4rem;">
                    <strong>Plano Básico</strong>
                    <span class="pill-badge pill-slate">@_settings.BasicPlanMonthlyPrice.ToString("C")/mês</span>
                </div>
                <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.35rem;">
                    Tema fixo Minimalista Luxo + Servidor 24h e Domínio inclusos.
                </div>
            </button>

            <button type="button"
                    class="theme-card-option @(_selectedTier == StoreDesignPresets.PlanIntermediate ? "active" : string.Empty)"
                    @onclick="() => SelectTier(StoreDesignPresets.PlanIntermediate)">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.4rem;">
                    <strong>Meia Versão</strong>
                    <span class="pill-badge pill-green">@_settings.IntermediaryPlanMonthlyPrice.ToString("C")/mês</span>
                </div>
                <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.35rem;">
                    5 versões pré-prontas + Servidor 24h e Domínio inclusos.
                </div>
            </button>

            <button type="button"
                    class="theme-card-option @(_selectedTier == StoreDesignPresets.PlanPremium ? "active" : string.Empty)"
                    @onclick="() => SelectTier(StoreDesignPresets.PlanPremium)">
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.4rem;">
                    <strong>Premium Sob Medida</strong>
                    <span class="pill-badge pill-gold">@_settings.PremiumPlanMonthlyPrice.ToString("C")/mês</span>
                </div>
                <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.35rem;">
                    Estúdio Visual completo + Servidor 24h e Domínio inclusos.
                </div>
            </button>
        </div>
    </section>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: 1.25rem; align-items: start;">
        <!-- Coluna 1: Período, Dados do Pedido & Benefícios -->
        <section class="adm-card" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--adm-muted); margin-bottom: 0.55rem;">
                    2. Período e Dados da Venda
                </div>
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button"
                            class="adm-chip-filter @(_durationMonths == 1 ? "active" : string.Empty)"
                            @onclick="() => _durationMonths = 1">
                        Mensal (30 dias)
                    </button>
                    <button type="button"
                            class="adm-chip-filter @(_durationMonths == 3 ? "active" : string.Empty)"
                            @onclick="() => _durationMonths = 3">
                        Trimestral (90 dias)
                    </button>
                    <button type="button"
                            class="adm-chip-filter @(_durationMonths == 12 ? "active" : string.Empty)"
                            @onclick="() => _durationMonths = 12">
                        Anual (365 dias)
                    </button>
                </div>
            </div>

            <div>
                <label class="adm-label" for="checkout-store-name">Nome da Loja *</label>
                <input id="checkout-store-name"
                       class="adm-input"
                       @bind="_customerStoreName"
                       placeholder="Ex.: Minha Loja" />
            </div>

            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
                    <label class="adm-label" for="checkout-domain" style="margin: 0;">Endereço / Domínio da Loja</label>
                    <span class="pill-badge pill-green">Incluso no Plano (R$ 0,00 extra)</span>
                </div>
                <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                    <input id="checkout-domain"
                           class="adm-input"
                           style="flex: 1 1 200px; min-width: 0;"
                           @bind="_desiredDomain"
                           placeholder="Ex.: lojas.minhaloja.com ou minha-loja" />
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="white-space: nowrap; flex: 0 1 auto;"
                            disabled="@(_isCheckingDomain || string.IsNullOrWhiteSpace(_desiredDomain))"
                            @onclick="CheckCheckoutDomainAsync">
                        @(_isCheckingDomain ? "Verificando..." : "🔍 Verificar Endereço")
                    </button>
                    <button type="button"
                            class="adm-btn adm-btn-accent"
                            style="white-space: nowrap; flex: 0 1 auto;"
                            disabled="@_searchingFreeDomains"
                            @onclick="SearchFreeDomainsForCheckoutAsync">
                        @(_searchingFreeDomains ? "Buscando..." : "🎁 Procurar Domínio Grátis")
                    </button>
                </div>

                @if (_freeDomainSearch?.FeaturedOffer is not null)
                {
                    var freeOffer = _freeDomainSearch.FeaturedOffer;
                    var cheaperPreview = FreeDomainFinder.CalculateCheaperPlanWithFreeDomain(RegularMonthlyPrice);
                    <div style="margin-top: 0.65rem; padding: 0.75rem 0.9rem; border-radius: 10px; background: rgba(22,163,74,0.1); border: 1.5px solid var(--adm-success);">
                        <div style="font-weight: 800; font-size: 0.88rem; color: var(--adm-success);">
                            🎁 Olha! Este domínio gratuito está disponível: <code>@freeOffer.Domain</code>
                        </div>
                        <div style="font-size: 0.8rem; color: var(--adm-text); margin-top: 0.2rem;">
                            Deseja usar ele gratuitamente (<strong>@freeOffer.ProviderName</strong>) e ter um plano mais barato (de <s>@RegularMonthlyPrice.ToString("C")</s> por <strong>@cheaperPreview.CheaperMonthlyPrice.ToString("C")/mês</strong>)?
                        </div>
                        <div style="display: flex; gap: 0.45rem; flex-wrap: wrap; margin-top: 0.5rem;">
                            @foreach (var item in _freeDomainSearch.Candidates.Where(c => c.IsAvailable).Take(5))
                            {
                                var picked = _useFreeDomainCheaperPlan && string.Equals(_desiredDomain, item.Domain, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="pill-badge @(picked ? "pill-gold" : "pill-green")"
                                        style="border: none; cursor: pointer; padding: 0.25rem 0.6rem; font-size: 0.76rem;"
                                        @onclick="() => UseFreeDomainOfferInCheckout(item)">
                                    @(picked ? "✓ " : "🎁 Usar ")@item.Domain
                                </button>
                            }
                        </div>
                    </div>
                }

                <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; font-weight: 700; margin-top: 0.5rem; cursor: pointer;">
                    <input type="checkbox" @bind="_useFreeDomainCheaperPlan" />
                    <span>Usar endereço/domínio gratuito e aplicar desconto de plano mais barato (-@FreeDomainFinder.CalculateCheaperPlanWithFreeDomain(RegularMonthlyPrice).SavingsPerMonth.ToString("C", new System.Globalization.CultureInfo("pt-BR"))/mês)</span>
                </label>

                <label style="display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; font-weight: 700; margin-top: 0.4rem; cursor: pointer;">
                    <input type="checkbox" @bind="_useOwnDedicatedServer" />
                    <span>☁️ Vou hospedar no Meu Servidor Próprio (Google Cloud Run / Render / Fly.io: -R$ 10,00/mês)</span>
                </label>

                @if (_settings.QualifiesForDedicatedServerBenefit)
                {
                    <div style="margin-top: 0.45rem; padding: 0.5rem 0.75rem; border-radius: 8px; background: rgba(22,163,74,0.1); border: 1px solid var(--adm-success); font-size: 0.79rem; color: var(--adm-success); font-weight: 700;">
                        👑 Conta Google Pro / Workspace verificada (@_settings.GoogleAccountEmail): desconto automático extra de -R$ 5,00/mês aplicado!
                    </div>
                }

                @if (_domainCheckResult is not null)
                {
                    <div style="margin-top: 0.5rem; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.82rem; @(_domainCheckResult.IsAvailable ? "background: rgba(34,197,94,0.12); border: 1px solid var(--adm-success); color: var(--adm-success);" : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger); color: var(--adm-danger);")">
                        <div style="font-weight: 700;">
                            @(_domainCheckResult.IsAvailable ? "✓ " + _domainCheckResult.Message : "✕ " + _domainCheckResult.Message)
                        </div>
                        @if (_domainCheckResult.IsAvailable)
                        {
                            <div style="font-size: 0.76rem; margin-top: 0.2rem;">
                                Endereço já coberto no plano (sem cobrança à parte): <strong>@_domainCheckResult.NormalizedUrl</strong>
                            </div>
                        }
                        else if (_domainCheckResult.Suggestions.Count > 0)
                        {
                            <div style="margin-top: 0.35rem; font-size: 0.76rem;">Sugestões inclusas disponíveis:</div>
                            <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                @foreach (var s in _domainCheckResult.Suggestions)
                                {
                                    <button type="button"
                                            class="pill-badge pill-blue"
                                            style="border: none; cursor: pointer; padding: 0.2rem 0.5rem; font-size: 0.75rem;"
                                            @onclick="() => SelectCheckoutSuggestionAsync(s)">
                                        @s
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span style="font-size: 0.77rem; color: var(--adm-muted);">
                        Servidor 24h, HTTPS e o endereço/subdomínio oficial da loja já vão dentro do plano — zero compra separada de domínio.
                    </span>
                }
            </div>

            <div>
                <label class="adm-label" for="checkout-contact-email">Seu Usuário / Gmail de Acesso</label>
                <input id="checkout-contact-email"
                       class="adm-input"
                       @bind="_customerContact"
                       placeholder="Ex.: seu.usuario ou seu.email@gmail.com" />
            </div>

            <div style="background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.9rem;">
                <strong style="display: block; margin-bottom: 0.45rem; font-size: 0.92rem;">
                    O que está incluído no @GetPlanTitle(_selectedTier):
                </strong>
                <ul class="plan-feature-list" style="margin: 0;">
                    @foreach (var item in GetPlanFeatures(_selectedTier))
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        </section>

        <!-- Coluna 2: Pagamento Pix, Fechamento no WhatsApp & Ativação Gift Card -->
        <section class="adm-card" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--adm-muted); margin-bottom: 0.35rem;">
                    3. Finalizar Contratação do Plano
                </div>
                <div class="plan-price" style="font-size: 2.1rem;">
                    @TotalOrderAmount.ToString("C")
                    <small>/ @DurationLabel</small>
                </div>
                <p style="margin: 0.35rem 0 0; font-size: 0.84rem; color: var(--adm-muted);">
                    Valor único de @MonthlyPrice.ToString("C")/mês × @_durationMonths mes(es) — sem taxas extras de servidor ou domínio.
                </p>
            </div>

            <div style="background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.84rem;">
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <span style="color: var(--adm-muted);">@GetPlanTitle(_selectedTier) (@_durationMonths mes(es))</span>
                    <strong>@((RegularMonthlyPrice * _durationMonths).ToString("C"))</strong>
                </div>
                @if (CurrentBenefits.FreeDomainDiscount > 0m)
                {
                    <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                        <span style="color: var(--adm-success); font-weight: 700;">🎁 Desconto Domínio Grátis</span>
                        <strong style="color: var(--adm-success);">-@((CurrentBenefits.FreeDomainDiscount * _durationMonths).ToString("C"))</strong>
                    </div>
                }
                @if (CurrentBenefits.OwnServerDiscount > 0m)
                {
                    <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                        <span style="color: var(--adm-success); font-weight: 700;">☁️ Desconto Meu Servidor Próprio</span>
                        <strong style="color: var(--adm-success);">-@((CurrentBenefits.OwnServerDiscount * _durationMonths).ToString("C"))</strong>
                    </div>
                }
                @if (CurrentBenefits.GoogleTierDiscount > 0m)
                {
                    <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                        <span style="color: var(--adm-success); font-weight: 700;">👑 Desconto Conta Google Pro / Workspace</span>
                        <strong style="color: var(--adm-success);">-@((CurrentBenefits.GoogleTierDiscount * _durationMonths).ToString("C"))</strong>
                    </div>
                }
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <span style="color: var(--adm-muted);">☁️ Servidor 24h + Certificado HTTPS</span>
                    <strong style="color: var(--adm-success);">Incluso (R$ 0,00)</strong>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 0.5rem;">
                    <span style="color: var(--adm-muted);">🌐 Domínio / Endereço da Vitrine</span>
                    <strong style="color: var(--adm-success);">Incluso (R$ 0,00)</strong>
                </div>
                <div style="display: flex; justify-content: space-between; gap: 0.5rem; padding-top: 0.45rem; border-top: 1px dashed var(--adm-border);">
                    <strong>Total final (tudo incluso)</strong>
                    <strong>@TotalOrderAmount.ToString("C")</strong>
                </div>
            </div>

            @if (_planAutoActivatedResult is not null)
            {
                <div style="padding: 1rem; border-radius: 10px; background: rgba(22, 163, 74, 0.14); border: 1.5px solid var(--adm-success); display: flex; flex-direction: column; gap: 0.55rem;">
                    <div style="font-weight: 800; color: var(--adm-success); font-size: 1.02rem;">
                        🎉 Pagamento Confirmado! Sua Versão Paga Chegou Automaticamente!
                    </div>
                    <div style="font-size: 0.86rem; color: var(--adm-text); line-height: 1.5;">
                        O pedido <strong>@_planAutoActivatedResult.OrderNumber</strong> foi aprovado e o plano
                        <strong>@GetPlanTitle(_planAutoActivatedResult.PlanTier)</strong> já está ativo nesta loja
                        @if (_planAutoActivatedResult.AppliedPlanExpiresAt.HasValue)
                        {
                            <span> até <strong>@_planAutoActivatedResult.AppliedPlanExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</strong></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_planAutoActivatedResult.IssuedGiftCardCode))
                        {
                            <span> (Comprovante: <code>@_planAutoActivatedResult.IssuedGiftCardCode</code>)</span>
                        }.
                    </div>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="/configuracoes-loja" class="adm-btn adm-btn-success">✨ Abrir Loja &amp; Visual Liberado</a>
                        <a href="/" class="adm-btn adm-btn-outline">Ir para o Painel</a>
                    </div>
                </div>
            }
            else if (_activePlanOrder is null)
            {
                <div style="background: var(--adm-surface-subtle); border: 1px dashed var(--adm-border); border-radius: 10px; padding: 0.9rem; display: flex; flex-direction: column; gap: 0.45rem;">
                    <div style="font-size: 0.85rem; font-weight: 800; color: var(--adm-text);">
                        🔒 A chave Pix aparece somente após você confirmar a compra abaixo
                    </div>
                    <div style="font-size: 0.79rem; color: var(--adm-muted); line-height: 1.45;">
                        Quando você clicar no botão abaixo, geraremos o pedido e mostraremos a chave Pix oficial + QR Code exato (@TotalOrderAmount.ToString("C")).
                        Assim que o pagamento for confirmado, a sua versão paga chega automaticamente no aplicativo — sem precisar digitar código!
                    </div>
                </div>

                <button type="button"
                        class="adm-btn adm-btn-success"
                        style="text-align: center; padding: 0.95rem; font-size: 0.96rem; font-weight: 800;"
                        disabled="@_creatingPlanOrder"
                        @onclick="ConfirmDirectMobilePlanOrderAsync">
                    @(_creatingPlanOrder ? "Gerando pedido e liberando chave Pix..." : $"💳 Confirmar Compra e Liberar Chave Pix ({TotalOrderAmount.ToString("C")})")
                </button>
            }
            else
            {
                <div style="background: var(--adm-surface-subtle); border: 1.5px solid var(--adm-accent); border-radius: 10px; padding: 0.95rem; display: flex; flex-direction: column; gap: 0.7rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <div style="font-size: 0.88rem; font-weight: 800;">
                            💸 Chave Pix Liberada — Pedido @_activePlanOrder.OrderNumber
                        </div>
                        <span class="pill-badge pill-gold">Aguardando Pix</span>
                    </div>

                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                        <code style="flex: 1; font-size: 0.94rem; padding: 0.5rem 0.65rem; border-radius: 6px; background: var(--adm-card); border: 1px solid var(--adm-border); overflow-wrap: anywhere;">
                            @_activePlanOrder.PixKeyUsed
                        </code>
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="white-space: nowrap;"
                                @onclick="CopyPixKeyAsync">
                            @(_copiedPix ? "✓ Chave Copiada!" : "📋 Copiar Chave Pix")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_activePlanOrder.PixBrCode))
                    {
                        var planPixQrUri = ClothingStore.Shared.Helpers.WhatsAppLinkBuilder.GenerateQrCodeSvgDataUri(_activePlanOrder.PixBrCode);
                        <div style="border-top: 1px solid var(--adm-border); padding-top: 0.65rem; display: flex; flex-direction: column; gap: 0.55rem;">
                            <div style="font-size: 0.79rem; font-weight: 700; color: var(--adm-success);">
                                ✅ Pix Copia e Cola no valor exato (@_activePlanOrder.Amount.ToString("C")):
                            </div>
                            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                                <img src="@planPixQrUri"
                                     alt="QR Code Pix no valor exato"
                                     style="width: 112px; height: 112px; border-radius: 8px; background: #FFFFFF; padding: 5px; border: 1px solid var(--adm-border);" />
                                <div style="flex: 1 1 200px; display: flex; flex-direction: column; gap: 0.45rem;">
                                    <input type="text" readonly class="adm-input" value="@_activePlanOrder.PixBrCode" style="width: 100%; font-family: monospace; font-size: 0.74rem;" />
                                    <button type="button"
                                            class="adm-btn adm-btn-primary"
                                            style="white-space: nowrap; align-self: flex-start;"
                                            @onclick="CopyPlanPixBrCodeAsync">
                                        @(_copiedPlanBrCode ? "✓ Pix EMV Copiado!" : "📋 Copiar Pix Copia e Cola")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div style="border-top: 1px solid var(--adm-border); padding-top: 0.6rem; font-size: 0.79rem; color: var(--adm-muted); line-height: 1.45;">
                        ⏳ <strong>Verificação automática ativa:</strong> assim que você transferir e o administrador confirmar no painel, a sua versão paga será entregue automaticamente aqui neste aparelho.
                    </div>

                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button type="button"
                                class="adm-btn adm-btn-success"
                                disabled="@_checkingOrderStatus"
                                @onclick="CheckOrderStatusNowAsync">
                            @(_checkingOrderStatus ? "Verificando..." : "🔄 Já paguei — Verificar Agora")
                        </button>
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                @onclick="CancelActivePendingOrder">
                            ✕ Alterar Plano / Cancelar
                        </button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(WhatsAppSaleUrl))
            {
                <div style="display: flex; justify-content: flex-end;">
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="font-size: 0.78rem; padding: 0.4rem 0.75rem;"
                            @onclick="OpenWhatsAppOrderAsync">
                        💬 Precisa de ajuda no WhatsApp? (Opcional)
                    </button>
                </div>
            }

            <hr style="border: none; border-top: 1px solid var(--adm-border); margin: 0.25rem 0;" />

            <div>
                <h2 style="margin: 0 0 0.25rem 0; font-size: 1rem; font-weight: 800;">
                    Já recebeu seu código Gift Card?
                </h2>
                <p style="margin: 0 0 0.75rem 0; font-size: 0.83rem; color: var(--adm-muted);">
                    Digite o código gerado após a confirmação do pagamento para liberar o plano na mesma hora.
                </p>

                @if (!Gateway.IsAdmin)
                {
                    <div class="adm-alert adm-alert-error" style="margin: 0;">
                        Apenas um administrador da loja pode ativar o código de plano.
                    </div>
                }
                else
                {
                    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                        <input class="adm-input"
                               style="flex: 1 1 180px; min-width: 0; text-transform: uppercase; font-family: monospace; font-weight: 700;"
                               placeholder="Ex.: LUXO-INTR-30D-..."
                               @bind="_giftCardCode" />
                        <button type="button"
                                class="adm-btn adm-btn-accent"
                                disabled="@(_redeemingCode || string.IsNullOrWhiteSpace(_giftCardCode))"
                                @onclick="RedeemGiftCardAsync">
                            @(_redeemingCode ? "Ativando..." : "🎟️ Ativar Agora")
                        </button>
                    </div>
                }
            </div>
        </section>
    </div>

    @if (_showExistingPlanModal && CurrentPlanPrompt.ShouldPrompt)
    {
        <div class="adm-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="existing-plan-modal-title" style="z-index: 9999;">
            <div class="adm-card adm-modal-card" style="max-width: 540px; border: 2px solid var(--adm-accent); display: flex; flex-direction: column; gap: 0.95rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem;">
                    <div>
                        <span class="pill-badge pill-gold">Plano Atual Ativo</span>
                        <h2 id="existing-plan-modal-title" style="margin: 0.35rem 0 0; font-size: 1.15rem; font-weight: 800; color: var(--adm-text);">
                            @CurrentPlanPrompt.Headline
                        </h2>
                    </div>
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="padding: 0.3rem 0.6rem;"
                            @onclick="DismissExistingPlanModal">
                        ✕
                    </button>
                </div>

                <p style="margin: 0; font-size: 0.9rem; color: var(--adm-muted); line-height: 1.5;">
                    @CurrentPlanPrompt.Message
                </p>

                <div style="background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem;">
                    <strong style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--adm-muted);">
                        Mudar de plano ou fechar para comprar para outra loja:
                    </strong>
                    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                        <button type="button"
                                class="adm-btn @(_selectedTier == StoreDesignPresets.PlanBasic ? "adm-btn-primary" : "adm-btn-outline")"
                                style="font-size: 0.8rem; padding: 0.45rem 0.75rem;"
                                @onclick="() => SelectTierFromModal(StoreDesignPresets.PlanBasic)">
                            ● Plano Básico
                        </button>
                        <button type="button"
                                class="adm-btn @(_selectedTier == StoreDesignPresets.PlanIntermediate ? "adm-btn-primary" : "adm-btn-outline")"
                                style="font-size: 0.8rem; padding: 0.45rem 0.75rem;"
                                @onclick="() => SelectTierFromModal(StoreDesignPresets.PlanIntermediate)">
                            ◈ Meia Versão
                        </button>
                        <button type="button"
                                class="adm-btn @(_selectedTier == StoreDesignPresets.PlanPremium ? "adm-btn-primary" : "adm-btn-outline")"
                                style="font-size: 0.8rem; padding: 0.45rem 0.75rem;"
                                @onclick="() => SelectTierFromModal(StoreDesignPresets.PlanPremium)">
                            ✦ Premium Sob Medida
                        </button>
                    </div>
                </div>

                <div style="display: flex; gap: 0.55rem; flex-wrap: wrap; justify-content: flex-end; padding-top: 0.35rem; border-top: 1px solid var(--adm-border);">
                    <a href="/planos" class="adm-btn adm-btn-outline" style="text-decoration: none;">
                        ← Voltar para Planos
                    </a>
                    @if (Gateway.IsAdmin)
                    {
                        <a href="/configuracoes-loja" class="adm-btn adm-btn-accent" style="text-decoration: none;">
                            ✨ Abrir Estúdio &amp; Configurações
                        </a>
                    }
                    <button type="button"
                            class="adm-btn adm-btn-success"
                            @onclick="ProceedWithExistingPlanOrderAsync">
                        @CurrentPlanPrompt.ConfirmActionLabel
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public string? PlanTier { get; set; }

    [SupplyParameterFromQuery(Name = "freeDomain")]
    public string? FreeDomainQuery { get; set; }

    [SupplyParameterFromQuery(Name = "cheaper")]
    public string? CheaperQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ownServer")]
    public string? OwnServerQuery { get; set; }

    private AdminStoreSettingsDto? _settings;
    private bool _loading = true;
    private bool _copiedPix;
    private bool _redeemingCode;
    private bool _isCheckingDomain;
    private bool _searchingFreeDomains;
    private bool _useFreeDomainCheaperPlan;
    private bool _useOwnDedicatedServer;
    private FreeDomainSearchResponse? _freeDomainSearch;
    private CheckDomainAvailabilityResponse? _domainCheckResult;
    private string _selectedTier = StoreDesignPresets.PlanIntermediate;
    private int _durationMonths = 1;
    private string _customerStoreName = string.Empty;
    private string _desiredDomain = string.Empty;
    private string _customerContact = string.Empty;
    private string _giftCardCode = string.Empty;
    private string? _error;
    private string? _successMessage;
    private bool _copiedPlanBrCode;
    private bool _creatingPlanOrder;
    private bool _checkingOrderStatus;
    private PlatformSubscriptionOrderDto? _activePlanOrder;
    private PlatformPlanOrderStatusDto? _planAutoActivatedResult;
    private CancellationTokenSource? _pollingCts;
    private bool _showExistingPlanModal;
    private bool _dismissedInitialExistingPlanModal;
    private bool _confirmedExistingPlanPurchase;

    private ExistingPlanPromptState CurrentPlanPrompt =>
        PlanCheckoutGuardHelper.EvaluatePurchasePrompt(_settings, _selectedTier, _customerStoreName);

    private string? PlanPixBrCode => _activePlanOrder?.PixBrCode;

    private decimal RegularMonthlyPrice => _settings is null ? 0m : _selectedTier switch
    {
        StoreDesignPresets.PlanPremium => _settings.PremiumPlanMonthlyPrice,
        StoreDesignPresets.PlanIntermediate => _settings.IntermediaryPlanMonthlyPrice,
        _ => _settings.BasicPlanMonthlyPrice
    };

    private GoogleAccountTierVerifier.PlanBenefitsBreakdown CurrentBenefits =>
        GoogleAccountTierVerifier.CalculatePlanBenefits(
            RegularMonthlyPrice,
            _useFreeDomainCheaperPlan,
            _settings?.GoogleAccountTier,
            _useOwnDedicatedServer);

    private decimal MonthlyDiscount => CurrentBenefits.TotalMonthlyDiscount;

    private decimal MonthlyPrice => CurrentBenefits.FinalMonthlyPrice;

    private decimal TotalOrderAmount => MonthlyPrice * _durationMonths;

    private string DurationLabel => _durationMonths switch
    {
        3 => "3 meses (90 dias)",
        12 => "1 ano (365 dias)",
        _ => "mês (30 dias)"
    };

    private string? WhatsAppSaleUrl
    {
        get
        {
            if (_settings is null || string.IsNullOrWhiteSpace(_settings.WhatsappNumber))
                return null;

            var digits = new string(_settings.WhatsappNumber.Where(char.IsDigit).ToArray());
            if (digits.Length < 10)
                return null;

            var store = string.IsNullOrWhiteSpace(_customerStoreName) ? _settings.StoreName : _customerStoreName.Trim();
            var domainText = string.IsNullOrWhiteSpace(_desiredDomain) ? "a definir" : _desiredDomain.Trim();
            var contactText = string.IsNullOrWhiteSpace(_customerContact) ? "-" : _customerContact.Trim();
            var hostingText = _useOwnDedicatedServer
                ? $"Meu Servidor Próprio ({_settings.OwnServerProvider})"
                : "Servidor 24h da Plataforma";
            var googleText = _settings.QualifiesForDedicatedServerBenefit
                ? $"Conta Google Pro verificada ({_settings.GoogleAccountEmail})"
                : "Padrão";

            var pixLine = _activePlanOrder is not null
                ? $"\nPedido: {_activePlanOrder.OrderNumber} (Pix: {_activePlanOrder.PixKeyUsed})"
                : string.Empty;

            var msg =
                $"Olá! Quero contratar o {GetPlanTitle(_selectedTier)} ({DurationLabel}) — Total: {TotalOrderAmount:C}.\n" +
                $"Loja: {store}\n" +
                $"Endereço/Domínio (incluso no plano): {domainText}\n" +
                $"Infraestrutura: {hostingText}\n" +
                $"Conta Google: {googleText}\n" +
                $"Usuário/Gmail: {contactText}{pixLine}";

            return $"https://wa.me/{digits}?text={Uri.EscapeDataString(msg)}";
        }
    }

    protected override void OnParametersSet()
    {
        _selectedTier = NormalizeTier(PlanTier);
        if (!string.IsNullOrWhiteSpace(FreeDomainQuery))
        {
            _desiredDomain = FreeDomainQuery.Trim();
            _useFreeDomainCheaperPlan = string.Equals(CheaperQuery, "1", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(CheaperQuery);
        }

        if (string.Equals(OwnServerQuery, "1", StringComparison.OrdinalIgnoreCase))
        {
            _useOwnDedicatedServer = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        if (Gateway.IsAuthenticated)
        {
            await LoadAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async void OnAuthStateChanged()
    {
        if (Gateway.IsAuthenticated)
        {
            await LoadAsync();
        }
        else
        {
            _settings = null;
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _settings = await Gateway.GetPlanCatalogSettingsAsync();
            BrandState.ApplyFromAdminSettings(_settings);

            if (string.IsNullOrWhiteSpace(_customerStoreName))
                _customerStoreName = _settings.StoreName;

            if (string.IsNullOrWhiteSpace(_desiredDomain))
                _desiredDomain = string.IsNullOrWhiteSpace(_settings.OnlineBaseUrl)
                    ? WhatsAppLinkBuilder.GenerateDefaultStoreDomain(_settings.StoreName)
                    : _settings.OnlineBaseUrl;

            if (string.IsNullOrWhiteSpace(_customerContact) && Gateway.CurrentEmployee is not null)
                _customerContact = Gateway.CurrentEmployee.Email ?? Gateway.CurrentEmployee.EffectiveUsername;

            if (string.Equals(_settings.ServerHostingMode, GoogleAccountTierVerifier.HostingModeDedicatedOwnServer, StringComparison.OrdinalIgnoreCase))
                _useOwnDedicatedServer = true;

            var pending = Gateway.GetPendingPlanOrder();
            if (pending is not null)
            {
                var status = await Gateway.CheckAndApplyPendingPlanOrderAsync(pending.OrderNumber, pending.ClaimToken);
                if (status?.IsApproved == true)
                {
                    _planAutoActivatedResult = status;
                    _activePlanOrder = null;
                    _settings = await Gateway.GetPlanCatalogSettingsAsync();
                    BrandState.ApplyFromAdminSettings(_settings);
                }
                else if (status is null || !string.Equals(status.Status, "Cancelado", StringComparison.OrdinalIgnoreCase))
                {
                    _activePlanOrder = pending;
                    _selectedTier = NormalizeTier(pending.PlanTier);
                    _durationMonths = pending.DurationMonths;
                    StartPlanPollingLoop();
                }
            }

            if (_activePlanOrder is null && CurrentPlanPrompt.ShouldPrompt && !_dismissedInitialExistingPlanModal)
            {
                _showExistingPlanModal = true;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectTier(string tier)
    {
        StopPlanPollingLoop();
        _activePlanOrder = null;
        Gateway.ClearPendingPlanOrder();
        _confirmedExistingPlanPurchase = false;
        _selectedTier = tier;
        _error = null;
        Navigation.NavigateTo($"/contratar-plano/{tier}", replace: true);
    }

    private void SelectTierFromModal(string tier)
    {
        _dismissedInitialExistingPlanModal = true;
        _showExistingPlanModal = false;
        SelectTier(tier);
    }

    private void DismissExistingPlanModal()
    {
        _dismissedInitialExistingPlanModal = true;
        _showExistingPlanModal = false;
    }

    private async Task ProceedWithExistingPlanOrderAsync()
    {
        _confirmedExistingPlanPurchase = true;
        _dismissedInitialExistingPlanModal = true;
        _showExistingPlanModal = false;
        await ConfirmDirectMobilePlanOrderAsync();
    }

    private async Task CopyPixKeyAsync()
    {
        var key = _activePlanOrder?.PixKeyUsed;
        if (string.IsNullOrWhiteSpace(key))
            return;

        try
        {
            await Clipboard.Default.SetTextAsync(key);
            _copiedPix = true;
            _successMessage = $"Chave Pix '{key}' copiada para a área de transferência.";
        }
        catch
        {
            _successMessage = $"Copie manualmente a chave Pix: {key}";
        }
    }

    private async Task CopyPlanPixBrCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(PlanPixBrCode))
            return;

        try
        {
            await Clipboard.Default.SetTextAsync(PlanPixBrCode);
            _copiedPlanBrCode = true;
            _successMessage = "Código Pix Copia e Cola copiado! Cole no app do seu banco para pagar.";
        }
        catch
        {
            _successMessage = "Selecione e copie o código Pix Copia e Cola exibido no quadro.";
        }
    }

    private async Task ConfirmDirectMobilePlanOrderAsync()
    {
        if (_settings is null)
            return;

        if (!_confirmedExistingPlanPurchase && CurrentPlanPrompt.ShouldPrompt)
        {
            _showExistingPlanModal = true;
            return;
        }

        _error = null;
        _successMessage = null;
        _planAutoActivatedResult = null;
        _creatingPlanOrder = true;

        try
        {
            var store = string.IsNullOrWhiteSpace(_customerStoreName) ? _settings.StoreName : _customerStoreName.Trim();
            var slug = ClothingStore.Domain.Entities.Category.GenerateSlug(store);
            var domainText = string.IsNullOrWhiteSpace(_desiredDomain) ? $"https://lojas.{slug}.com" : _desiredDomain.Trim();
            var created = await Gateway.CreatePlatformPlanPurchaseOrderAsync(new CreatePlatformPlanOrderRequest(
                PlanTier: _selectedTier,
                DurationMonths: _durationMonths,
                Amount: TotalOrderAmount,
                StoreName: store,
                StoreSlug: slug,
                DesiredDomain: domainText,
                UseOwnDedicatedServer: _useOwnDedicatedServer,
                BuyerUserId: Gateway.CurrentEmployee?.UserId,
                BuyerUsername: Gateway.CurrentEmployee?.Username,
                BuyerEmail: string.IsNullOrWhiteSpace(_customerContact) ? Gateway.CurrentEmployee?.Email : _customerContact.Trim(),
                BuyerFullName: Gateway.CurrentEmployee?.FullName));

            _activePlanOrder = created;
            _copiedPix = false;
            _copiedPlanBrCode = false;
            _successMessage = created.Message;
            StartPlanPollingLoop();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creatingPlanOrder = false;
        }
    }

    private async Task CheckOrderStatusNowAsync()
    {
        if (_activePlanOrder is null)
            return;

        _checkingOrderStatus = true;
        _error = null;
        try
        {
            var status = await Gateway.CheckAndApplyPendingPlanOrderAsync(
                _activePlanOrder.OrderNumber,
                _activePlanOrder.ClaimToken);

            if (status is null)
                return;

            if (status.IsApproved)
            {
                StopPlanPollingLoop();
                _planAutoActivatedResult = status;
                _activePlanOrder = null;
                _settings = await Gateway.GetPlanCatalogSettingsAsync();
                BrandState.ApplyFromAdminSettings(_settings);
                _successMessage = $"🎉 Pagamento Pix do pedido {status.OrderNumber} confirmado! Plano {GetPlanTitle(status.PlanTier)} liberado automaticamente.";
            }
            else if (string.Equals(status.Status, "Cancelado", StringComparison.OrdinalIgnoreCase))
            {
                StopPlanPollingLoop();
                _activePlanOrder = null;
                _error = status.Message;
            }
            else
            {
                _successMessage = status.Message;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _checkingOrderStatus = false;
        }
    }

    private void CancelActivePendingOrder()
    {
        StopPlanPollingLoop();
        _activePlanOrder = null;
        _planAutoActivatedResult = null;
        Gateway.ClearPendingPlanOrder();
        _successMessage = null;
    }

    private void StartPlanPollingLoop()
    {
        StopPlanPollingLoop();
        if (_activePlanOrder is null)
            return;

        var cts = new CancellationTokenSource();
        _pollingCts = cts;
        var orderNumber = _activePlanOrder.OrderNumber;
        var claimToken = _activePlanOrder.ClaimToken;

        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(4));
            try
            {
                while (await timer.WaitForNextTickAsync(cts.Token))
                {
                    var status = await Gateway.CheckAndApplyPendingPlanOrderAsync(orderNumber, claimToken, cts.Token);
                    if (status is null)
                        continue;

                    if (status.IsApproved)
                    {
                        await InvokeAsync(async () =>
                        {
                            StopPlanPollingLoop();
                            _planAutoActivatedResult = status;
                            _activePlanOrder = null;
                            _settings = await Gateway.GetPlanCatalogSettingsAsync();
                            BrandState.ApplyFromAdminSettings(_settings);
                            _successMessage = $"🎉 Pagamento Pix confirmado! Seu plano {GetPlanTitle(status.PlanTier)} foi liberado automaticamente!";
                            StateHasChanged();
                        });
                        break;
                    }

                    if (string.Equals(status.Status, "Cancelado", StringComparison.OrdinalIgnoreCase))
                    {
                        await InvokeAsync(() =>
                        {
                            StopPlanPollingLoop();
                            _activePlanOrder = null;
                            _error = status.Message;
                            StateHasChanged();
                        });
                        break;
                    }
                }
            }
            catch
            {
            }
        }, cts.Token);
    }

    private void StopPlanPollingLoop()
    {
        try
        {
            _pollingCts?.Cancel();
            _pollingCts?.Dispose();
        }
        catch
        {
        }
        finally
        {
            _pollingCts = null;
        }
    }

    private async Task OpenWhatsAppOrderAsync()
    {
        var url = WhatsAppSaleUrl;
        if (string.IsNullOrWhiteSpace(url))
            return;

        try
        {
            await Launcher.Default.OpenAsync(new Uri(url));
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível abrir o WhatsApp automaticamente ({ex.Message}). Copie a chave Pix acima e envie o comprovante para concluir a ativação.";
        }
    }

    private async Task CheckCheckoutDomainAsync()
    {
        if (string.IsNullOrWhiteSpace(_desiredDomain))
            return;

        _isCheckingDomain = true;
        _error = null;
        try
        {
            _domainCheckResult = await Gateway.CheckDomainAvailabilityAsync(_desiredDomain.Trim());
            if (_domainCheckResult.IsAvailable)
            {
                _desiredDomain = _domainCheckResult.Domain;
            }
        }
        catch (Exception ex)
        {
            _error = $"Erro ao verificar disponibilidade do endereço: {ex.Message}";
        }
        finally
        {
            _isCheckingDomain = false;
        }
    }

    private async Task SelectCheckoutSuggestionAsync(string suggestion)
    {
        _desiredDomain = suggestion;
        await CheckCheckoutDomainAsync();
    }

    private async Task SearchFreeDomainsForCheckoutAsync()
    {
        _searchingFreeDomains = true;
        _error = null;
        try
        {
            var query = string.IsNullOrWhiteSpace(_customerStoreName) ? _desiredDomain : _customerStoreName;
            _freeDomainSearch = await Gateway.SearchFreeDomainsAsync(query);
        }
        catch (Exception ex)
        {
            _error = $"Erro ao procurar domínios gratuitos: {ex.Message}";
        }
        finally
        {
            _searchingFreeDomains = false;
        }
    }

    private void UseFreeDomainOfferInCheckout(FreeDomainCandidateDto candidate)
    {
        _desiredDomain = candidate.Domain;
        _useFreeDomainCheaperPlan = true;
        _successMessage = $"🎁 Olha! Domínio gratuito '{candidate.Domain}' aplicado e plano reduzido para {MonthlyPrice:C}/mês!";
    }

    private async Task RedeemGiftCardAsync()
    {
        if (!Gateway.IsAdmin || string.IsNullOrWhiteSpace(_giftCardCode))
            return;

        _redeemingCode = true;
        _error = null;
        _successMessage = null;
        try
        {
            var resp = await Gateway.RedeemActivationCodeAsync(new RedeemActivationCodeRequest
            {
                Code = _giftCardCode.Trim()
            });
            _settings = resp.UpdatedSettings;
            BrandState.ApplyFromAdminSettings(resp.UpdatedSettings);
            _giftCardCode = string.Empty;
            _successMessage = resp.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _redeemingCode = false;
        }
    }

    private static string NormalizeTier(string? candidate)
    {
        if (string.Equals(candidate, StoreDesignPresets.PlanPremium, StringComparison.OrdinalIgnoreCase))
            return StoreDesignPresets.PlanPremium;
        if (string.Equals(candidate, StoreDesignPresets.PlanBasic, StringComparison.OrdinalIgnoreCase))
            return StoreDesignPresets.PlanBasic;
        if (string.Equals(candidate, StoreDesignPresets.PlanIntermediate, StringComparison.OrdinalIgnoreCase))
            return StoreDesignPresets.PlanIntermediate;
        return StoreDesignPresets.PlanIntermediate;
    }

    private static string GetPlanTitle(string tier) => tier switch
    {
        StoreDesignPresets.PlanPremium => "Plano Premium Sob Medida",
        StoreDesignPresets.PlanBasic => "Plano Básico",
        _ => "Plano Intermediário (Meia Versão)"
    };

    private static IReadOnlyList<string> GetPlanFeatures(string tier) => tier switch
    {
        StoreDesignPresets.PlanPremium =>
        [
            "Servidor em nuvem 24h + Certificado HTTPS já inclusos (R$ 0,00 extra)",
            "Domínio / Endereço da loja incluso + opção de domínio próprio sem taxa adicional",
            "Todas as 5 versões pré-prontas incluídas",
            "Vendas normais (Dinheiro, Cartão, WhatsApp) + Pix direto no app (opcional e ativável)",
            "Controle normal de estoque liberado sempre, limite de distância e frete dos Correios",
            "Estúdio Visual completo: paleta, tipografia, bordas e espaçamento livres"
        ],
        StoreDesignPresets.PlanBasic =>
        [
            "Servidor em nuvem 24h + Certificado HTTPS já inclusos (R$ 0,00 extra)",
            "Domínio / Endereço da vitrine já incluído no valor mensal",
            "Layout oficial fixo Minimalista Luxo pronto para usar",
            "Busca rápida, categorias, estoque atualizado e botão WhatsApp"
        ],
        _ =>
        [
            "Servidor em nuvem 24h + Certificado HTTPS já inclusos (R$ 0,00 extra)",
            "Domínio / Endereço da loja já incluído no valor mensal",
            "Escolha livre entre 5 versões pré-prontas de vitrine",
            "Vendas normais (Dinheiro, Cartão, WhatsApp) + Pix direto no app (opcional e ativável)",
            "Visual calibrado e não configurável (troca instantânea com 1 clique)"
        ]
    };

    public void Dispose()
    {
        StopPlanPollingLoop();
        Gateway.AuthStateChanged -= OnAuthStateChanged;
    }
}
