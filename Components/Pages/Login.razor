@page "/login"
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation

<div class="adm-card" style="padding: 1.85rem; box-shadow: 0 20px 40px rgba(0,0,0,0.35);">
    <div style="text-align: center; margin-bottom: 1.4rem;">
        <div style="font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--adm-muted);">
            @_storeName &bull; Gestão &amp; Estoque
        </div>
        <h1 style="font-size: 1.5rem; font-weight: 700; margin: 0.35rem 0;">
            Acesso Administrativo
        </h1>
        <p style="font-size: 0.86rem; color: var(--adm-muted); margin: 0;">
            Entre com seu login e senha para gerenciar produtos, estoque e configurações da loja.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert-banner alert-error">@_errorMessage</div>
    }

    <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
            <label class="adm-label">Login</label>
            <input type="text"
                   class="adm-input"
                   autocomplete="username"
                   @bind="_login"
                   placeholder="admin" />
        </div>

        <div>
            <label class="adm-label">Senha</label>
            <div style="display: flex; gap: 0.4rem;">
                <input type="@(_showPassword ? "text" : "password")"
                       class="adm-input"
                       autocomplete="current-password"
                       @bind="_password"
                       placeholder="admin" />
                <button type="button"
                        class="adm-btn adm-btn-outline"
                        style="padding: 0 0.75rem; flex-shrink: 0;"
                        @onclick="() => _showPassword = !_showPassword">
                    @(_showPassword ? "Ocultar" : "Mostrar")
                </button>
            </div>
        </div>

        <button type="button"
                class="adm-btn adm-btn-primary"
                style="width: 100%; padding: 0.85rem;"
                disabled="@_isBusy"
                @onclick="HandleLoginAsync">
            @(_isBusy ? "Entrando..." : "Entrar no Sistema")
        </button>

        <a href="/loja/@_storeSlug"
           class="adm-btn adm-btn-success"
           style="width: 100%; padding: 0.75rem; text-align: center;">
            Abrir Catálogo Público da Loja (/loja/@_storeSlug)
        </a>
    </div>
</div>

@code {
    private string _login = "admin";
    private string _password = "admin";
    private bool _showPassword;
    private bool _isBusy;
    private string _storeName = "Minha Loja";
    private string _storeSlug = "minha-loja";
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var store = await CatalogService.GetPublicStoreSettingsAsync();
            _storeName = store.StoreName;
            _storeSlug = store.StoreSlug;
        }
        catch
        {
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            await Gateway.LoginAsync(new LoginRequest(_login, _password));
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
