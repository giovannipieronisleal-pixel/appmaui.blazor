@page "/"
@using System.Globalization
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation
@inject ClothingStore.Application.Services.CatalogService CatalogService
@inject StoreBrandStateService BrandState
@implements IDisposable

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.65rem; font-weight: 700; margin: 0;">Dashboard Operacional</h1>
        <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
            Visão geral em tempo real dos produtos, estoque e últimas vendas.
        </p>
    </div>

    <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
        <button type="button" class="adm-btn adm-btn-outline" @onclick="LoadDashboardAsync">
            Atualizar Dados
        </button>
        @if (Gateway.CanManageStock)
        {
            <a href="/estoque" class="adm-btn adm-btn-primary">
                + Registrar Movimentação
            </a>
        }
        @if (Gateway.CanManageProducts)
        {
            <a href="/produtos" class="adm-btn adm-btn-success">
                + Gerenciar Produtos
            </a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (_summary is not null)
{
    <!-- Indicadores Principais (KPIs) -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Produtos Cadastrados</div>
            <div class="kpi-value">@_summary.TotalRegisteredProducts</div>
            <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem;">
                @_summary.TotalVisibleProducts visíveis no catálogo público
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Unidades em Estoque</div>
            <div class="kpi-value" style="color: var(--adm-success);">@_summary.TotalUnitsInStock</div>
            <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem;">
                Soma de todas as variantes ativas
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Estoque Baixo</div>
            <div class="kpi-value" style="color: var(--adm-warning);">@_summary.LowStockVariantsCount</div>
            <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem;">
                Variantes próximas de esgotar
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-label">Sem Estoque (Esgotados)</div>
            <div class="kpi-value" style="color: var(--adm-danger);">@_summary.OutOfStockVariantsCount</div>
            <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem;">
                Variantes com saldo zero
            </div>
        </div>
    </div>

    <div class="adm-dash-status-grid">
        <!-- Visibilidade do Site Público & Plano -->
        @if (_publicStore is not null)
        {
            <section class="adm-card" style="border-left: 4px solid @(_publicStore.IsSiteActive ? "var(--adm-success)" : "var(--adm-danger)");">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.85rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                            <span class="pill-badge @(_publicStore.IsSiteActive ? "pill-green" : "pill-red")">
                                @(_publicStore.IsSiteActive ? "🟢 Site Público Visível" : "🔴 Site Público Oculto / Pausado")
                            </span>
                            <span class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                                @BrandState.EffectivePlanTier
                            </span>
                        </div>
                        <p style="margin: 0; font-size: 0.86rem; color: var(--adm-muted);">
                            @if (_publicStore.IsSiteActive)
                            {
                                <span>A vitrine <strong>@_publicStore.StoreName</strong> está aberta para clientes navegarem e pedirem no WhatsApp.</span>
                            }
                            else
                            {
                                <span>Os clientes veem uma página de loja temporariamente pausada. Reative quando quiser liberar o catálogo.</span>
                            }
                        </p>
                    </div>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="/loja/@_publicStore.StoreSlug" class="adm-btn adm-btn-outline">
                            🌐 Ver como Cliente
                        </a>
                        @if (Gateway.IsAdmin)
                        {
                            <a href="/planos" class="adm-btn adm-btn-outline">
                                💎 Planos
                            </a>
                            <a href="/configuracoes-loja" class="adm-btn adm-btn-primary">
                                🌍 Gerenciar Visibilidade
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        @if (_salesReport is not null)
        {
            <section class="adm-card" style="border-left: 4px solid @(_salesReport.IsUnlocked ? "var(--adm-success)" : "var(--brand-accent, #B69158)");">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.75rem;">
                    <div style="display: flex; flex-direction: column; gap: 0.3rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                            <span class="pill-badge @(_salesReport.IsUnlocked ? "pill-green" : "pill-gold")">
                                @(_salesReport.IsUnlocked ? "💰 Vendas & Faturamento" : "🔒 Vendas nas Versões Pagas")
                            </span>
                        </div>
                        @if (_salesReport.IsUnlocked)
                        {
                            <div style="font-size: 1.35rem; font-weight: 800; color: var(--adm-success);">
                                @_salesReport.Last30DaysConfirmedRevenue.ToString("C", PtBr)
                                <span style="font-size: 0.78rem; color: var(--adm-muted); font-weight: 600;">nos últimos 30 dias</span>
                            </div>
                            <p style="margin: 0; font-size: 0.84rem; color: var(--adm-muted);">
                                Hoje: <strong>@_salesReport.TodayConfirmedRevenue.ToString("C", PtBr)</strong> &bull;
                                Histórico total: <strong>@_salesReport.TotalConfirmedRevenue.ToString("C", PtBr)</strong> (@_salesReport.ConfirmedOrdersCount venda(s))
                            </p>
                        }
                        else
                        {
                            <p style="margin: 0; font-size: 0.85rem; color: var(--adm-muted);">
                                @_salesReport.LockMessage
                            </p>
                        }
                    </div>

                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="/vendas" class="adm-btn @(_salesReport.IsUnlocked ? "adm-btn-success" : "adm-btn-primary")">
                            @(_salesReport.IsUnlocked ? "💰 Ver Quanto Vendeu" : "🔒 Desbloquear Vendas")
                        </a>
                        @if (!_salesReport.IsUnlocked && Gateway.IsAdmin)
                        {
                            <a href="/planos" class="adm-btn adm-btn-outline">💎 Ver Planos</a>
                        }
                    </div>
                </div>
            </section>
        }

    </div>

    <div class="adm-dash-ops-grid">
        <!-- Alertas de Estoque Baixo e Sem Estoque -->
        <section class="adm-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0;">Alertas de Reposição (@_summary.StockAlerts.Count)</h2>
                <a href="/estoque" style="font-size: 0.85rem; color: var(--adm-accent); font-weight: 600; text-decoration: none;">Ir para Estoque &rarr;</a>
            </div>

            @if (_summary.StockAlerts.Count == 0)
            {
                <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0;">
                    Todas as variantes estão com nível de estoque saudável!
                </p>
            }
            else
            {
                <div class="adm-table-wrap">
                    <table class="adm-table">
                        <thead>
                            <tr>
                                <th>Produto / Variante</th>
                                <th>SKU</th>
                                <th>Saldo</th>
                                <th>Status</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var alert in _summary.StockAlerts)
                            {
                                <tr>
                                    <td data-label="Peça">
                                        <div>
                                            <div style="font-weight: 700;">@alert.ProductName</div>
                                            <div style="font-size: 0.82rem; color: var(--adm-muted);">
                                                Cor: @alert.Color &bull; Tam: <strong>@alert.Size</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="SKU" style="font-size: 0.82rem; color: var(--adm-muted);">@alert.Sku</td>
                                    <td data-label="Saldo" style="font-weight: 800;">@alert.StockQuantity un.</td>
                                    <td data-label="Status">
                                        @if (alert.IsOutOfStock)
                                        {
                                            <span class="pill-badge pill-red">Sem estoque</span>
                                        }
                                        else
                                        {
                                            <span class="pill-badge pill-amber">Estoque baixo (&le; @alert.LowStockThreshold)</span>
                                        }
                                    </td>
                                    <td data-label="Ação">
                                        <a href="/produtos/@alert.ProductId" class="adm-btn adm-btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.82rem;">
                                            Editar / Repor
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- Últimas Vendas (compacto: o que vendeu e quem foi) -->
        <section class="adm-card adm-sales-mini-card">
            <div class="adm-sales-mini-header">
                <h2 class="adm-sales-mini-title">Últimas Vendas</h2>
                <a href="@(_salesReport?.IsUnlocked == true ? "/vendas" : "/estoque")" class="adm-sales-mini-link">
                    Ver mais &rarr;
                </a>
            </div>

            @if (_recentSalesFeed.Count == 0)
            {
                <p class="adm-sales-mini-empty">Nenhuma venda registrada ainda.</p>
            }
            else
            {
                <ul class="adm-sales-mini-list">
                    @foreach (var sale in _recentSalesFeed)
                    {
                        <li class="adm-sales-mini-item">
                            <span class="adm-sales-mini-what" title="@sale.WhatSold">@sale.WhatSold</span>
                            <span class="adm-sales-mini-who" title="@sale.Who">@sale.Who</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo PtBr = new("pt-BR");
    private DashboardSummaryDto? _summary;
    private PublicStoreSettingsDto? _publicStore;
    private SalesReportDto? _salesReport;
    private IReadOnlyList<ClothingStore.Shared.Helpers.DashboardCompactSaleItem> _recentSalesFeed = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Gateway.AuthStateChanged += OnAuthStateChanged;
        if (Gateway.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
    }

    private async void OnAuthStateChanged()
    {
        if (Gateway.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
        else
        {
            _summary = null;
            _publicStore = null;
            _salesReport = null;
            _recentSalesFeed = [];
            _error = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDashboardAsync()
    {
        _error = null;
        try
        {
            _summary = await Gateway.GetDashboardSummaryAsync();
            _publicStore = await CatalogService.GetPublicStoreSettingsAsync();
            if (_publicStore is not null)
            {
                BrandState.ApplyFromPublicSettings(_publicStore);
            }
            _salesReport = await Gateway.GetSalesReportAsync("30d");
            _recentSalesFeed = ClothingStore.Shared.Helpers.DashboardRecentSalesHelper.BuildCompactSalesFeed(_summary, _salesReport);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    public void Dispose()
    {
        Gateway.AuthStateChanged -= OnAuthStateChanged;
    }
}
