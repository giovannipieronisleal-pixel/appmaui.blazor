@page "/produtos"
@inject MauiAdminGateway Gateway
@inject NavigationManager Navigation

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h1 style="font-size: 1.65rem; font-weight: 700; margin: 0;">Gerenciamento de Produtos</h1>
        <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
            Cadastre peças, gerencie fotografias, variantes de cor/tamanho e controle a visibilidade no site público.
        </p>
    </div>

    @if (Gateway.CanManageProducts)
    {
        <div style="display: flex; gap: 0.65rem; flex-wrap: wrap;">
            <button type="button" class="adm-btn adm-btn-outline" @onclick="() => _showNewCategoryModal = !_showNewCategoryModal">
                + Nova Categoria
            </button>
            <button type="button" class="adm-btn adm-btn-primary" @onclick="() => _showNewProductModal = !_showNewProductModal">
                + Novo Produto
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success">@_success</div>
}

<!-- Formulário Rápido de Nova Categoria -->
@if (_showNewCategoryModal && Gateway.CanManageProducts)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-primary);">
        <h3 style="margin-top: 0; font-size: 1.05rem;">Cadastrar Nova Categoria de Roupas</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: end;">
            <div>
                <label class="adm-label">Nome da Categoria *</label>
                <input type="text" class="adm-input" @bind="_newCategory.Name" placeholder="Ex.: Saias & Shorts" />
            </div>
            <div>
                <label class="adm-label">Descrição</label>
                <input type="text" class="adm-input" @bind="_newCategory.Description" placeholder="Descrição opcional" />
            </div>
            <div>
                <label class="adm-label">Ordem de Exibição</label>
                <input type="number" class="adm-input" @bind="_newCategory.DisplayOrder" />
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button type="button" class="adm-btn adm-btn-success" @onclick="CreateCategoryAsync">Salvar Categoria</button>
                <button type="button" class="adm-btn adm-btn-outline" @onclick="() => _showNewCategoryModal = false">Cancelar</button>
            </div>
        </div>
    </div>
}

<!-- Formulário Rápido de Novo Produto -->
@if (_showNewProductModal && Gateway.CanManageProducts)
{
    <div class="adm-card" style="border-left: 4px solid var(--adm-success);">
        <h3 style="margin-top: 0; font-size: 1.05rem;">Cadastrar Novo Produto</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
            <div>
                <label class="adm-label">Nome do Produto *</label>
                <input type="text" class="adm-input" @bind="_newProduct.Name" placeholder="Ex.: Jaqueta Jeans Oversized" />
            </div>
            <div>
                <label class="adm-label">Categoria *</label>
                <select class="adm-select" @bind="_newProduct.CategoryId">
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="adm-label">Preço de Venda (R$) *</label>
                <input type="number" step="0.01" class="adm-input" @bind="_newProduct.BasePrice" />
            </div>
            <div style="grid-column: 1 / -1;">
                <label class="adm-label">Descrição da Peça</label>
                <textarea class="adm-textarea" rows="2" @bind="_newProduct.Description" placeholder="Composição do tecido, modelagem e detalhes..."></textarea>
            </div>
            <div style="grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
                    <input type="checkbox" @bind="_newProduct.IsVisibleOnSite" />
                    <span>Exibir imediatamente no site público</span>
                </label>

                <div style="display: flex; gap: 0.5rem;">
                    <button type="button" class="adm-btn adm-btn-success" @onclick="CreateProductAsync">
                        Criar e Configurar Fotos/Variantes &rarr;
                    </button>
                    <button type="button" class="adm-btn adm-btn-outline" @onclick="() => _showNewProductModal = false">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Barra de Busca e Filtros -->
<div class="adm-card" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 220px;">
        <input type="text"
               class="adm-input"
               placeholder="Pesquisar por nome do produto, descrição ou código SKU..."
               @bind="_search"
               @bind:event="oninput"
               @bind:after="LoadProductsAsync" />
    </div>

    <div style="min-width: 200px;">
        <select class="adm-select" @bind="_selectedCategoryId" @bind:after="LoadProductsAsync">
            <option value="">Todas as categorias</option>
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.Name (@cat.ProductCount)</option>
            }
        </select>
    </div>

    <button type="button" class="adm-btn adm-btn-outline" @onclick="LoadProductsAsync">Filtrar</button>
</div>

<!-- Tabela de Produtos -->
<div class="adm-card" style="overflow-x: auto;">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Foto</th>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Variantes</th>
                <th>Estoque Total</th>
                <th>Visível no Site</th>
                <th style="text-align: right;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in _products)
            {
                var coverUrl = prod.Images.FirstOrDefault()?.PublicUrl;
                <tr>
                    <td style="width: 64px;">
                        @if (!string.IsNullOrWhiteSpace(coverUrl))
                        {
                            <img src="@coverUrl" alt="@prod.Name" style="width: 48px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--adm-border);" />
                        }
                        else
                        {
                            <div style="width: 48px; height: 60px; background: #F4F4F5; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: var(--adm-muted);">
                                Sem foto
                            </div>
                        }
                    </td>
                    <td>
                        <div style="font-weight: 700;">@prod.Name</div>
                        <div style="font-size: 0.78rem; color: var(--adm-muted);">/@prod.Slug</div>
                    </td>
                    <td>@prod.CategoryName</td>
                    <td style="font-weight: 600;">@prod.BasePrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                    <td>
                        <span class="pill-badge pill-slate">@prod.Variants.Count combinação(ões)</span>
                    </td>
                    <td>
                        @if (prod.TotalStockQuantity > 0)
                        {
                            <span class="pill-badge pill-green">@prod.TotalStockQuantity un.</span>
                        }
                        else
                        {
                            <span class="pill-badge pill-red">0 un. (Esgotado)</span>
                        }
                    </td>
                    <td>
                        @if (Gateway.CanManageProducts)
                        {
                            <button type="button"
                                    class="adm-btn @(prod.IsVisibleOnSite ? "adm-btn-success" : "adm-btn-outline")"
                                    style="padding: 0.3rem 0.65rem; font-size: 0.76rem;"
                                    @onclick="() => ToggleVisibilityAsync(prod)">
                                @(prod.IsVisibleOnSite ? "Visível no Site" : "Oculto no Site")
                            </button>
                        }
                        else
                        {
                            <span>@(prod.IsVisibleOnSite ? "Sim" : "Não")</span>
                        }
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                        <a href="/produtos/@prod.Id" class="adm-btn adm-btn-primary" style="padding: 0.4rem 0.75rem; font-size: 0.8rem;">
                            Gerenciar Fotos &amp; Variantes
                        </a>
                        @if (Gateway.CanManageProducts)
                        {
                            <button type="button"
                                    class="adm-btn adm-btn-danger"
                                    style="padding: 0.4rem 0.65rem; font-size: 0.8rem; margin-left: 0.35rem;"
                                    @onclick="() => DeleteProductAsync(prod)">
                                Arquivar/Excluir
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private IReadOnlyList<CategoryDto> _categories = [];
    private IReadOnlyList<ProductDetailDto> _products = [];
    private string? _search;
    private string? _selectedCategoryId;

    private bool _showNewCategoryModal;
    private bool _showNewProductModal;
    private SaveCategoryRequest _newCategory = new() { DisplayOrder = 6, IsActive = true };
    private SaveProductRequest _newProduct = new() { BasePrice = 149.90m, IsVisibleOnSite = true };

    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAndProductsAsync();
    }

    private async Task LoadCategoriesAndProductsAsync()
    {
        _error = null;
        try
        {
            _categories = await Gateway.GetCategoriesAsync();
            if (_newProduct.CategoryId == Guid.Empty && _categories.Count > 0)
            {
                _newProduct.CategoryId = _categories[0].Id;
            }
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            Guid? catGuid = Guid.TryParse(_selectedCategoryId, out var parsed) ? parsed : null;
            _products = await Gateway.GetProductsAsync(_search, catGuid);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateCategoryAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var created = await Gateway.CreateCategoryAsync(_newCategory);
            _showNewCategoryModal = false;
            _newCategory = new SaveCategoryRequest { DisplayOrder = _categories.Count + 1, IsActive = true };
            await LoadCategoriesAndProductsAsync();
            _newProduct.CategoryId = created.Id;
            _success = $"Categoria '{created.Name}' criada com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CreateProductAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var created = await Gateway.CreateProductAsync(_newProduct);
            Navigation.NavigateTo($"/produtos/{created.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ToggleVisibilityAsync(ProductDetailDto prod)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.ToggleProductVisibilityAsync(prod.Id, !prod.IsVisibleOnSite);
            await LoadProductsAsync();
            _success = $"Visibilidade de '{prod.Name}' atualizada no catálogo público.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task DeleteProductAsync(ProductDetailDto prod)
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.DeleteOrArchiveProductAsync(prod.Id);
            await LoadProductsAsync();
            _success = $"Produto '{prod.Name}' arquivado/removido com sucesso.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}

