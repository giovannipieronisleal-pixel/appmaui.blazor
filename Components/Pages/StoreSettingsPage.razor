@page "/configuracoes-loja"
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ThemeService Theme
@inject StoreBrandStateService BrandState
@inject GoogleCloudSyncService CloudSync

@{
    var effectiveSlug = string.IsNullOrWhiteSpace(_form.StoreSlug)
        ? WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName)
        : WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreSlug);

    var baseSiteUrl = !string.IsNullOrWhiteSpace(_form.OnlineBaseUrl)
        ? _form.OnlineBaseUrl.TrimEnd('/')
        : WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);

    var storeCatalogUrl = WhatsAppLinkBuilder.BuildStoreCatalogUrl(baseSiteUrl, effectiveSlug);
    var qrCodeSvgUri = WhatsAppLinkBuilder.GenerateQrCodeSvgDataUri(storeCatalogUrl);
}

<div style="margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; margin: 0; color: var(--adm-text);">Configurações da Loja &amp; Catálogo</h1>
    <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
        Personalize o nome da loja, tema visual (Claro/Escuro), WhatsApp e compartilhe o link do seu catálogo com seus clientes.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success">@_success</div>
}

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.25rem; align-items: start;">
    <!-- Coluna Esquerda: Tema do App + Identidade da Loja -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <!-- Card 1: Aparência e Tema do Aplicativo (Android) -->
        <section class="adm-card" style="border-left: 4px solid var(--adm-accent);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🎨 Tema do Aplicativo (Modo Claro &amp; Escuro)
                </h2>
                <span class="pill-badge pill-blue">Android</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--adm-muted); margin-top: 0; margin-bottom: 0.75rem;">
                Escolha a aparência visual do aplicativo de acordo com a sua preferência:
            </p>

            <div class="theme-selector-grid">
                <div class="theme-card-option @(Theme.ThemePreference == "system" ? "active" : "")"
                     @onclick='() => ChangeTheme("system")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌓</div>
                    <div>Automático</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Segue o Android</div>
                </div>

                <div class="theme-card-option @(Theme.ThemePreference == "light" ? "active" : "")"
                     @onclick='() => ChangeTheme("light")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">☀️</div>
                    <div>Modo Claro</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Fundo Branco</div>
                </div>

                <div class="theme-card-option @(Theme.ThemePreference == "dark" ? "active" : "")"
                     @onclick='() => ChangeTheme("dark")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌙</div>
                    <div>Modo Escuro</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">OLED / Alto Contraste</div>
                </div>
            </div>
        </section>

        <!-- Card 2: Dados da Loja e Contato -->
        <section class="adm-card">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; color: var(--adm-text);">
                🏪 Identidade da Loja &amp; WhatsApp
            </h2>

            <div style="display: flex; flex-direction: column; gap: 1.1rem;">
                <div>
                    <label class="adm-label">Nome da Loja *</label>
                    <input type="text"
                           class="adm-input"
                           @bind="_form.StoreName"
                           @bind:event="oninput"
                           @bind:after="SyncSlugFromStoreNameIfUnlocked"
                           placeholder="Ex.: Minha Loja" />
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                        <label class="adm-label" style="margin: 0;">Endereço do Link da Loja (Final da URL) *</label>
                        <label style="font-size: 0.76rem; color: var(--adm-muted); display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
                            <input type="checkbox" @bind="_autoSyncSlugWithName" />
                            <span>Sincronizar com o nome</span>
                        </label>
                    </div>
                    <input type="text" class="adm-input" @bind="_form.StoreSlug" placeholder="minha-loja" />
                    <span style="font-size: 0.78rem; color: var(--adm-muted);">
                        Link oficial do catálogo: <strong style="color: var(--adm-accent);">@storeCatalogUrl</strong>
                    </span>
                </div>

                <div>
                    <label class="adm-label">Número do WhatsApp (DDD + Celular) *</label>
                    <input type="text" class="adm-input" @bind="_form.WhatsappNumber" placeholder="Ex.: 11999990000" />
                    <span style="font-size: 0.78rem; color: var(--adm-muted);">
                        Pode digitar apenas o DDD + número (ex.: <strong>11999990000</strong>). O código do Brasil (+55) é inserido automaticamente!
                    </span>
                </div>

                <div>
                    <label class="adm-label">Descrição e Bio da Loja *</label>
                    <textarea class="adm-textarea" rows="3" @bind="_form.StoreDescription" placeholder="Apresentação exibida para os clientes no catálogo online..."></textarea>
                </div>

                <div>
                    <label class="adm-label">Alerta de Estoque Baixo (avisa quando restar menos de quantas unidades)</label>
                    <input type="number" min="0" class="adm-input" @bind="_form.DefaultLowStockThreshold" />
                </div>

                <button type="button" class="adm-btn adm-btn-success" style="padding: 0.85rem; font-size: 0.95rem; font-weight: 700;" @onclick="SaveSettingsAsync">
                    💾 Salvar Configurações da Loja
                </button>
            </div>
        </section>
    </div>

    <!-- Coluna Direita: Link Oficial da Loja + QR Code + Logotipo -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <!-- Card 2.5: Status do Site do Usuário (Ativo / Desativado por Nome ou Inatividade) -->
        <section class="adm-card" style="border-left: 4px solid @(_form.IsSiteActive ? "var(--adm-success)" : "var(--adm-danger)");">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🌍 Visibilidade do Site para o Público
                </h2>
                <span class="pill-badge @(_form.IsSiteActive ? "pill-green" : "pill-red")" style="font-weight: 800;">
                    @(_form.IsSiteActive ? "🟢 Visível para Clientes" : "🔴 Oculto / Pausado")
                </span>
            </div>

            @if (_form.IsSiteActive)
            {
                <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0 0 0.75rem; line-height: 1.45;">
                    Seu catálogo público está <strong>no ar e visível</strong> para qualquer cliente que acessar o link.
                    <strong>Atenção:</strong> após 21 dias sem movimentação ou ao trocar o nome da loja, ele pausa automaticamente até você confirmar aqui.
                </p>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--adm-muted); flex-wrap: wrap; gap: 0.5rem;">
                    <span>Última movimentação: <strong>@(_form.LastActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Hoje")</strong></span>
                    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                        <a href="/loja/@_form.StoreSlug" class="adm-btn adm-btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.76rem;">
                            👁️ Ver como Cliente
                        </a>
                        <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.76rem;" @onclick="DeactivateSiteNowAsync">
                            Ocultar Site
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--adm-danger); border-radius: 8px; padding: 0.85rem; margin-bottom: 0.85rem; color: var(--adm-text);">
                    <div style="font-weight: 800; color: var(--adm-danger); margin-bottom: 0.25rem;">
                        ⚠️ Motivo da Desativação:
                    </div>
                    <div style="font-size: 0.84rem; line-height: 1.45;">
                        @(_form.DeactivationReason ?? "O site foi pausado automaticamente.")
                    </div>
                </div>
                <button type="button"
                        class="adm-btn adm-btn-primary"
                        style="width: 100%; padding: 0.75rem; font-weight: 800; font-size: 0.95rem;"
                        @onclick="ActivateSiteNowAsync">
                    🚀 Reativar e Publicar Meu Site Agora
                </button>
            }
        </section>

        <!-- Card 3: Link Oficial do Catálogo da Sua Loja -->
        <section class="adm-card" style="border-left: 4px solid var(--adm-success);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🌐 Link Oficial do Catálogo da Sua Loja
                </h2>
                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                    <span class="pill-badge pill-green">🟢 Catálogo Pronto</span>
                    <span class="pill-badge pill-blue">Servidor + Domínio Inclusos</span>
                </div>
            </div>

            <p style="font-size: 0.85rem; color: var(--adm-muted); margin-top: 0; margin-bottom: 0.85rem; line-height: 1.45;">
                Este é o link oficial exclusivo da sua loja (<strong>servidor em nuvem + HTTPS + endereço já inclusos no seu plano</strong>, sem taxa extra)! Compartilhe com suas clientes ou divulgue nas redes sociais:
            </p>

            <div style="background: var(--adm-input-bg); border: 1.5px solid var(--adm-border); border-radius: 8px; padding: 0.85rem 1rem; font-family: monospace; font-size: 0.95rem; font-weight: 700; word-break: break-all; margin-bottom: 0.45rem; color: var(--adm-accent);">
                @storeCatalogUrl
            </div>
            <div style="font-size: 0.76rem; color: var(--adm-muted); margin-bottom: 0.95rem; line-height: 1.4;">
                🌐 <em>Link exclusivo para suas redes sociais. Ao clicar em <strong>"Abrir no Navegador"</strong>, seu catálogo abre na hora localmente sem erro de DNS!</em>
            </div>

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
                <button type="button" class="adm-btn adm-btn-primary" style="flex: 1; min-width: 140px;" @onclick="() => CopyStoreUrlAsync(storeCatalogUrl)">
                    @(_copiedUrl ? "✓ Link Copiado!" : "📋 Copiar Link")
                </button>

                <button type="button" class="adm-btn adm-btn-success" style="flex: 1; min-width: 160px;" @onclick="() => ShareOnWhatsAppAsync(storeCatalogUrl)">
                    💬 Enviar no WhatsApp
                </button>

                <a href="/loja/@effectiveSlug" class="adm-btn adm-btn-outline" style="min-width: 110px;">
                    👁️ Ver no App
                </a>

                <button type="button" class="adm-btn adm-btn-outline" style="min-width: 140px;" @onclick="() => OpenBrowserAsync(storeCatalogUrl)">
                    Abrir no Navegador &nearr;
                </button>
            </div>

            <!-- QR Code do Balcão e Sacolas -->
            <div style="display: flex; align-items: center; gap: 1.25rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem; flex-wrap: wrap;">
                <img src="@qrCodeSvgUri" alt="QR Code da Loja" style="width: 110px; height: 110px; border-radius: 8px; background: #FFFFFF; padding: 4px;" />
                <div style="flex: 1; min-width: 170px;">
                    <div style="font-weight: 800; font-size: 0.95rem; color: var(--adm-text);">📱 QR Code do Balcão &amp; Sacolas</div>
                    <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem; line-height: 1.4;">
                        Imprima e coloque no balcão ou nas etiquetas das roupas: suas clientes apontam a câmera do celular e abrem o catálogo na hora!
                    </div>
                </div>
            </div>
        </section>

        <!-- Card 4: Logotipo da Loja -->
        <section class="adm-card">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin-top: 0; margin-bottom: 0.75rem; color: var(--adm-text);">
                🖼️ Logotipo da Loja (Opcional)
            </h2>

            @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
            {
                <div style="padding: 1rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 8px; display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <img src="@_form.LogoPublicUrl" alt="Logotipo" style="height: 52px; max-width: 160px; object-fit: contain;" />
                    <span style="font-weight: 700; font-size: 1.1rem; color: var(--adm-text);">@_form.StoreName</span>
                </div>
            }
            else
            {
                <div style="padding: 1rem; background: var(--adm-input-bg); border: 1px dashed var(--adm-border); border-radius: 8px; color: var(--adm-muted); font-size: 0.88rem; margin-bottom: 1rem;">
                    Nenhum logotipo configurado (o catálogo exibirá o nome <strong>@_form.StoreName</strong> em destaque).
                </div>
            }

            <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                <button type="button" class="adm-btn adm-btn-primary" @onclick="PickAndUploadLogoAsync">
                    📷 Enviar Logotipo do Celular
                </button>
                @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
                {
                    <button type="button" class="adm-btn adm-btn-danger" @onclick="RemoveLogoAsync">
                        Remover Logotipo
                    </button>
                }
            </div>
        </section>

        <!-- Card 5: Opções Avançadas (Discreto e Opcional para Administradores) -->
        <details style="background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem 1rem;">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.86rem; color: var(--adm-muted); user-select: none;">
                ⚙️ Opções Avançadas de Domínio / Nuvem (Opcional)
            </summary>
            <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.85rem;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.45rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
                        <label class="adm-label" style="margin: 0;">Endereço Base / Domínio do Site</label>
                        <span class="pill-badge pill-green">Incluso no Plano (R$ 0,00 extra)</span>
                    </div>
                    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                        <input type="text"
                               class="adm-input"
                               style="flex: 1 1 200px; min-width: 0;"
                               @bind="_domainInput"
                               placeholder="Ex.: lojas.minhaloja.com ou minha-loja" />
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="white-space: nowrap; padding: 0 0.85rem; font-size: 0.82rem; border-color: var(--adm-accent); font-weight: 700; flex: 0 1 auto;"
                                disabled="@_isCheckingDomain"
                                @onclick="CheckDomainAvailabilityAsync">
                            @(_isCheckingDomain ? "Consultando..." : "🔍 Verificar Google Cloud")
                        </button>
                        <button type="button"
                                class="adm-btn adm-btn-accent"
                                style="white-space: nowrap; padding: 0 0.85rem; font-size: 0.82rem; font-weight: 700; flex: 0 1 auto;"
                                disabled="@_isSearchingFreeDomains"
                                @onclick="SearchFreeDomainsInSettingsAsync">
                            @(_isSearchingFreeDomains ? "Buscando..." : "🎁 Buscar Domínios Grátis")
                        </button>
                    </div>

                    @if (_freeDomainSearch?.FeaturedOffer is not null)
                    {
                        var freeOffer = _freeDomainSearch.FeaturedOffer;
                        <div style="margin-top: 0.55rem; padding: 0.7rem 0.9rem; border-radius: 9px; background: rgba(22,163,74,0.1); border: 1.5px solid var(--adm-success);">
                            <div style="font-weight: 800; font-size: 0.84rem; color: var(--adm-success);">
                                🎁 Olha! Este domínio está disponível gratuitamente: <code>@freeOffer.Domain</code>
                            </div>
                            <div style="font-size: 0.78rem; color: var(--adm-text); margin-top: 0.2rem;">
                                Deseja usar ele gratuitamente (<strong>@freeOffer.ProviderName</strong>) e ter um <strong>plano mais barato</strong> (economia de @FreeDomainFinder.DefaultMonthlyDiscountWithFreeDomain.ToString("C", new System.Globalization.CultureInfo("pt-BR"))/mês)?
                            </div>
                            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.45rem; align-items: center;">
                                @foreach (var cand in _freeDomainSearch.Candidates.Where(c => c.IsAvailable).Take(5))
                                {
                                    <button type="button"
                                            class="pill-badge @(string.Equals(_domainInput, cand.Domain, StringComparison.OrdinalIgnoreCase) ? "pill-gold" : "pill-green")"
                                            style="border: none; cursor: pointer; padding: 0.22rem 0.55rem; font-size: 0.75rem;"
                                            @onclick="() => UseFreeDomainCandidateAsync(cand)">
                                        ✓ Usar @cand.Domain
                                    </button>
                                }
                                <a href="/contratar-plano/@(string.IsNullOrWhiteSpace(_form.PlanTier) ? "Basico" : _form.PlanTier)?freeDomain=@Uri.EscapeDataString(freeOffer.Domain)&cheaper=1"
                                   class="pill-badge pill-gold"
                                   style="text-decoration: none; padding: 0.24rem 0.6rem; font-size: 0.75rem;">
                                    💰 Contratar Plano Mais Barato →
                                </a>
                            </div>
                        </div>
                    }

                    @if (_domainInput.EndsWith(".duckdns.org", StringComparison.OrdinalIgnoreCase))
                    {
                        <div style="margin-top: 0.55rem; padding: 0.65rem 0.85rem; border-radius: 8px; background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); display: flex; flex-direction: column; gap: 0.45rem;">
                            <div style="font-size: 0.78rem; font-weight: 700;">
                                🦆 Sincronização Gratuita via API DuckDNS (Opcional)
                            </div>
                            <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                                <input type="text" class="adm-input" style="flex: 1 1 180px;" @bind="_duckDnsToken" placeholder="Seu Token gratuito de duckdns.org" />
                                <input type="text" class="adm-input" style="flex: 0 1 140px;" @bind="_duckDnsIp" placeholder="IP (opcional)" />
                                <button type="button"
                                        class="adm-btn adm-btn-outline"
                                        style="font-size: 0.78rem;"
                                        disabled="@_isSyncingDuckDns"
                                        @onclick="SyncDuckDnsNowAsync">
                                    @(_isSyncingDuckDns ? "Atualizando..." : "Atualizar IP DuckDNS")
                                </button>
                            </div>
                        </div>
                    }

                    @if (_domainCheckResult is not null)
                    {
                        <div style="margin-top: 0.5rem; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.82rem; @(_domainCheckResult.IsAvailable ? "background: rgba(34,197,94,0.12); border: 1px solid var(--adm-success); color: var(--adm-success);" : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger); color: var(--adm-danger);")">
                            <div style="font-weight: 700;">
                                @(_domainCheckResult.IsAvailable ? "✓ " + _domainCheckResult.Message : "✕ " + _domainCheckResult.Message)
                            </div>
                            <div style="font-size: 0.76rem; margin-top: 0.25rem;">
                                @if (_domainCheckResult.IsAvailable)
                                {
                                    <div>URL que será configurada: <strong>@_domainCheckResult.NormalizedUrl</strong></div>
                                }
                                else if (_domainCheckResult.Suggestions.Count > 0)
                                {
                                    <div style="margin-bottom: 0.2rem;">Sugestões disponíveis no Google Cloud (toque para aplicar):</div>
                                    <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                        @foreach (var s in _domainCheckResult.Suggestions)
                                        {
                                            <button type="button"
                                                    class="pill-badge pill-blue"
                                                    style="border: none; cursor: pointer; padding: 0.2rem 0.5rem; font-size: 0.75rem;"
                                                    @onclick="() => SelectDomainSuggestion(s)">
                                                @s
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <span style="font-size: 0.75rem; color: var(--adm-muted);">
                            Servidor e subdomínio padrão da sua vitrine já estão inclusos no plano. O vínculo de domínio próprio é opcional.
                        </span>
                    }
                </div>

                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer;">
                    <input type="checkbox" @bind="_form.AutoSyncOnlineOnSave" />
                    <span>Sincronizar dados automaticamente ao salvar roupas ou categorias</span>
                </label>

                @if (_form.LastOnlineSyncAt.HasValue)
                {
                    <div style="font-size: 0.78rem; color: var(--adm-muted);">
                        Última sincronização com nuvem: <strong>@_form.LastOnlineSyncAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong>
                    </div>
                }

                <div>
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="font-size: 0.8rem; padding: 0.4rem 0.75rem;"
                            disabled="@CloudSync.IsSyncing"
                            @onclick="SyncToCloudNowAsync">
                        @(CloudSync.IsSyncing ? "⏳ Sincronizando..." : "🔄 Forçar Sincronização com Nuvem")
                    </button>
                </div>
            </div>
        </details>
    </div>
</div>

<!-- Card: Meu Servidor Próprio (BYO Server — Google Cloud Run / Render / Fly.io) -->
<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid #2563EB;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: #2563EB;">
                Infraestrutura Dedicada (Opcional)
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 800; margin: 0.2rem 0 0; color: var(--adm-text);">
                ☁️ Meu Servidor Próprio (Google Cloud Run / Render / Fly.io)
            </h2>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.25rem 0 0; line-height: 1.45;">
                Conecte uma instância exclusiva da sua loja rodando na <strong>sua própria conta Google Cloud Run</strong>, Render ou Fly.io. Reduz em <strong>-R$ 10,00/mês</strong> os planos pagos!
            </p>
        </div>
        <div>
            @if (string.Equals(_serverHostingMode, "DedicatedOwnServer", StringComparison.OrdinalIgnoreCase))
            {
                <span class="pill-badge pill-green">✓ Servidor Próprio Ativo (@_ownServerProvider)</span>
            }
            else
            {
                <span class="pill-badge pill-gold">Modo Padrão da Plataforma</span>
            }
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.85rem;">
        <div class="adm-field">
            <label class="adm-label">Modo de Hospedagem do Catálogo</label>
            <select class="adm-input" @bind="_serverHostingMode">
                <option value="PlatformShared">Servidor da Plataforma (Já Incluso)</option>
                <option value="DedicatedOwnServer">Meu Servidor Próprio Exclusivo (-R$ 10/mês)</option>
            </select>
        </div>

        <div class="adm-field">
            <label class="adm-label">Provedor do Servidor Próprio</label>
            <select class="adm-input" @bind="_ownServerProvider">
                <option value="GoogleCloudRun">Google Cloud Run (Nível Gratuito)</option>
                <option value="Render">Render Web Service (Free Tier)</option>
                <option value="FlyIo">Fly.io App</option>
                <option value="VPSPropria">VPS Própria / Docker</option>
                <option value="Outro">Outro Provedor HTTPS</option>
            </select>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.85rem; margin-top: 0.75rem;">
        <div class="adm-field">
            <label class="adm-label">URL HTTPS do Seu Servidor</label>
            <input type="text" class="adm-input" @bind="_form.OnlineBaseUrl"
                   placeholder="https://minhaloja-xxxxxx.a.run.app" />
            <span style="font-size: 0.73rem; color: var(--adm-muted);">
                Endpoint usado para publicar o catálogo público e receber sincronizações em <code>/api/cloud/sync-state</code>.
            </span>
        </div>

        <div class="adm-field">
            <label class="adm-label">
                Chave Secreta de Sincronização (X-YouLink-Sync-Key)
                @if (_hasOwnServerSyncSecret)
                {
                    <span class="pill-badge pill-green" style="margin-left: 0.35rem; font-size: 0.68rem;">Salva</span>
                }
            </label>
            <input type="password" class="adm-input" @bind="_ownServerSyncSecretInput"
                   placeholder="@(_hasOwnServerSyncSecret ? "•••••••• (preencha só se quiser trocar)" : "Defina igual à env YOULINK_SYNC_SECRET")" />
            <span style="font-size: 0.73rem; color: var(--adm-muted);">
                Obrigatória para o app enviar produtos ao seu servidor remoto sem precisar de senha admin.
            </span>
        </div>
    </div>

    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.85rem;">
        <button type="button"
                class="adm-btn adm-btn-primary"
                disabled="@_savingHosting"
                @onclick="SaveHostingAndGoogleSettingsAsync">
            @(_savingHosting ? "⏳ Salvando..." : "💾 Salvar Servidor Próprio")
        </button>

        <button type="button"
                class="adm-btn adm-btn-outline"
                disabled="@_testingOwnServer"
                @onclick="TestOwnServerNowAsync">
            @(_testingOwnServer ? "⏳ Testando..." : "⚡ Testar Conexão Agora")
        </button>

        @if (_hasOwnServerSyncSecret)
        {
            <button type="button"
                    class="adm-btn adm-btn-outline"
                    style="color: var(--adm-danger);"
                    disabled="@_savingHosting"
                    @onclick="ClearOwnServerSyncSecretAsync">
                ✕ Limpar Sync Key
            </button>
        }
    </div>

    @if (_ownServerTestResult is not null)
    {
        <div style="margin-top: 0.75rem; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.82rem; @(_ownServerTestResult.IsOnline ? "background: rgba(34,197,94,0.12); border: 1px solid var(--adm-success); color: var(--adm-success);" : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger); color: var(--adm-danger);")">
            <strong>@(_ownServerTestResult.IsOnline ? "✓ " : "✕ ")@_ownServerTestResult.StatusMessage</strong>
        </div>
    }

    <details style="margin-top: 0.85rem; font-size: 0.8rem; color: var(--adm-muted);">
        <summary style="cursor: pointer; font-weight: 700; color: var(--adm-text);">
            📖 Passo a passo rápido: como subir seu servidor gratuito em 3 minutos
        </summary>
        <ol style="margin: 0.5rem 0 0; padding-left: 1.25rem; line-height: 1.55;">
            <li><strong>Google Cloud Run (Cota Gratuita mensal):</strong> No repositório oficial, rode <code>.\deploy-google-cloud.ps1</code> escolhendo uma chave em <code>YOULINK_SYNC_SECRET</code> e cole a URL <code>https://...run.app</code> acima.</li>
            <li><strong>Render ou Fly.io:</strong> Faça deploy do container <code>Dockerfile</code> (projeto <code>ClothingStore.Api</code>) com a variável <code>YOULINK_SYNC_SECRET</code> e cole o endereço HTTPS gerado.</li>
            <li>Clique em <strong>Testar Conexão Agora</strong> e depois em <strong>Forçar Sincronização com Nuvem</strong> para enviar suas roupas!</li>
        </ol>
    </details>
</section>

<!-- Card: Verificação de Conta Google (Google One Pro / Workspace) -->
<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid #7C3AED;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: #7C3AED;">
                Identidade &amp; Benefícios Google OAuth 2.0
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 800; margin: 0.2rem 0 0; color: var(--adm-text);">
                🔐 Verificar Nível da Conta Google (Google Pro / Workspace)
            </h2>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.25rem 0 0; line-height: 1.45;">
                Conecte sua conta Google via OAuth 2.0 oficial para comprovar cota do Google Drive (&gt; 15 GB / 1 TB+ do Google One Pro / AI Pro) ou domínio Google Workspace e liberar <strong>-R$ 5,00/mês extras</strong> + selo Pro.
            </p>
        </div>
        <div>
            @if (_qualifiesForDedicatedBenefit)
            {
                <span class="pill-badge pill-green">✓ Benefício Conta Pro Ativo (-R$ 5/mês)</span>
            }
            else if (!string.IsNullOrWhiteSpace(_googleAccountEmail))
            {
                <span class="pill-badge pill-gold">@GoogleAccountTierVerifier.GetTierFriendlyLabel(_googleAccountTier)</span>
            }
            else
            {
                <span class="pill-badge">Não verificada</span>
            }
        </div>
    </div>

    <div style="padding: 0.7rem 0.9rem; border-radius: 8px; background: var(--adm-surface-subtle); border: 1px solid var(--adm-border); font-size: 0.79rem; color: var(--adm-muted); line-height: 1.45; margin-bottom: 0.9rem;">
        <strong>Transparência técnica:</strong> O Google não possui uma API de consumidor para ler o nome do plano "Google AI Pro" nem libera servidores de hospedagem dentro da assinatura Google One. A verificação lê de forma real o e-mail/domínio Workspace (<code>userinfo</code>) e a cota total do Google Drive (<code>drive/v3/about</code>). Contas com <strong>1 TB+ no Drive</strong> ou <strong>Google Workspace</strong> qualificam para o selo Pro.
    </div>

    @if (!string.IsNullOrWhiteSpace(_googleAccountEmail))
    {
        <div style="padding: 0.85rem 1rem; border-radius: 10px; margin-bottom: 0.9rem; @(_qualifiesForDedicatedBenefit ? "background: rgba(22,163,74,0.1); border: 1.5px solid var(--adm-success);" : "background: var(--adm-surface-subtle); border: 1px solid var(--adm-border);")">
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <div>
                    <div style="font-weight: 800; font-size: 0.95rem; color: var(--adm-text);">
                        @(_qualifiesForDedicatedBenefit ? "👑 Conta Google Pro / Workspace Verificada" : "✓ Conta Google Verificada")
                    </div>
                    <div style="font-size: 0.83rem; margin-top: 0.2rem;">
                        <strong>E-mail:</strong> @_googleAccountEmail
                        @if (!string.IsNullOrWhiteSpace(_googleHostedDomain))
                        {
                            <span> • <strong>Workspace:</strong> @_googleHostedDomain</span>
                        }
                    </div>
                    <div style="font-size: 0.81rem; color: var(--adm-muted); margin-top: 0.15rem;">
                        <strong>Nível:</strong> @GoogleAccountTierVerifier.GetTierFriendlyLabel(_googleAccountTier)
                        • <strong>Cota Drive:</strong> @GoogleAccountTierVerifier.FormatStorageQuota(_googleDriveQuotaBytes, !string.IsNullOrWhiteSpace(_googleHostedDomain))
                        @if (_googleAccountVerifiedAt.HasValue)
                        {
                            <span> • Verificada em @_googleAccountVerifiedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </div>
                </div>
                <button type="button"
                        class="adm-btn adm-btn-outline"
                        style="color: var(--adm-danger); font-size: 0.78rem;"
                        disabled="@_verifyingGoogle"
                        @onclick="ClearGoogleVerificationAsync">
                    ✕ Remover Verificação
                </button>
            </div>
        </div>
    }

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.9rem;">
        <!-- Modo 1: Login via Navegador (OAuth PKCE) -->
        <div style="padding: 0.85rem; border-radius: 10px; border: 1px solid var(--adm-border); background: var(--adm-surface-subtle); display: flex; flex-direction: column; gap: 0.55rem;">
            <div style="font-weight: 700; font-size: 0.86rem;">Opção 1 — Login Google no Navegador (PKCE)</div>
            <input type="text" class="adm-input" @bind="_googleOAuthClientId"
                   placeholder="Seu Google OAuth Client ID (Desktop/App)" />
            <span style="font-size: 0.73rem; color: var(--adm-muted);">
                Abre a tela oficial de login do Google e recebe o retorno automático neste aparelho.
            </span>
            <div>
                <button type="button"
                        class="adm-btn adm-btn-primary"
                        style="font-size: 0.82rem;"
                        disabled="@_verifyingGoogle"
                        @onclick="VerifyGoogleViaBrowserAsync">
                    @(_verifyingGoogle ? "⏳ Aguardando Google..." : "🌐 Verificar via Login Google")
                </button>
            </div>
        </div>

        <!-- Modo 2: Access Token direto (OAuth Playground / Celular) -->
        <div style="padding: 0.85rem; border-radius: 10px; border: 1px solid var(--adm-border); background: var(--adm-surface-subtle); display: flex; flex-direction: column; gap: 0.55rem;">
            <div style="font-weight: 700; font-size: 0.86rem;">Opção 2 — Colar Access Token Google (Rápido / Mobile)</div>
            <input type="password" class="adm-input" @bind="_googleAccessTokenInput"
                   placeholder="Cole aqui o Access Token (ya29....)" />
            <span style="font-size: 0.73rem; color: var(--adm-muted);">
                Sem Client ID? Gere em <a href="https://developers.google.com/oauthplayground" target="_blank" rel="noopener">Google OAuth Playground</a> com escopos <code>userinfo.email</code> e <code>drive.readonly</code>.
            </span>
            <div>
                <button type="button"
                        class="adm-btn adm-btn-accent"
                        style="font-size: 0.82rem;"
                        disabled="@_verifyingGoogle"
                        @onclick="VerifyGoogleByTokenAsync">
                    @(_verifyingGoogle ? "⏳ Verificando..." : "🔍 Verificar Token Agora")
                </button>
            </div>
        </div>
    </div>

    @if (_googleVerifyResult is not null)
    {
        <div style="margin-top: 0.75rem; padding: 0.7rem 0.9rem; border-radius: 8px; font-size: 0.82rem; @(_googleVerifyResult.Success ? (_googleVerifyResult.QualifiesForDedicatedServerBenefit ? "background: rgba(22,163,74,0.12); border: 1px solid var(--adm-success); color: var(--adm-success);" : "background: rgba(59,130,246,0.1); border: 1px solid #3B82F6; color: var(--adm-text);") : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger); color: var(--adm-danger);")">
            <strong>@(_googleVerifyResult.Success ? "✓ " : "✕ ")@_googleVerifyResult.Message</strong>
        </div>
    }
</section>

<!-- Card: Vendas por Pix no App, Raio de Distância e Calculadora Correios -->
<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid #16A34A;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: #16A34A;">
                Exclusivo Meia Versão &amp; Premium
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 800; margin: 0.2rem 0 0; color: var(--adm-text);">
                💸 Vendas pelo App apenas por Pix, Distância &amp; Correios
            </h2>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0.25rem 0 0; line-height: 1.45;">
                Ative para o cliente comprar direto pelo catálogo usando <strong>apenas Pix</strong> (sem CNPJ/cartão), informando o endereço completo dele. Você define até onde entrega e consulta na hora quanto custará enviar pelos Correios.
            </p>
        </div>
        <div>
            @if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
            {
                <span class="pill-badge pill-slate">🔒 Plano Básico</span>
            }
            else if (_pixEnabled && ClothingStore.Shared.Helpers.PixPayloadBuilder.IsValidPixKey(_storePixKey) && ClothingStore.Shared.Helpers.BrazilShippingCalculator.TrySanitizeCep(_originCep, out _))
            {
                <span class="pill-badge pill-green">🟢 Vendas Pix Ativas no App</span>
            }
            else
            {
                <span class="pill-badge pill-gold">⚙️ Desativado / Falta Configurar</span>
            }
        </div>
    </div>

    @if (!BrandState.IsIntermediatePlan && !BrandState.IsPremiumPlan)
    {
        <div style="background: var(--adm-input-bg); border: 1px dashed var(--adm-border); border-radius: 10px; padding: 1rem;">
            <div style="font-weight: 700; margin-bottom: 0.35rem; color: var(--adm-text);">
                Recurso liberado a partir da Meia Versão (Intermediário) até a Premium
            </div>
            <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0 0 0.85rem; line-height: 1.45;">
                No Plano Básico as clientes consultam você pelo WhatsApp. Na <strong>Meia Versão</strong> e <strong>Premium</strong>, você pode ativar a compra direta no app por Pix, limitar a distância de envio e ver o custo dos Correios (PAC e SEDEX).
            </p>
            <a href="/planos" class="adm-btn adm-btn-accent">💎 Conhecer Meia Versão / Premium &rarr;</a>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 0.9rem;">
            <label style="display: flex; align-items: center; gap: 0.65rem; background: var(--adm-input-bg); border: 1.5px solid @(_pixEnabled ? "#16A34A" : "var(--adm-border)"); border-radius: 10px; padding: 0.85rem 1rem; cursor: pointer;">
                <input type="checkbox" @bind="_pixEnabled" style="width: 18px; height: 18px;" />
                <div>
                    <div style="font-weight: 800; color: var(--adm-text);">
                        @(_pixEnabled ? "✅ Vendas diretas por Pix ATIVADAS no catálogo" : "Ativar vendas diretas pelo app/site (Apenas Pix)")
                    </div>
                    <div style="font-size: 0.78rem; color: var(--adm-muted);">
                        Se desmarcado, os clientes continuam pedindo apenas pelo WhatsApp. Não usa cartão de crédito nem precisa de CNPJ.
                    </div>
                </div>
            </label>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem;">
                <div>
                    <label class="adm-label">Sua Chave Pix para Receber Vendas *</label>
                    <input type="text" class="adm-input" @bind="_storePixKey" @bind:event="oninput"
                           placeholder="CPF, E-mail, +55 Celular ou Chave Aleatória" />
                    <span style="font-size: 0.74rem; color: @(ClothingStore.Shared.Helpers.PixPayloadBuilder.IsValidPixKey(_storePixKey) ? "var(--adm-success)" : "var(--adm-muted)");">
                        Tipo detectado: <strong>@ClothingStore.Shared.Helpers.PixPayloadBuilder.DetectKeyTypeLabel(_storePixKey)</strong>
                    </span>
                </div>

                <div>
                    <label class="adm-label">Nome do Recebedor no Pix (Opcional)</label>
                    <input type="text" class="adm-input" @bind="_storePixReceiverName"
                           placeholder="Ex.: Seu Nome ou Nome da Loja" />
                </div>
            </div>

            <!-- CEP de Origem do Vendedor -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.75rem; align-items: end;">
                <div>
                    <label class="adm-label">Seu CEP de Origem (Ponto de Partida) *</label>
                    <div style="display: flex; gap: 0.4rem;">
                        <input type="text" class="adm-input" @bind="_originCep" placeholder="01310-100" />
                        <button type="button" class="adm-btn adm-btn-outline" style="white-space: nowrap;" disabled="@_lookingUpCep" @onclick="LookupOriginCepAsync">
                            @(_lookingUpCep ? "..." : "🔍 Buscar")
                        </button>
                    </div>
                </div>
                <div>
                    <label class="adm-label">Sua Cidade</label>
                    <input type="text" class="adm-input" @bind="_originCity" placeholder="São Paulo" />
                </div>
                <div>
                    <label class="adm-label">Seu Estado (UF)</label>
                    <input type="text" maxlength="2" class="adm-input" style="text-transform: uppercase;" @bind="_originState" placeholder="SP" />
                </div>
            </div>

            <!-- Escolha de Distância / Alcance do Vendedor -->
            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.9rem;">
                <div style="font-weight: 800; font-size: 0.9rem; margin-bottom: 0.6rem; color: var(--adm-text);">
                    📍 Até onde você aceita mandar os itens da sua distância?
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr)); gap: 0.75rem;">
                    <div>
                        <label class="adm-label">Área de Entrega</label>
                        <select class="adm-select" @bind="_deliveryScopeMode">
                            <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.AllBrazil">Todo o Brasil</option>
                            <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.SameState">Apenas no Mesmo Estado (UF)</option>
                            <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.SameCity">Apenas na Mesma Cidade</option>
                            <option value="@ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.RadiusKm">Limitar por Distância Exata (km)</option>
                        </select>
                    </div>
                    <div>
                        <label class="adm-label">Distância Máxima em KM (0 = sem limite)</label>
                        <input type="number" min="0" max="5000" class="adm-input" @bind="_maxDeliveryDistanceKm" />
                        <div style="display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.35rem;">
                            @foreach (var kmPreset in new[] { 15, 30, 50, 150, 500, 0 })
                            {
                                <button type="button" class="pill-badge pill-slate" style="border: none; cursor: pointer;"
                                        @onclick="() => SetDistancePreset(kmPreset)">
                                    @(kmPreset == 0 ? "Sem limite km" : $"{kmPreset} km")
                                </button>
                            }
                        </div>
                    </div>
                    <div>
                        <label class="adm-label">Peso Médio por Peça (g)</label>
                        <input type="number" min="100" max="30000" class="adm-input" @bind="_defaultPackageWeightGrams" />
                        <span style="font-size: 0.72rem; color: var(--adm-muted);">Usado na estimativa dos Correios (padrão 450 g).</span>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: center;">
                <button type="button" class="adm-btn adm-btn-success" style="font-weight: 800; padding: 0.7rem 1.2rem;" disabled="@_savingPixShipping" @onclick="SavePixAndShippingSettingsAsync">
                    @(_savingPixShipping ? "Salvando..." : "💾 Salvar Vendas Pix, Distância & Correios")
                </button>
                <a href="/pedidos" class="adm-btn adm-btn-outline">🧾 Ver Pedidos Recebidos</a>
            </div>

            <!-- Simulador Rápido Correios & Distância -->
            <details style="border-top: 1px solid var(--adm-border); padding-top: 0.75rem;">
                <summary style="cursor: pointer; font-weight: 700; font-size: 0.86rem; color: var(--adm-text);">
                    📦 Simular quanto custará mandar pelos Correios (PAC &amp; SEDEX)
                </summary>
                <div style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.65rem;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem;">
                        <div>
                            <label class="adm-label">CEP do Comprador (Teste)</label>
                            <input type="text" class="adm-input" @bind="_simTestDestCep" placeholder="20040-020" />
                        </div>
                        <div>
                            <label class="adm-label">Peso do Pacote (g)</label>
                            <input type="number" min="100" max="30000" class="adm-input" @bind="_simTestWeightG" />
                        </div>
                        <div style="display: flex; align-items: flex-end;">
                            <button type="button" class="adm-btn adm-btn-primary" style="width: 100%;" disabled="@_simulatingCorreios" @onclick="SimulateCorreiosSellerAsync">
                                @(_simulatingCorreios ? "Calculando..." : "📊 Simular Frete & Distância")
                            </button>
                        </div>
                    </div>

                    @if (_simTestEligibility is not null)
                    {
                        <div style="padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.84rem; @(_simTestEligibility.IsAllowed ? "background: rgba(22,163,74,0.12); border: 1px solid #16A34A;" : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger);")">
                            <strong>@(_simTestEligibility.IsAllowed ? "✓ Comprador dentro da sua área:" : "✕ Bloqueado pelo seu limite:")</strong>
                            @_simTestEligibility.ReasonMessage
                        </div>
                    }

                    @if (_simTestCorreiosQuote is not null)
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.65rem;">
                            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 8px; padding: 0.7rem;">
                                <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 700;">CORREIOS PAC</div>
                                <div style="font-size: 1.1rem; font-weight: 800; color: var(--adm-success);">@_simTestCorreiosQuote.PacPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                                <div style="font-size: 0.76rem; color: var(--adm-muted);">@_simTestCorreiosQuote.PacDaysMin–@_simTestCorreiosQuote.PacDaysMax dias úteis · @_simTestCorreiosQuote.ZoneName</div>
                            </div>
                            <div style="background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 8px; padding: 0.7rem;">
                                <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 700;">CORREIOS SEDEX</div>
                                <div style="font-size: 1.1rem; font-weight: 800; color: var(--adm-accent);">@_simTestCorreiosQuote.SedexPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</div>
                                <div style="font-size: 0.76rem; color: var(--adm-muted);">@_simTestCorreiosQuote.SedexDaysMin–@_simTestCorreiosQuote.SedexDaysMax dias úteis · 📍 @_simTestCorreiosQuote.DistanceKm km</div>
                            </div>
                        </div>
                    }
                </div>
            </details>
        </div>
    }
</section>

<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid var(--brand-accent, #B69158);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand-accent, #B69158);">
                Licença &amp; Gift Card
            </div>
            <h2 style="font-size: 1.2rem; font-weight: 700; margin: 0.25rem 0 0; color: var(--adm-text);">
                🎁 Resgatar Código Gift Card do Plano
            </h2>
            <p style="font-size: 0.85rem; color: var(--adm-muted); margin: 0.25rem 0 0;">
                Digite o código Gift Card recebido para ativar ou renovar seu plano <strong>Básico</strong>, <strong>Intermediário (5 Versões)</strong> ou <strong>Premium Moldável</strong>.
            </p>
        </div>

        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
            <span class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                @(BrandState.IsPremiumPlan ? "✦ Plano Premium Ativo" : BrandState.IsIntermediatePlan ? "◈ Meia Versão (5 Temas)" : "● Plano Básico Minimalista")
            </span>
            <span style="font-size: 0.78rem; color: var(--adm-muted);">
                @if (!_planExpiresAt.HasValue)
                {
                    <span>Validade: <strong>Vitalício / Contínuo</strong></span>
                }
                else if (DateTimeOffset.UtcNow < _planExpiresAt.Value)
                {
                    <span>Válido até: <strong>@_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                }
                else
                {
                    <span style="color: var(--adm-danger);">Licença expirada em @_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(_activeGiftCardCode))
            {
                <span style="font-size: 0.74rem; color: var(--adm-muted); font-family: monospace;">
                    Último Gift Card: @_activeGiftCardCode
                </span>
            }
        </div>
    </div>

    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem;">
        <input type="text"
               class="adm-input"
               style="flex: 1; min-width: 220px; text-transform: uppercase; font-family: monospace; letter-spacing: 0.08em; font-weight: 700;"
               @bind="_giftCardCodeInput"
               placeholder="Ex.: LUXO-INTR-30D-A7K2B9C4 ou LUXO-PREM-..." />
        <button type="button"
                class="adm-btn adm-btn-accent"
                style="white-space: nowrap; font-weight: 700;"
                disabled="@_isRedeemingGiftCard"
                @onclick="RedeemGiftCardAsync">
            @(_isRedeemingGiftCard ? "Ativando..." : "🎁 Ativar Código Gift Card")
        </button>
    </div>
</section>

<DesignStudioPanel PlanTier="@_planTier"
                   PlanExpiresAt="@_planExpiresAt"
                   BasicPrice="@_basicPlanPrice"
                   IntermediaryPrice="@_intermediaryPlanPrice"
                   PremiumPrice="@_premiumPlanPrice"
                   Design="@_designDraft"
                   StoreName="@_form.StoreName"
                   StoreDescription="@_form.StoreDescription"
                   IsSaving="@_savingDesign"
                   OnDesignChanged="HandleDesignDraftChanged"
                   OnSaveDesignRequested="SaveDesignSettingsAsync" />

@code {
    private string _planTier = StoreDesignPresets.PlanBasic;
    private DateTimeOffset? _planExpiresAt;
    private string? _activeGiftCardCode;
    private string _giftCardCodeInput = string.Empty;
    private bool _isRedeemingGiftCard;
    private decimal _basicPlanPrice = 49.90m;
    private decimal _intermediaryPlanPrice = 89.90m;
    private decimal _premiumPlanPrice = 129.90m;
    private StoreDesignDto _designDraft = StoreDesignDto.CreateMinimalistaLuxo();
    private bool _savingDesign;

    private UpdateStoreSettingsRequest _form = new()
    {
        StoreName = "Minha Loja",
        StoreSlug = "minha-loja",
        WhatsappNumber = "5511900000000",
        StoreDescription = "Catálogo digital oficial da loja.",
        DefaultLowStockThreshold = 3,
        AutoSyncOnlineOnSave = true
    };

    private bool _autoSyncSlugWithName = true;
    private bool _copiedUrl;
    private string? _error;
    private string? _success;
    private string _domainInput = string.Empty;
    private bool _isCheckingDomain;
    private bool _isSearchingFreeDomains;
    private FreeDomainSearchResponse? _freeDomainSearch;
    private string _duckDnsToken = string.Empty;
    private string _duckDnsIp = string.Empty;
    private bool _isSyncingDuckDns;
    private CheckDomainAvailabilityResponse? _domainCheckResult;

    // Servidor Próprio + Verificação de Conta Google
    private string _serverHostingMode = "PlatformShared";
    private string _ownServerProvider = "GoogleCloudRun";
    private string _ownServerSyncSecretInput = string.Empty;
    private bool _hasOwnServerSyncSecret;
    private string _googleOAuthClientId = string.Empty;
    private string _googleAccessTokenInput = string.Empty;
    private string? _googleAccountEmail;
    private string _googleAccountTier = "None";
    private long? _googleDriveQuotaBytes;
    private string? _googleHostedDomain;
    private DateTimeOffset? _googleAccountVerifiedAt;
    private bool _qualifiesForDedicatedBenefit;
    private bool _savingHosting;
    private bool _testingOwnServer;
    private bool _verifyingGoogle;
    private OwnServerHealthCheckResult? _ownServerTestResult;
    private GoogleAccountTierVerificationResult? _googleVerifyResult;

    protected override async Task OnInitializedAsync()
    {
        Theme.OnThemeChanged += StateHasChanged;
        CloudSync.OnSyncStatusChanged += StateHasChanged;
        await LoadSettingsAsync();
    }

    private void ChangeTheme(string preference)
    {
        Theme.SetThemePreference(preference);
    }

    private async Task LoadSettingsAsync()
    {
        _error = null;
        try
        {
            var current = await Gateway.GetStoreSettingsAsync();
            _domainInput = string.IsNullOrWhiteSpace(current.OnlineBaseUrl)
                ? WhatsAppLinkBuilder.GenerateDefaultStoreDomain(current.StoreName)
                : current.OnlineBaseUrl.Replace("https://", "").Replace("http://", "").TrimEnd('/');
            _form = new UpdateStoreSettingsRequest
            {
                StoreName = current.StoreName,
                StoreSlug = current.StoreSlug,
                WhatsappNumber = current.WhatsappNumber,
                StoreDescription = current.StoreDescription,
                LogoPublicUrl = current.LogoPublicUrl,
                DefaultLowStockThreshold = current.DefaultLowStockThreshold,
                OnlineBaseUrl = string.IsNullOrWhiteSpace(current.OnlineBaseUrl)
                    ? WhatsAppLinkBuilder.GenerateDefaultStoreUrl(current.StoreName)
                    : current.OnlineBaseUrl,
                AutoSyncOnlineOnSave = current.AutoSyncOnlineOnSave,
                LastOnlineSyncAt = current.LastOnlineSyncAt,
                IsSiteActive = current.IsSiteActive,
                DeactivationReason = current.DeactivationReason,
                LastActivityAt = current.LastActivityAt,
                PublishedStoreName = current.PublishedStoreName,
                PlanTier = current.PlanTier
            };
            _planTier = current.PlanTier;
            _planExpiresAt = current.PlanExpiresAt;
            _activeGiftCardCode = current.ActiveGiftCardCode;
            _basicPlanPrice = current.BasicPlanMonthlyPrice;
            _intermediaryPlanPrice = current.IntermediaryPlanMonthlyPrice;
            _premiumPlanPrice = current.PremiumPlanMonthlyPrice;
            _designDraft = (current.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            ApplyPixAndShippingFields(current);
            ApplyHostingAndGoogleFields(current);
            BrandState.ApplyFromAdminSettings(current);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CheckDomainAvailabilityAsync()
    {
        if (string.IsNullOrWhiteSpace(_domainInput))
            return;

        _isCheckingDomain = true;
        _error = null;
        try
        {
            _domainCheckResult = await Gateway.CheckDomainAvailabilityAsync(_domainInput.Trim());
            if (_domainCheckResult.IsAvailable)
            {
                _form.OnlineBaseUrl = _domainCheckResult.NormalizedUrl;
                _domainInput = _domainCheckResult.Domain;
            }
        }
        catch (Exception ex)
        {
            _error = $"Erro ao consultar o Google Cloud: {ex.Message}";
        }
        finally
        {
            _isCheckingDomain = false;
        }
    }

    private async Task SelectDomainSuggestion(string suggestion)
    {
        _domainInput = suggestion;
        await CheckDomainAvailabilityAsync();
    }

    private async Task SearchFreeDomainsInSettingsAsync()
    {
        _isSearchingFreeDomains = true;
        _error = null;
        try
        {
            var query = string.IsNullOrWhiteSpace(_form.StoreName) ? _domainInput : _form.StoreName;
            _freeDomainSearch = await Gateway.SearchFreeDomainsAsync(query);
        }
        catch (Exception ex)
        {
            _error = $"Erro ao procurar domínios gratuitos: {ex.Message}";
        }
        finally
        {
            _isSearchingFreeDomains = false;
        }
    }

    private void UseFreeDomainCandidateAsync(FreeDomainCandidateDto cand)
    {
        _domainInput = cand.Domain;
        _form.OnlineBaseUrl = cand.NormalizedUrl;
        _success = $"🎁 Domínio gratuito '{cand.Domain}' selecionado! Salve as configurações para aplicar e aproveite o plano mais barato.";
    }

    private async Task SyncDuckDnsNowAsync()
    {
        _isSyncingDuckDns = true;
        _error = null;
        _success = null;
        try
        {
            var (ok, msg) = await Gateway.UpdateDuckDnsAsync(_domainInput, _duckDnsToken, _duckDnsIp);
            if (ok)
                _success = msg;
            else
                _error = msg;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSyncingDuckDns = false;
        }
    }

    private void SyncSlugFromStoreNameIfUnlocked()
    {
        if (_autoSyncSlugWithName)
        {
            _form.StoreSlug = WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName);
            if (string.IsNullOrWhiteSpace(_domainInput) || _domainInput.StartsWith("lojas."))
            {
                _domainInput = WhatsAppLinkBuilder.GenerateDefaultStoreDomain(_form.StoreName);
                _form.OnlineBaseUrl = WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);
            }
        }
    }

    private async Task SaveSettingsAsync()
    {
        _error = null;
        _success = null;
        try
        {
            if (_autoSyncSlugWithName || string.IsNullOrWhiteSpace(_form.StoreSlug))
            {
                _form.StoreSlug = WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName);
            }

            if (string.IsNullOrWhiteSpace(_form.OnlineBaseUrl))
            {
                _form.OnlineBaseUrl = WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);
            }

            _form.PlanTier = _planTier;
            _form.ServerHostingMode = _serverHostingMode;
            _form.OwnServerProvider = _ownServerProvider;
            _form.GoogleOAuthClientId = _googleOAuthClientId;
            if (!string.IsNullOrWhiteSpace(_ownServerSyncSecretInput))
            {
                _form.OwnServerSyncSecret = _ownServerSyncSecretInput.Trim();
            }

            if (BrandState.IsPremiumPlan)
            {
                _form.Design = _designDraft.Clone();
            }
            else if (BrandState.IsIntermediatePlan)
            {
                _form.Design = StoreDesignPresets.ResolveByPresetKey(_designDraft.PresetKey);
            }

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            _form.OwnServerSyncSecret = null;
            _ownServerSyncSecretInput = string.Empty;
            ApplyHostingAndGoogleFields(updated);
            _form.StoreSlug = updated.StoreSlug;
            _form.WhatsappNumber = updated.WhatsappNumber;
            _form.LogoPublicUrl = updated.LogoPublicUrl;
            _form.OnlineBaseUrl = updated.OnlineBaseUrl;
            _form.AutoSyncOnlineOnSave = updated.AutoSyncOnlineOnSave;
            _form.LastOnlineSyncAt = updated.LastOnlineSyncAt;
            _form.IsSiteActive = updated.IsSiteActive;
            _form.DeactivationReason = updated.DeactivationReason;
            _form.LastActivityAt = updated.LastActivityAt;
            _form.PublishedStoreName = updated.PublishedStoreName;
            _planTier = updated.PlanTier;
            _planExpiresAt = updated.PlanExpiresAt;
            _activeGiftCardCode = updated.ActiveGiftCardCode;
            _basicPlanPrice = updated.BasicPlanMonthlyPrice;
            _intermediaryPlanPrice = updated.IntermediaryPlanMonthlyPrice;
            _premiumPlanPrice = updated.PremiumPlanMonthlyPrice;
            _designDraft = (updated.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            BrandState.ApplyFromAdminSettings(updated);

            if (!_form.IsSiteActive)
            {
                _error = _form.DeactivationReason;
            }
            else
            {
                _success = "✓ Configurações da loja salvas com sucesso!";
            }

            // Se houver URL de nuvem configurada, tenta sincronizar em background sem travar nem assustar o usuário
            if (!string.IsNullOrWhiteSpace(_form.OnlineBaseUrl))
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await CloudSync.SyncCatalogToCloudAsync();
                    }
                    catch
                    {
                    }
                });
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ActivateSiteNowAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var res = await Gateway.ActivateSiteAsync();
            _form.IsSiteActive = res.IsSiteActive;
            _form.DeactivationReason = res.DeactivationReason;
            _form.LastActivityAt = res.LastActivityAt;
            _form.PublishedStoreName = res.PublishedStoreName;
            _success = "✓ Site reativado e publicado com sucesso!";
        }
        catch (Exception ex)
        {
            _error = $"Erro ao reativar site: {ex.Message}";
        }
    }

    private async Task DeactivateSiteNowAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var res = await Gateway.DeactivateSiteAsync("Pausado manualmente pelo administrador.");
            _form.IsSiteActive = res.IsSiteActive;
            _form.DeactivationReason = res.DeactivationReason;
            _form.LastActivityAt = res.LastActivityAt;
            _success = "Site pausado com sucesso.";
        }
        catch (Exception ex)
        {
            _error = $"Erro ao pausar site: {ex.Message}";
        }
    }

    private async Task SyncToCloudNowAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var (ok, msg) = await CloudSync.SyncCatalogToCloudAsync();
            if (ok)
            {
                _success = msg;
                await LoadSettingsAsync();
            }
            else
            {
                _error = msg;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CopyStoreUrlAsync(string url)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(url);
            _copiedUrl = true;
            _success = "✓ Link copiado para a área de transferência! Cole onde quiser.";
            StateHasChanged();
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _copiedUrl = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch
        {
        }
    }

    private async Task ShareOnWhatsAppAsync(string url)
    {
        try
        {
            var text = $"Olá! Confira as novidades e peças disponíveis no nosso catálogo oficial: {url}";
            var shareUrl = $"https://wa.me/?text={Uri.EscapeDataString(text)}";
            await Browser.Default.OpenAsync(new Uri(shareUrl), BrowserLaunchMode.External);
        }
        catch
        {
            await CopyStoreUrlAsync(url);
        }
    }

    private async Task OpenBrowserAsync(string url)
    {
        try
        {
            LocalWebServerLauncher.Initialize(CatalogService);
            await LocalWebServerLauncher.OpenCatalogInBrowserAsync(url, _form.StoreSlug);
        }
        catch (Exception ex)
        {
            _error = $"Não foi possível abrir o navegador: {ex.Message}";
        }
    }

    private async Task PickAndUploadLogoAsync()
    {
        _error = null;
        _success = null;
        try
        {
            var file = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Selecione a imagem do logotipo da loja",
                FileTypes = FilePickerFileType.Images
            });

            if (file is null)
                return;

            await using var stream = await file.OpenReadAsync();
            var updated = await Gateway.UploadStoreLogoAsync(file.FileName, stream, file.ContentType ?? "image/png");
            _form.LogoPublicUrl = updated.LogoPublicUrl;
            _success = "Logotipo da loja enviado e atualizado com sucesso!";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RemoveLogoAsync()
    {
        _error = null;
        _success = null;
        try
        {
            await Gateway.RemoveStoreLogoAsync();
            _form.LogoPublicUrl = null;
            _success = "Logotipo removido com sucesso.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void HandleDesignDraftChanged(StoreDesignDto draft)
    {
        if (BrandState.IsPremiumPlan)
        {
            BrandState.PreviewDraft(draft);
        }
        else if (BrandState.IsIntermediatePlan)
        {
            BrandState.PreviewDraft(StoreDesignPresets.ResolveByPresetKey(draft.PresetKey));
        }
    }

    private async Task RedeemGiftCardAsync()
    {
        _error = null;
        _success = null;
        if (string.IsNullOrWhiteSpace(_giftCardCodeInput))
        {
            _error = "Digite o código do Gift Card antes de tentar resgatar.";
            return;
        }

        _isRedeemingGiftCard = true;
        try
        {
            var result = await Gateway.RedeemActivationCodeAsync(new RedeemActivationCodeRequest
            {
                Code = _giftCardCodeInput.Trim()
            });

            _giftCardCodeInput = string.Empty;
            _planTier = result.UpdatedSettings.PlanTier;
            _planExpiresAt = result.UpdatedSettings.PlanExpiresAt;
            _activeGiftCardCode = result.UpdatedSettings.ActiveGiftCardCode;
            _form.PlanTier = _planTier;
            _form.IsSiteActive = result.UpdatedSettings.IsSiteActive;
            _designDraft = (result.UpdatedSettings.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            ApplyPixAndShippingFields(result.UpdatedSettings);
            BrandState.ApplyFromAdminSettings(result.UpdatedSettings);
            _success = "🎉 " + result.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isRedeemingGiftCard = false;
        }
    }

    private async Task SaveDesignSettingsAsync()
    {
        _error = null;
        _success = null;
        _savingDesign = true;
        try
        {
            _form.PlanTier = _planTier;
            _form.Design = BrandState.IsIntermediatePlan
                ? StoreDesignPresets.ResolveByPresetKey(_designDraft.PresetKey)
                : _designDraft.Clone();

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            _designDraft = (updated.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            BrandState.ApplyFromAdminSettings(updated);
            _success = BrandState.IsIntermediatePlan
                ? "◈ Versão pré-pronta salva e aplicada no aplicativo e no catálogo!"
                : "✦ Visual sob medida salvo e aplicado no aplicativo e no catálogo!";

            if (!string.IsNullOrWhiteSpace(_form.OnlineBaseUrl))
            {
                _ = Task.Run(async () =>
                {
                    try { await CloudSync.SyncCatalogToCloudAsync(); } catch { }
                });
            }
        }
        catch (Exception ex)
        {
            _error = $"Erro ao salvar visual sob medida: {ex.Message}";
        }
        finally
        {
            _savingDesign = false;
        }
    }

    private bool _pixEnabled;
    private string _storePixKey = string.Empty;
    private string _storePixReceiverName = string.Empty;
    private string _originCep = string.Empty;
    private string _originCity = string.Empty;
    private string _originState = string.Empty;
    private string _deliveryScopeMode = ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.AllBrazil;
    private int _maxDeliveryDistanceKm;
    private int _defaultPackageWeightGrams = 450;
    private bool _lookingUpCep;
    private bool _savingPixShipping;
    private string _simTestDestCep = "20040-020";
    private int _simTestWeightG = 450;
    private bool _simulatingCorreios;
    private DeliveryEligibilityDto? _simTestEligibility;
    private CorreiosQuoteDto? _simTestCorreiosQuote;

    private void ApplyPixAndShippingFields(AdminStoreSettingsDto s)
    {
        _pixEnabled = s.DirectPixSalesEnabled;
        _storePixKey = s.StorePixKey ?? string.Empty;
        _storePixReceiverName = s.StorePixReceiverName ?? string.Empty;
        _originCep = s.OriginCep ?? string.Empty;
        _originCity = s.OriginCity ?? string.Empty;
        _originState = s.OriginState ?? string.Empty;
        _deliveryScopeMode = string.IsNullOrWhiteSpace(s.DeliveryScopeMode)
            ? ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.AllBrazil
            : s.DeliveryScopeMode;
        _maxDeliveryDistanceKm = s.MaxDeliveryDistanceKm;
        _defaultPackageWeightGrams = s.DefaultPackageWeightGrams >= 100 ? s.DefaultPackageWeightGrams : 450;
        _simTestWeightG = _defaultPackageWeightGrams;
    }

    private void SetDistancePreset(int km)
    {
        _maxDeliveryDistanceKm = km;
        if (km > 0 && _deliveryScopeMode == ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.AllBrazil)
        {
            _deliveryScopeMode = ClothingStore.Shared.Helpers.BrazilShippingCalculator.DeliveryScopeModes.RadiusKm;
        }
    }

    private async Task LookupOriginCepAsync()
    {
        _error = null;
        _lookingUpCep = true;
        try
        {
            var info = await Gateway.LookupCepAsync(_originCep);
            _originCep = info.Cep;
            _originCity = info.City;
            _originState = info.State;
            _success = $"CEP localizado: {info.City}/{info.State} ({info.Source}).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _lookingUpCep = false;
        }
    }

    private async Task SavePixAndShippingSettingsAsync()
    {
        _error = null;
        _success = null;
        _savingPixShipping = true;
        try
        {
            _form.DirectPixSalesEnabled = _pixEnabled;
            _form.StorePixKey = _storePixKey;
            _form.StorePixReceiverName = _storePixReceiverName;
            _form.OriginCep = _originCep;
            _form.OriginCity = _originCity;
            _form.OriginState = _originState;
            _form.DeliveryScopeMode = _deliveryScopeMode;
            _form.MaxDeliveryDistanceKm = _maxDeliveryDistanceKm;
            _form.DefaultPackageWeightGrams = _defaultPackageWeightGrams;

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            ApplyPixAndShippingFields(updated);
            BrandState.ApplyFromAdminSettings(updated);

            _success = updated.DirectPixSalesReady
                ? "✅ Vendas por Pix no app, limite de distância e cálculo dos Correios salvos e ATIVADOS!"
                : "✅ Preferências de envio e distância salvas (vendas diretas por Pix estão desativadas).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingPixShipping = false;
        }
    }

    private async Task SimulateCorreiosSellerAsync()
    {
        _error = null;
        _simulatingCorreios = true;
        try
        {
            var destInfo = await Gateway.LookupCepAsync(_simTestDestCep);
            _simTestEligibility = ClothingStore.Shared.Helpers.BrazilShippingCalculator.EvaluateDeliveryEligibility(
                _originCep,
                _originCity,
                _originState,
                _deliveryScopeMode,
                _maxDeliveryDistanceKm,
                destInfo.Cep,
                destInfo.City,
                destInfo.State);

            _simTestCorreiosQuote = await Gateway.SimulateCorreiosAsync(
                _originCep,
                destInfo.Cep,
                _simTestWeightG);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _simulatingCorreios = false;
        }
    }

    private void ApplyHostingAndGoogleFields(AdminStoreSettingsDto s)
    {
        _serverHostingMode = string.IsNullOrWhiteSpace(s.ServerHostingMode) ? "PlatformShared" : s.ServerHostingMode;
        _ownServerProvider = string.IsNullOrWhiteSpace(s.OwnServerProvider) ? "GoogleCloudRun" : s.OwnServerProvider;
        _hasOwnServerSyncSecret = s.HasOwnServerSyncSecret;
        _googleOAuthClientId = s.GoogleOAuthClientId ?? string.Empty;
        _googleAccountEmail = s.GoogleAccountEmail;
        _googleAccountTier = string.IsNullOrWhiteSpace(s.GoogleAccountTier) ? "None" : s.GoogleAccountTier;
        _googleDriveQuotaBytes = s.GoogleDriveQuotaBytes;
        _googleHostedDomain = s.GoogleHostedDomain;
        _googleAccountVerifiedAt = s.GoogleAccountVerifiedAt;
        _qualifiesForDedicatedBenefit = s.QualifiesForDedicatedServerBenefit;

        _form.ServerHostingMode = _serverHostingMode;
        _form.OwnServerProvider = _ownServerProvider;
        _form.GoogleOAuthClientId = _googleOAuthClientId;
    }

    private async Task SaveHostingAndGoogleSettingsAsync()
    {
        _error = null;
        _success = null;
        _savingHosting = true;
        try
        {
            _form.ServerHostingMode = _serverHostingMode;
            _form.OwnServerProvider = _ownServerProvider;
            _form.GoogleOAuthClientId = _googleOAuthClientId;
            _form.ClearOwnServerSyncSecret = false;
            _form.OwnServerSyncSecret = string.IsNullOrWhiteSpace(_ownServerSyncSecretInput)
                ? null
                : _ownServerSyncSecretInput.Trim();

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            _form.OwnServerSyncSecret = null;
            _ownServerSyncSecretInput = string.Empty;
            ApplyHostingAndGoogleFields(updated);
            BrandState.ApplyFromAdminSettings(updated);

            _success = string.Equals(updated.ServerHostingMode, "DedicatedOwnServer", StringComparison.OrdinalIgnoreCase)
                ? $"✅ Modo 'Meu Servidor Próprio' ({updated.OwnServerProvider}) salvo! Lembre de testar e sincronizar o catálogo."
                : "✅ Preferências de servidor e OAuth salvas.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingHosting = false;
        }
    }

    private async Task ClearOwnServerSyncSecretAsync()
    {
        _error = null;
        _savingHosting = true;
        try
        {
            _form.ServerHostingMode = _serverHostingMode;
            _form.OwnServerProvider = _ownServerProvider;
            _form.OwnServerSyncSecret = null;
            _form.ClearOwnServerSyncSecret = true;

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            _form.ClearOwnServerSyncSecret = false;
            ApplyHostingAndGoogleFields(updated);
            _success = "Chave secreta de sincronização removida.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingHosting = false;
        }
    }

    private async Task TestOwnServerNowAsync()
    {
        _ownServerTestResult = null;
        _testingOwnServer = true;
        try
        {
            _ownServerTestResult = await Gateway.TestOwnServerConnectionAsync(_form.OnlineBaseUrl);
        }
        catch (Exception ex)
        {
            _ownServerTestResult = new OwnServerHealthCheckResult(false, _form.OnlineBaseUrl ?? string.Empty, null, 0, ex.Message);
        }
        finally
        {
            _testingOwnServer = false;
        }
    }

    private async Task VerifyGoogleViaBrowserAsync()
    {
        _googleVerifyResult = null;
        _verifyingGoogle = true;
        try
        {
            var res = await Gateway.VerifyGoogleAccountViaBrowserOAuthAsync(_googleOAuthClientId);
            _googleVerifyResult = res;
            if (res.Success)
            {
                await LoadSettingsAsync();
            }
        }
        catch (Exception ex)
        {
            _googleVerifyResult = new GoogleAccountTierVerificationResult(
                false, null, null, null, null, null, "None", false, false, "Erro", ex.Message, null);
        }
        finally
        {
            _verifyingGoogle = false;
        }
    }

    private async Task VerifyGoogleByTokenAsync()
    {
        _googleVerifyResult = null;
        _verifyingGoogle = true;
        try
        {
            var res = await Gateway.VerifyGoogleAccountByTokenAsync(_googleAccessTokenInput, _googleOAuthClientId);
            _googleVerifyResult = res;
            if (res.Success)
            {
                _googleAccessTokenInput = string.Empty;
                await LoadSettingsAsync();
            }
        }
        catch (Exception ex)
        {
            _googleVerifyResult = new GoogleAccountTierVerificationResult(
                false, null, null, null, null, null, "None", false, false, "Erro", ex.Message, null);
        }
        finally
        {
            _verifyingGoogle = false;
        }
    }

    private async Task ClearGoogleVerificationAsync()
    {
        _error = null;
        _verifyingGoogle = true;
        try
        {
            var updated = await Gateway.ClearGoogleAccountVerificationAsync();
            ApplyHostingAndGoogleFields(updated);
            _googleVerifyResult = null;
            _success = "Verificação da conta Google removida.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _verifyingGoogle = false;
        }
    }

    public void Dispose()
    {
        Theme.OnThemeChanged -= StateHasChanged;
        CloudSync.OnSyncStatusChanged -= StateHasChanged;
    }
}
