@page "/configuracoes-loja"
@using ClothingStore.Application.Services
@inject MauiAdminGateway Gateway
@inject CatalogService CatalogService
@inject NavigationManager Navigation
@inject ThemeService Theme
@inject StoreBrandStateService BrandState
@inject GoogleCloudSyncService CloudSync

@{
    var effectiveSlug = string.IsNullOrWhiteSpace(_form.StoreSlug)
        ? WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName)
        : WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreSlug);

    var baseSiteUrl = !string.IsNullOrWhiteSpace(_form.OnlineBaseUrl)
        ? _form.OnlineBaseUrl.TrimEnd('/')
        : WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);

    var storeCatalogUrl = WhatsAppLinkBuilder.BuildStoreCatalogUrl(baseSiteUrl, effectiveSlug);
    var qrCodeSvgUri = WhatsAppLinkBuilder.GenerateQrCodeSvgDataUri(storeCatalogUrl);
}

<div style="margin-bottom: 1.5rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; margin: 0; color: var(--adm-text);">Configurações da Loja &amp; Catálogo</h1>
    <p style="color: var(--adm-muted); font-size: 0.92rem; margin: 0.25rem 0 0;">
        Personalize o nome da loja, tema visual (Claro/Escuro), WhatsApp e compartilhe o link do seu catálogo com seus clientes.
    </p>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert-banner alert-error">@_error</div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert-banner alert-success">@_success</div>
}

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; align-items: start;">
    <!-- Coluna Esquerda: Tema do App + Identidade da Loja -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <!-- Card 1: Aparência e Tema do Aplicativo (Android) -->
        <section class="adm-card" style="border-left: 4px solid var(--adm-accent);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🎨 Tema do Aplicativo (Modo Claro &amp; Escuro)
                </h2>
                <span class="pill-badge pill-blue">Android</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--adm-muted); margin-top: 0; margin-bottom: 0.75rem;">
                Escolha a aparência visual do aplicativo de acordo com a sua preferência:
            </p>

            <div class="theme-selector-grid">
                <div class="theme-card-option @(Theme.ThemePreference == "system" ? "active" : "")"
                     @onclick='() => ChangeTheme("system")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌓</div>
                    <div>Automático</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Segue o Android</div>
                </div>

                <div class="theme-card-option @(Theme.ThemePreference == "light" ? "active" : "")"
                     @onclick='() => ChangeTheme("light")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">☀️</div>
                    <div>Modo Claro</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">Fundo Branco</div>
                </div>

                <div class="theme-card-option @(Theme.ThemePreference == "dark" ? "active" : "")"
                     @onclick='() => ChangeTheme("dark")'>
                    <div style="font-size: 1.3rem; margin-bottom: 0.2rem;">🌙</div>
                    <div>Modo Escuro</div>
                    <div style="font-size: 0.72rem; color: var(--adm-muted); font-weight: 500;">OLED / Alto Contraste</div>
                </div>
            </div>
        </section>

        <!-- Card 2: Dados da Loja e Contato -->
        <section class="adm-card">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin-top: 0; margin-bottom: 1rem; color: var(--adm-text);">
                🏪 Identidade da Loja &amp; WhatsApp
            </h2>

            <div style="display: flex; flex-direction: column; gap: 1.1rem;">
                <div>
                    <label class="adm-label">Nome da Loja *</label>
                    <input type="text"
                           class="adm-input"
                           @bind="_form.StoreName"
                           @bind:event="oninput"
                           @bind:after="SyncSlugFromStoreNameIfUnlocked"
                           placeholder="Ex.: Minha Loja" />
                </div>

                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                        <label class="adm-label" style="margin: 0;">Endereço do Link da Loja (Final da URL) *</label>
                        <label style="font-size: 0.76rem; color: var(--adm-muted); display: flex; align-items: center; gap: 0.35rem; cursor: pointer;">
                            <input type="checkbox" @bind="_autoSyncSlugWithName" />
                            <span>Sincronizar com o nome</span>
                        </label>
                    </div>
                    <input type="text" class="adm-input" @bind="_form.StoreSlug" placeholder="minha-loja" />
                    <span style="font-size: 0.78rem; color: var(--adm-muted);">
                        Link oficial do catálogo: <strong style="color: var(--adm-accent);">@storeCatalogUrl</strong>
                    </span>
                </div>

                <div>
                    <label class="adm-label">Número do WhatsApp (DDD + Celular) *</label>
                    <input type="text" class="adm-input" @bind="_form.WhatsappNumber" placeholder="Ex.: 11999990000" />
                    <span style="font-size: 0.78rem; color: var(--adm-muted);">
                        Pode digitar apenas o DDD + número (ex.: <strong>11999990000</strong>). O código do Brasil (+55) é inserido automaticamente!
                    </span>
                </div>

                <div>
                    <label class="adm-label">Descrição e Bio da Loja *</label>
                    <textarea class="adm-textarea" rows="3" @bind="_form.StoreDescription" placeholder="Apresentação exibida para os clientes no catálogo online..."></textarea>
                </div>

                <div>
                    <label class="adm-label">Alerta de Estoque Baixo (avisa quando restar menos de quantas unidades)</label>
                    <input type="number" min="0" class="adm-input" @bind="_form.DefaultLowStockThreshold" />
                </div>

                <button type="button" class="adm-btn adm-btn-success" style="padding: 0.85rem; font-size: 0.95rem; font-weight: 700;" @onclick="SaveSettingsAsync">
                    💾 Salvar Configurações da Loja
                </button>
            </div>
        </section>
    </div>

    <!-- Coluna Direita: Link Oficial da Loja + QR Code + Logotipo -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <!-- Card 2.5: Status do Site do Usuário (Ativo / Desativado por Nome ou Inatividade) -->
        <section class="adm-card" style="border-left: 4px solid @(_form.IsSiteActive ? "var(--adm-success)" : "var(--adm-danger)");">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🌍 Visibilidade do Site para o Público
                </h2>
                <span class="pill-badge @(_form.IsSiteActive ? "pill-green" : "pill-red")" style="font-weight: 800;">
                    @(_form.IsSiteActive ? "🟢 Visível para Clientes" : "🔴 Oculto / Pausado")
                </span>
            </div>

            @if (_form.IsSiteActive)
            {
                <p style="font-size: 0.84rem; color: var(--adm-muted); margin: 0 0 0.75rem; line-height: 1.45;">
                    Seu catálogo público está <strong>no ar e visível</strong> para qualquer cliente que acessar o link.
                    <strong>Atenção:</strong> após 21 dias sem movimentação ou ao trocar o nome da loja, ele pausa automaticamente até você confirmar aqui.
                </p>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--adm-muted); flex-wrap: wrap; gap: 0.5rem;">
                    <span>Última movimentação: <strong>@(_form.LastActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Hoje")</strong></span>
                    <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                        <a href="/loja/@_form.StoreSlug" class="adm-btn adm-btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.76rem;">
                            👁️ Ver como Cliente
                        </a>
                        <button type="button" class="adm-btn adm-btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.76rem;" @onclick="DeactivateSiteNowAsync">
                            Ocultar Site
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--adm-danger); border-radius: 8px; padding: 0.85rem; margin-bottom: 0.85rem; color: var(--adm-text);">
                    <div style="font-weight: 800; color: var(--adm-danger); margin-bottom: 0.25rem;">
                        ⚠️ Motivo da Desativação:
                    </div>
                    <div style="font-size: 0.84rem; line-height: 1.45;">
                        @(_form.DeactivationReason ?? "O site foi pausado automaticamente.")
                    </div>
                </div>
                <button type="button"
                        class="adm-btn adm-btn-primary"
                        style="width: 100%; padding: 0.75rem; font-weight: 800; font-size: 0.95rem;"
                        @onclick="ActivateSiteNowAsync">
                    🚀 Reativar e Publicar Meu Site Agora
                </button>
            }
        </section>

        <!-- Card 3: Link Oficial do Catálogo da Sua Loja -->
        <section class="adm-card" style="border-left: 4px solid var(--adm-success);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 style="font-size: 1.1rem; font-weight: 700; margin: 0; color: var(--adm-text);">
                    🌐 Link Oficial do Catálogo da Sua Loja
                </h2>
                <span class="pill-badge pill-green">🟢 Catálogo Pronto</span>
            </div>

            <p style="font-size: 0.85rem; color: var(--adm-muted); margin-top: 0; margin-bottom: 0.85rem; line-height: 1.45;">
                Este é o link oficial exclusivo da sua loja! Compartilhe com suas clientes ou divulgue nas suas redes sociais:
            </p>

            <div style="background: var(--adm-input-bg); border: 1.5px solid var(--adm-border); border-radius: 8px; padding: 0.85rem 1rem; font-family: monospace; font-size: 0.95rem; font-weight: 700; word-break: break-all; margin-bottom: 0.45rem; color: var(--adm-accent);">
                @storeCatalogUrl
            </div>
            <div style="font-size: 0.76rem; color: var(--adm-muted); margin-bottom: 0.95rem; line-height: 1.4;">
                🌐 <em>Link exclusivo para suas redes sociais. Ao clicar em <strong>"Abrir no Navegador"</strong>, seu catálogo abre na hora localmente sem erro de DNS!</em>
            </div>

            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
                <button type="button" class="adm-btn adm-btn-primary" style="flex: 1; min-width: 140px;" @onclick="() => CopyStoreUrlAsync(storeCatalogUrl)">
                    @(_copiedUrl ? "✓ Link Copiado!" : "📋 Copiar Link")
                </button>

                <button type="button" class="adm-btn adm-btn-success" style="flex: 1; min-width: 160px;" @onclick="() => ShareOnWhatsAppAsync(storeCatalogUrl)">
                    💬 Enviar no WhatsApp
                </button>

                <a href="/loja/@effectiveSlug" class="adm-btn adm-btn-outline" style="min-width: 110px;">
                    👁️ Ver no App
                </a>

                <button type="button" class="adm-btn adm-btn-outline" style="min-width: 140px;" @onclick="() => OpenBrowserAsync(storeCatalogUrl)">
                    Abrir no Navegador &nearr;
                </button>
            </div>

            <!-- QR Code do Balcão e Sacolas -->
            <div style="display: flex; align-items: center; gap: 1.25rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 10px; padding: 1rem; flex-wrap: wrap;">
                <img src="@qrCodeSvgUri" alt="QR Code da Loja" style="width: 110px; height: 110px; border-radius: 8px; background: #FFFFFF; padding: 4px;" />
                <div style="flex: 1; min-width: 170px;">
                    <div style="font-weight: 800; font-size: 0.95rem; color: var(--adm-text);">📱 QR Code do Balcão &amp; Sacolas</div>
                    <div style="font-size: 0.8rem; color: var(--adm-muted); margin-top: 0.25rem; line-height: 1.4;">
                        Imprima e coloque no balcão ou nas etiquetas das roupas: suas clientes apontam a câmera do celular e abrem o catálogo na hora!
                    </div>
                </div>
            </div>
        </section>

        <!-- Card 4: Logotipo da Loja -->
        <section class="adm-card">
            <h2 style="font-size: 1.1rem; font-weight: 700; margin-top: 0; margin-bottom: 0.75rem; color: var(--adm-text);">
                🖼️ Logotipo da Loja (Opcional)
            </h2>

            @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
            {
                <div style="padding: 1rem; background: var(--adm-input-bg); border: 1px solid var(--adm-border); border-radius: 8px; display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                    <img src="@_form.LogoPublicUrl" alt="Logotipo" style="height: 52px; max-width: 160px; object-fit: contain;" />
                    <span style="font-weight: 700; font-size: 1.1rem; color: var(--adm-text);">@_form.StoreName</span>
                </div>
            }
            else
            {
                <div style="padding: 1rem; background: var(--adm-input-bg); border: 1px dashed var(--adm-border); border-radius: 8px; color: var(--adm-muted); font-size: 0.88rem; margin-bottom: 1rem;">
                    Nenhum logotipo configurado (o catálogo exibirá o nome <strong>@_form.StoreName</strong> em destaque).
                </div>
            }

            <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                <button type="button" class="adm-btn adm-btn-primary" @onclick="PickAndUploadLogoAsync">
                    📷 Enviar Logotipo do Celular
                </button>
                @if (!string.IsNullOrWhiteSpace(_form.LogoPublicUrl))
                {
                    <button type="button" class="adm-btn adm-btn-danger" @onclick="RemoveLogoAsync">
                        Remover Logotipo
                    </button>
                }
            </div>
        </section>

        <!-- Card 5: Opções Avançadas (Discreto e Opcional para Administradores) -->
        <details style="background: var(--adm-surface); border: 1px solid var(--adm-border); border-radius: 10px; padding: 0.85rem 1rem;">
            <summary style="cursor: pointer; font-weight: 600; font-size: 0.86rem; color: var(--adm-muted); user-select: none;">
                ⚙️ Opções Avançadas de Domínio / Nuvem
            </summary>
            <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.85rem;">
                <div>
                    <label class="adm-label">Endereço Base / Domínio do Site no Google Cloud</label>
                    <div style="display: flex; gap: 0.4rem;">
                        <input type="text"
                               class="adm-input"
                               @bind="_domainInput"
                               placeholder="Ex.: lojas.minhaloja.com ou minha-loja" />
                        <button type="button"
                                class="adm-btn adm-btn-outline"
                                style="white-space: nowrap; padding: 0 0.85rem; font-size: 0.82rem; border-color: var(--adm-accent); font-weight: 700;"
                                disabled="@_isCheckingDomain"
                                @onclick="CheckDomainAvailabilityAsync">
                            @(_isCheckingDomain ? "Consultando..." : "🔍 Verificar Google Cloud")
                        </button>
                    </div>

                    @if (_domainCheckResult is not null)
                    {
                        <div style="margin-top: 0.5rem; padding: 0.65rem 0.85rem; border-radius: 8px; font-size: 0.82rem; @(_domainCheckResult.IsAvailable ? "background: rgba(34,197,94,0.12); border: 1px solid var(--adm-success); color: var(--adm-success);" : "background: rgba(239,68,68,0.12); border: 1px solid var(--adm-danger); color: var(--adm-danger);")">
                            <div style="font-weight: 700;">
                                @(_domainCheckResult.IsAvailable ? "✓ " + _domainCheckResult.Message : "✕ " + _domainCheckResult.Message)
                            </div>
                            <div style="font-size: 0.76rem; margin-top: 0.25rem;">
                                @if (_domainCheckResult.IsAvailable)
                                {
                                    <div>URL que será configurada: <strong>@_domainCheckResult.NormalizedUrl</strong></div>
                                }
                                else if (_domainCheckResult.Suggestions.Count > 0)
                                {
                                    <div style="margin-bottom: 0.2rem;">Sugestões disponíveis no Google Cloud (toque para aplicar):</div>
                                    <div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.25rem;">
                                        @foreach (var s in _domainCheckResult.Suggestions)
                                        {
                                            <button type="button"
                                                    class="pill-badge pill-blue"
                                                    style="border: none; cursor: pointer; padding: 0.2rem 0.5rem; font-size: 0.75rem;"
                                                    @onclick="() => SelectDomainSuggestion(s)">
                                                @s
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <span style="font-size: 0.75rem; color: var(--adm-muted);">
                            Informe um domínio próprio ou subdomínio para consultar se está disponível no Google Cloud.
                        </span>
                    }
                </div>

                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer;">
                    <input type="checkbox" @bind="_form.AutoSyncOnlineOnSave" />
                    <span>Sincronizar dados automaticamente ao salvar roupas ou categorias</span>
                </label>

                @if (_form.LastOnlineSyncAt.HasValue)
                {
                    <div style="font-size: 0.78rem; color: var(--adm-muted);">
                        Última sincronização com nuvem: <strong>@_form.LastOnlineSyncAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong>
                    </div>
                }

                <div>
                    <button type="button"
                            class="adm-btn adm-btn-outline"
                            style="font-size: 0.8rem; padding: 0.4rem 0.75rem;"
                            disabled="@CloudSync.IsSyncing"
                            @onclick="SyncToCloudNowAsync">
                        @(CloudSync.IsSyncing ? "⏳ Sincronizando..." : "🔄 Forçar Sincronização com Nuvem")
                    </button>
                </div>
            </div>
        </details>
    </div>
</div>

<section class="adm-card" style="margin-top: 1.25rem; border-left: 4px solid var(--brand-accent, #B69158);">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
        <div>
            <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--brand-accent, #B69158);">
                Licença &amp; Gift Card
            </div>
            <h2 style="font-size: 1.2rem; font-weight: 700; margin: 0.25rem 0 0; color: var(--adm-text);">
                🎁 Resgatar Código Gift Card do Plano
            </h2>
            <p style="font-size: 0.85rem; color: var(--adm-muted); margin: 0.25rem 0 0;">
                Digite o código Gift Card recebido para ativar ou renovar seu plano <strong>Básico</strong>, <strong>Intermediário (5 Versões)</strong> ou <strong>Premium Moldável</strong>.
            </p>
        </div>

        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem;">
            <span class="pill-badge @(BrandState.IsPremiumPlan ? "pill-gold" : BrandState.IsIntermediatePlan ? "pill-green" : "pill-slate")">
                @(BrandState.IsPremiumPlan ? "✦ Plano Premium Ativo" : BrandState.IsIntermediatePlan ? "◈ Meia Versão (5 Temas)" : "● Plano Básico Minimalista")
            </span>
            <span style="font-size: 0.78rem; color: var(--adm-muted);">
                @if (!_planExpiresAt.HasValue)
                {
                    <span>Validade: <strong>Vitalício / Contínuo</strong></span>
                }
                else if (DateTimeOffset.UtcNow < _planExpiresAt.Value)
                {
                    <span>Válido até: <strong>@_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></span>
                }
                else
                {
                    <span style="color: var(--adm-danger);">Licença expirada em @_planExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(_activeGiftCardCode))
            {
                <span style="font-size: 0.74rem; color: var(--adm-muted); font-family: monospace;">
                    Último Gift Card: @_activeGiftCardCode
                </span>
            }
        </div>
    </div>

    <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 1rem;">
        <input type="text"
               class="adm-input"
               style="flex: 1; min-width: 220px; text-transform: uppercase; font-family: monospace; letter-spacing: 0.08em; font-weight: 700;"
               @bind="_giftCardCodeInput"
               placeholder="Ex.: LUXO-INTR-30D-A7K2B9C4 ou LUXO-PREM-..." />
        <button type="button"
                class="adm-btn adm-btn-accent"
                style="white-space: nowrap; font-weight: 700;"
                disabled="@_isRedeemingGiftCard"
                @onclick="RedeemGiftCardAsync">
            @(_isRedeemingGiftCard ? "Ativando..." : "🎁 Ativar Código Gift Card")
        </button>
    </div>
</section>

<DesignStudioPanel PlanTier="@_planTier"
                   PlanExpiresAt="@_planExpiresAt"
                   BasicPrice="@_basicPlanPrice"
                   IntermediaryPrice="@_intermediaryPlanPrice"
                   PremiumPrice="@_premiumPlanPrice"
                   Design="@_designDraft"
                   StoreName="@_form.StoreName"
                   StoreDescription="@_form.StoreDescription"
                   IsSaving="@_savingDesign"
                   OnDesignChanged="HandleDesignDraftChanged"
                   OnSaveDesignRequested="SaveDesignSettingsAsync" />

@code {
    private string _planTier = StoreDesignPresets.PlanBasic;
    private DateTimeOffset? _planExpiresAt;
    private string? _activeGiftCardCode;
    private string _giftCardCodeInput = string.Empty;
    private bool _isRedeemingGiftCard;
    private decimal _basicPlanPrice = 49.90m;
    private decimal _intermediaryPlanPrice = 89.90m;
    private decimal _premiumPlanPrice = 129.90m;
    private StoreDesignDto _designDraft = StoreDesignDto.CreateMinimalistaLuxo();
    private bool _savingDesign;

    private UpdateStoreSettingsRequest _form = new()
    {
        StoreName = "Minha Loja",
        StoreSlug = "minha-loja",
        WhatsappNumber = "5511900000000",
        StoreDescription = "Catálogo digital oficial da loja.",
        DefaultLowStockThreshold = 3,
        AutoSyncOnlineOnSave = true
    };

    private bool _autoSyncSlugWithName = true;
    private bool _copiedUrl;
    private string? _error;
    private string? _success;
    private string _domainInput = string.Empty;
    private bool _isCheckingDomain;
    private CheckDomainAvailabilityResponse? _domainCheckResult;

    protected override async Task OnInitializedAsync()
    {
        Theme.OnThemeChanged += StateHasChanged;
        CloudSync.OnSyncStatusChanged += StateHasChanged;
        await LoadSettingsAsync();
    }

    private void ChangeTheme(string preference)
    {
        Theme.SetThemePreference(preference);
    }

    private async Task LoadSettingsAsync()
    {
        _error = null;
        try
        {
            var current = await Gateway.GetStoreSettingsAsync();
            _domainInput = string.IsNullOrWhiteSpace(current.OnlineBaseUrl)
                ? WhatsAppLinkBuilder.GenerateDefaultStoreDomain(current.StoreName)
                : current.OnlineBaseUrl.Replace("https://", "").Replace("http://", "").TrimEnd('/');
            _form = new UpdateStoreSettingsRequest
            {
                StoreName = current.StoreName,
                StoreSlug = current.StoreSlug,
                WhatsappNumber = current.WhatsappNumber,
                StoreDescription = current.StoreDescription,
                LogoPublicUrl = current.LogoPublicUrl,
                DefaultLowStockThreshold = current.DefaultLowStockThreshold,
                OnlineBaseUrl = string.IsNullOrWhiteSpace(current.OnlineBaseUrl)
                    ? WhatsAppLinkBuilder.GenerateDefaultStoreUrl(current.StoreName)
                    : current.OnlineBaseUrl,
                AutoSyncOnlineOnSave = current.AutoSyncOnlineOnSave,
                LastOnlineSyncAt = current.LastOnlineSyncAt,
                IsSiteActive = current.IsSiteActive,
                DeactivationReason = current.DeactivationReason,
                LastActivityAt = current.LastActivityAt,
                PublishedStoreName = current.PublishedStoreName,
                PlanTier = current.PlanTier
            };
            _planTier = current.PlanTier;
            _planExpiresAt = current.PlanExpiresAt;
            _activeGiftCardCode = current.ActiveGiftCardCode;
            _basicPlanPrice = current.BasicPlanMonthlyPrice;
            _intermediaryPlanPrice = current.IntermediaryPlanMonthlyPrice;
            _premiumPlanPrice = current.PremiumPlanMonthlyPrice;
            _designDraft = (current.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            BrandState.ApplyFromAdminSettings(current);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task CheckDomainAvailabilityAsync()
    {
        if (string.IsNullOrWhiteSpace(_domainInput))
            return;

        _isCheckingDomain = true;
        _error = null;
        try
        {
            _domainCheckResult = await Gateway.CheckDomainAvailabilityAsync(_domainInput.Trim());
            if (_domainCheckResult.IsAvailable)
            {
                _form.OnlineBaseUrl = _domainCheckResult.NormalizedUrl;
                _domainInput = _domainCheckResult.Domain;
            }
        }
        catch (Exception ex)
        {
            _error = $"Erro ao consultar o Google Cloud: {ex.Message}";
        }
        finally
        {
            _isCheckingDomain = false;
        }
    }

    private async Task SelectDomainSuggestion(string suggestion)
    {
        _domainInput = suggestion;
        await CheckDomainAvailabilityAsync();
    }

    private void SyncSlugFromStoreNameIfUnlocked()
    {
        if (_autoSyncSlugWithName)
        {
            _form.StoreSlug = WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName);
            if (string.IsNullOrWhiteSpace(_domainInput) || _domainInput.StartsWith("lojas."))
            {
                _domainInput = WhatsAppLinkBuilder.GenerateDefaultStoreDomain(_form.StoreName);
                _form.OnlineBaseUrl = WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);
            }
        }
    }

    private async Task SaveSettingsAsync()
    {
        _error = null;
        _success = null;
        try
        {
            if (_autoSyncSlugWithName || string.IsNullOrWhiteSpace(_form.StoreSlug))
            {
                _form.StoreSlug = WhatsAppLinkBuilder.GenerateStoreSlug(_form.StoreName);
            }

            if (string.IsNullOrWhiteSpace(_form.OnlineBaseUrl))
            {
                _form.OnlineBaseUrl = WhatsAppLinkBuilder.GenerateDefaultStoreUrl(_form.StoreName);
            }

            _form.PlanTier = _planTier;
            if (BrandState.IsPremiumPlan)
            {
                _form.Design = _designDraft.Clone();
            }
            else if (BrandState.IsIntermediatePlan)
            {
                _form.Design = StoreDesignPresets.ResolveByPresetKey(_designDraft.PresetKey);
            }

            var updated = await Gateway.UpdateStoreSettingsAsync(_form);
            _form.StoreSlug = updated.StoreSlug;
            _form.WhatsappNumber = updated.WhatsappNumber;
            _form.LogoPublicUrl = updated.LogoPublicUrl;
            _form.OnlineBaseUrl = updated.OnlineBaseUrl;
            _form.AutoSyncOnlineOnSave = updated.AutoSyncOnlineOnSave;
            _form.LastOnlineSyncAt = updated.LastOnlineSyncAt;
            _form.IsSiteActive = updated.IsSiteActive;
            _form.DeactivationReason = updated.DeactivationReason;
            _form.LastActivityAt = updated.LastActivityAt;
            _form.PublishedStoreName = updated.PublishedStoreName;
            _planTier = updated.PlanTier;
            _planExpiresAt = updated.PlanExpiresAt;
            _activeGiftCardCode = updated.ActiveGiftCardCode;
            _basicPlanPrice = updated.BasicPlanMonthlyPrice;
            _intermediaryPlanPrice = updated.IntermediaryPlanMonthlyPrice;
            _premiumPlanPrice = updated.PremiumPlanMonthlyPrice;
            _designDraft = (updated.Design ?? StoreDesignDto.CreateMinimalistaLuxo()).Clone();
            BrandState.ApplyFromAdminSettings(updated);

            if (!_form.IsSiteActive)
            {
                _error = _form.DeactivationReason;
            }
            else
            {
                _success = "✓ Configurações da loja salvas com sucesso!";
            }

            // Se houver URL de nuvem configurada, tenta sincronizar em background sem travar nem assustar o usuário
            if (!string.IsNullOrWhiteSpace(_form.OnlineBaseUrl))
            {
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await CloudSync.SyncCatalogToCloudAsync();
                    }
                    catch
                    {
                    }
                });
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ActivateSiteNowAsync()
