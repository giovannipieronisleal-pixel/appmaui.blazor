# =============================================================================
# Variáveis de Ambiente — Sistema de Catálogo e Estoque de Roupas
# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# =============================================================================

# Chave secreta para assinatura dos tokens JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=SubstituaPorUmaChaveSecretaForteEmProducao_2026!

# Configurações do Supabase (PostgreSQL + Supabase Storage)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-privada-apenas-no-backend
SUPABASE_STORAGE_BUCKET=clothing-images

# String de conexão PostgreSQL do Supabase (para migrações / consultas SQL)
DATABASE_CONNECTION_STRING=Host=db.seu-projeto.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=sua-senha;SSL Mode=Require;Trust Server Certificate=true

# URL base da API (usada pelo Site Blazor e pelo App .NET MAUI)
API_BASE_URL=http://localhost:5180
PUBLIC_API_BASE_URL=http://localhost:5180

# Porta do Google Cloud Run (injetada automaticamente pelo Cloud Run em produção)
PORT=8080

